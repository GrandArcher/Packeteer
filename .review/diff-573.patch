+                    seconds 60;
+                }
+                option-refresh-rate {
+                    seconds 60;
+                }
+                ipv4-template;
+            }
+        }
+    }
+}
+forwarding-options {
+    sampling {
+        instance packeteer {
+            input {
+                rate 1000;
+            }
+            family inet {
+                output {
+                    flow-server {{.FlowHost}} {
+                        port {{.FlowPort}};
+                        version-ipfix {
