@@ -0,0 +1,65 @@
+! Packeteer on Cisco IOS-XR. Generated for review: nothing is applied. Load it
+! with "load" in configuration mode, then "commit confirmed".
+! This router: AS 64512, 192.0.2.254. Packeteer: 192.0.2.10.
+community-set packeteer
+  64512:666
+end-set
+!
+! From Packeteer: only routes that carry the Packeteer community.
+route-policy packeteer-in
+  if community matches-any packeteer then
+    pass
+  else
+    drop
+  endif
+end-policy
+!
+! Toward every eBGP neighbor, customers and peers included: never a route
+! with the Packeteer community. Put the first "if" at the top of the
+! outbound route-policy each eBGP neighbor already uses (rename ebgp-out to
+! it); your existing terms replace the final pass.
+route-policy ebgp-out
+  if community matches-any packeteer then
+    drop
+  endif
+  pass
+end-policy
+!
+router bgp 64512
+ neighbor 192.0.2.10
+  remote-as 64512
+  description packeteer
+  ! Keepalive 10s, hold time 30s: a crashed Packeteer's routes go within 30s.
+  timers 10 30
+  ! Packeteer never offers graceful restart. Leave "graceful-restart" off
+  ! for this neighbor.
+  address-family ipv4 unicast
+   route-policy packeteer-in in
+  !
+ !
+!
+!
+! Flow records to Packeteer's flow source at 192.0.2.10, UDP 2055: NetFlow v9
+! with 1-in-1000 sampling. Replace Loopback0 with the interface whose address
+! is 192.0.2.254, then add the last line to each interface that faces an upstream
+! (replace TenGigE0/0/0/0). Check it against your release first.
+flow exporter-map packeteer
+ version v9
+  options interface-table timeout 60
+  template data timeout 60
+ !
+ transport udp 2055
+ source Loopback0
+ destination 192.0.2.10
+!
+flow monitor-map packeteer-ipv4
+ record ipv4
+ exporter packeteer
+ cache timeout active 60
+ cache timeout inactive 15
+!
+sampler-map packeteer
+ random 1 out-of 1000
+!
+! interface TenGigE0/0/0/0
+!  flow ipv4 monitor packeteer-ipv4 sampler packeteer ingress
diff --git a/internal/snippet/testdata/junos-flow.golden b/internal/snippet/testdata/junos-flow.golden
new file mode 100644
index 00000000..bfd8679b
--- /dev/null
+++ b/internal/snippet/testdata/junos-flow.golden
@@ -0,0 +1,95 @@
+/* Packeteer on Junos. Generated for review: nothing is applied. Load it with
+   "load merge terminal", then run "commit check" and "commit confirmed".
+   This router: AS 64512, 192.0.2.254. Packeteer: 192.0.2.10. */
+policy-options {
+    community packeteer members 64512:666;
+    /* From Packeteer: only routes that carry the Packeteer community. */
+    policy-statement packeteer-in {
+        term tagged {
+            from community packeteer;
+            then accept;
+        }
+        term rest {
+            then reject;
+        }
+    }
+    /* Toward every eBGP neighbor, customers and peers included: never a
+       route with the Packeteer community. Put it first in each eBGP export,
+       for example: export [ no-packeteer-out your-export-policy ]. A route
+       it does not match falls through to the next policy. */
+    policy-statement no-packeteer-out {
+        term no-packeteer {
+            from community packeteer;
+            then reject;
+        }
+    }
+}
+protocols {
+    bgp {
+        group packeteer {
+            type internal;
+            local-address 192.0.2.254;
+            /* Hold time 30s: a crashed Packeteer's routes go within 30s. */
+            hold-time 30;
+            import packeteer-in;
+            /* Packeteer never offers graceful restart; keep it off here too. */
+            graceful-restart {
+                disable;
+            }
+            neighbor 192.0.2.10 {
+                description packeteer;
+                peer-as 64512;
+            }
+        }
+    }
+}
+routing-options {
+    autonomous-system 64512;
+}
+/* Flow records to Packeteer's flow source at 192.0.2.10, UDP 2055: inline
+   IPFIX sampling. Check it against your platform and release: inline
+   sampling needs a supported line card. Packeteer scales byte counts by the
+   sampling rate only when the export carries it. Then turn sampling on for
+   the interfaces that face your upstreams ("family inet { sampling { input; } }"),
+   and set your FPC slot in "chassis fpc <slot> sampling-instance packeteer". */
+services {
+    flow-monitoring {
+        version-ipfix {
+            template ipv4 {
+                flow-active-timeout 60;
+                flow-inactive-timeout 15;
+                template-refresh-rate {
+                    seconds 60;
+                }
+                option-refresh-rate {
+                    seconds 60;
+                }
+                ipv4-template;
+            }
+        }
+    }
+}
+forwarding-options {
+    sampling {
+        instance packeteer {
+            input {
+                rate 1000;
+            }
+            family inet {
+                output {
+                    flow-server 192.0.2.10 {
+                        port 2055;
+                        version-ipfix {
+                            template {
+                                ipv4;
+                            }
+                        }
+                    }
+                    inline-jflow {
+                        source-address 192.0.2.254;
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/internal/snippet/testdata/mikrotik-flow.golden b/internal/snippet/testdata/mikrotik-flow.golden
new file mode 100644
index 00000000..af5160a7
--- /dev/null
+++ b/internal/snippet/testdata/mikrotik-flow.golden
@@ -0,0 +1,32 @@
+# Packeteer on RouterOS 7. Generated for review: nothing is applied. Check the
+# commands against your RouterOS release first.
+# This router: AS 64512, 192.0.2.254. Packeteer: 192.0.2.10.
+# Skip the instance line when the router already has a BGP instance, and
+# use its name below.
+/routing bgp instance add name=edge as=64512 router-id=192.0.2.254
+/routing bgp connection add name=packeteer instance=edge \
+    local.address=192.0.2.254 local.role=ibgp \
+    remote.address=192.0.2.10 remote.as=64512 \
+    output.redistribute=bgp output.default-originate=never \
+    hold-time=30s \
+    input.filter=packeteer-in
+
+# From Packeteer: accept only routes that carry the Packeteer community.
+/routing filter rule add chain=packeteer-in \
+    rule="if (bgp-communities includes 64512:666) { accept }"
+/routing filter rule add chain=packeteer-in rule="reject"
+
+# Toward every eBGP peer, customers included: never export that community.
+# Add this rule at the top of the output chain each transit, peer, and IX
+# connection already uses (rename ebgp-out to it); place-before=0 keeps your
+# existing rules after it, and no connection is changed.
+/routing filter rule add chain=ebgp-out place-before=0 \
+    rule="if (bgp-communities includes 64512:666) { reject }"
+# Packeteer never offers graceful restart. Leave it off for this connection.
+
+# Flow records to Packeteer's flow source at 192.0.2.10, UDP 2055: NetFlow v9
+# (docs/mikrotik.md, Traffic Flow).
+/ip traffic-flow set enabled=yes interfaces=all cache-entries=16k \
+    active-flow-timeout=1m inactive-flow-timeout=15s
+/ip traffic-flow target add dst-address=192.0.2.10 port=2055 version=9 \
+    src-address=192.0.2.254 v9-template-timeout=5m
diff --git a/lab/ui-fixtures/snippet-wizard/driver.js b/lab/ui-fixtures/snippet-wizard/driver.js
new file mode 100644
index 00000000..c464b821
--- /dev/null
+++ b/lab/ui-fixtures/snippet-wizard/driver.js
@@ -0,0 +1,92 @@
+"use strict";
+// Page driver for the UI smoke test (#569). The running file has an AS
+// number, a router ID, and a provider, but no router (bgp.neighbors) yet.
+// uiproxy adds this script to /settings.html. It asks for the FRR router
+// config, which names the missing answer; reopens the wizard, types the edge
+// address and a flow collector without saving; and writes what the panel
+// shows into the page for lab/ui-smoke.sh to match. It counts every call that
+// could write the config, and checks that the file did not change.
+
+var writes = 0;
+var realFetch = window.fetch;
+window.fetch = function (url, opts) {
+  var method = (opts && opts.method) || "GET";
+  var u = String(url);
+  // POST /api/snippets only renders text from the page; it writes nothing.
+  if (method !== "GET" && u.indexOf("/api/snippets") < 0) writes++;
+  return realFetch.apply(window, arguments);
+};
+
+function note(id, text) {
+  var p = document.createElement("p");
+  p.id = id;
+  p.textContent = text;
+  document.querySelector("main").appendChild(p);
+}
+
+function byId(id) { return document.getElementById(id); }
+
+function type(id, value) {
+  var e = byId(id);
+  e.value = value;
+  e.dispatchEvent(new Event("change", {bubbles: true}));
+}
+
+function missing() {
+  return Array.prototype.map.call(document.querySelectorAll("#pf-snippet-missing li"), function (li) { return li.textContent; });
+}
+
+var savedYaml = "";
+var steps = [
+  function () { return !!byId("pf-snippet-show") && byId("pf-vendor").options.length > 0 && byId("ed-yaml").value.indexOf("asn: 64512") >= 0; },
+  function () {
+    savedYaml = byId("ed-yaml").value;
+    byId("pf-vendor").value = "frr";
+    byId("pf-snippet-show").click();
+  },
+  function () { return missing().length > 0; },
+  function () {
+    note("fixture-missing", "missing: " + missing().join(" | "));
+    note("fixture-missing-raw", "raw key error shown: " + (/no bgp\.neighbors|is not set/.test(byId("pf-snippet-status").textContent + missing().join(" "))));
+    byId("wz-reopen").click();
+    type("wz-edge", "192.0.2.254");
+  },
+  function () { return !byId("pf-snippet").hidden; },
+  function () {
+    note("fixture-edge", "after edge: " + byId("pf-snippet").textContent.split("\n").filter(function (l) { return l.indexOf("remote-as") >= 0; })[0].trim());
+    byId("wz-flow").checked = true;
+    type("wz-flow-addr", "192.0.2.10");
+    type("wz-flow-port", "2055");
+  },
+  function () { return byId("pf-snippet").textContent.indexOf("UDP 2055") >= 0; },
+  function () {
+    note("fixture-flow-frr", "frr flow: " + byId("pf-snippet").textContent.split("\n").filter(function (l) { return l.indexOf("UDP 2055") >= 0; })[0].trim());
+    type("pf-vendor", "mikrotik");
+  },
+  function () { return byId("pf-snippet").textContent.indexOf("/ip traffic-flow target add") >= 0; },
+  function () {
+    note("fixture-flow-mikrotik", "mikrotik flow: " + byId("pf-snippet").textContent.split("\n").filter(function (l) { return l.indexOf("traffic-flow target add") >= 0; })[0].trim());
+    note("fixture-source", "status: " + byId("pf-snippet-status").textContent);
+    return realFetch("/api/config", {cache: "no-store", headers: {Accept: "application/json"}}).then(function (r) { return r.json(); }).then(function (f) {
+      note("fixture-file", "file unchanged: " + (f.yaml === savedYaml));
+      note("fixture-writes", "writes: " + writes);
+    });
+  }
+];
+
+var tries = 0;
+var busy = false;
+function next() {
+  if (!steps.length || tries++ > 80) return;
+  if (busy) { setTimeout(next, 300); return; }
+  var r = steps[0]();
+  if (r && typeof r.then === "function") {
+    busy = true;
+    r.then(function () { steps.shift(); busy = false; });
+  } else if (r !== false) {
+    steps.shift();
+  }
+  setTimeout(next, 300);
+}
+
+next();
