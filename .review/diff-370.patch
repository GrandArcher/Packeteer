+		{Vantage: "v1", ASN: 64496, Address: "192.0.2.30", Family: "ipv4", VLANID: 10, LossPct: 4, RTTMs: 1, JitterMs: 0.1},
+		{Vantage: "v1", ASN: 64496, Address: "2001:db8::20", Family: "ipv6", VLANID: 10, RTTMs: 3},
