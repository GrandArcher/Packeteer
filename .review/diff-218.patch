+func TestSinglePathAdjIsCompact(t *testing.T) {
+	const n = 50000
+	v := &View{adj: map[netip.Prefix]pathSet{}}
+	nh := netip.MustParseAddr("192.0.2.1")
+	nbr := netip.MustParseAddr("192.0.2.254")
+	runtime.GC()
