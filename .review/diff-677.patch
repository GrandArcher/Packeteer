diff --git a/lab/frr-oc-transit-a/frr.conf b/lab/frr-oc-transit-a/frr.conf
new file mode 100644
index 00000000..8a88071d
--- /dev/null
+++ b/lab/frr-oc-transit-a/frr.conf
@@ -0,0 +1,44 @@
+! Simulated transit-a for the origin agreement lab (#671). Documentation
+! ASNs and prefixes only. It sends the edge three /25s, each longer than the
+! lab ROA's maxLength, so each is RPKI-invalid and nothing covers it:
+! 198.51.100.0/25 from AS64500, and 203.0.113.0/25 and 203.0.113.128/25
+! from AS64501. It receives nothing.
+frr version 10.2
+frr defaults traditional
+hostname transit-a
+log stdout informational
+!
+ip route 198.51.100.0/25 blackhole
+ip route 203.0.113.0/25 blackhole
+ip route 203.0.113.128/25 blackhole
+!
+ip prefix-list origin-64500 seq 10 permit 198.51.100.0/25
+ip prefix-list origin-64501 seq 10 permit 203.0.113.0/25
+ip prefix-list origin-64501 seq 20 permit 203.0.113.128/25
+!
+route-map to-edge permit 10
+ match ip address prefix-list origin-64500
+ set as-path prepend 64500
+route-map to-edge permit 20
+ match ip address prefix-list origin-64501
+ set as-path prepend 64501
+route-map to-edge deny 100
+!
+route-map deny-all deny 10
+!
+router bgp 64496
+ bgp router-id 192.0.2.21
+ no bgp ebgp-requires-policy
+ neighbor 192.0.2.254 remote-as 64512
+ neighbor 192.0.2.254 description edge
+ neighbor 192.0.2.254 advertisement-interval 0
+ !
+ address-family ipv4 unicast
+  network 198.51.100.0/25
+  network 203.0.113.0/25
+  network 203.0.113.128/25
+  neighbor 192.0.2.254 activate
+  neighbor 192.0.2.254 route-map deny-all in
+  neighbor 192.0.2.254 route-map to-edge out
+ exit-address-family
+!
