diff --git a/internal/offload/offload_test.go b/internal/offload/offload_test.go
new file mode 100644
index 00000000..138a03f8
--- /dev/null
+++ b/internal/offload/offload_test.go
@@ -0,0 +1,194 @@
+package offload
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+type fakeReader struct{}
+
+func (fakeReader) Read(context.Context, Dimension) (Reading, error) {
+	return Reading{Known: false}, nil
+}
+
+func TestCheckRun(t *testing.T) {
+	cases := []struct {
+		name    string
+		profile Profile
+		req     RunLevel
+		want    RunLevel
+		wantErr string
+	}{
+		{"none report", NoneProfile(), Report, Report, ""},
+		{"none refuse", NoneProfile(), Refuse, Refuse, ""},
+		{"none dry run", NoneProfile(), DryRun, Refuse, "allows at most report"},
+		{"none enforce", NoneProfile(), Enforce, Refuse, "allows at most report"},
+		{"refuse refuse", RefuseProfile(), Refuse, Refuse, ""},
+		{"refuse report", RefuseProfile(), Report, Refuse, "platform not supported, nothing evaluated"},
+		{"refuse enforce", RefuseProfile(), Enforce, Refuse, "allows at most refuse"},
+		{"enforce profile dry run", Profile{ID: "x", MaxRun: Enforce}, DryRun, DryRun, ""},
+		{"enforce profile enforce", Profile{ID: "x", MaxRun: Enforce}, Enforce, Enforce, ""},
+		{"dry run profile enforce", Profile{ID: "x", MaxRun: DryRun}, Enforce, Refuse, "allows at most dry_run"},
+		{"profile with bad max", Profile{ID: "x", MaxRun: RunLevel(9)}, Enforce, Refuse, "unknown max level"},
+		{"negative level", NoneProfile(), RunLevel(-1), Refuse, "unknown level"},
+		{"level above enforce", Profile{ID: "x", MaxRun: Enforce}, RunLevel(9), Refuse, "unknown level"},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			got, err := CheckRun(c.profile, c.req)
+			if got != c.want {
+				t.Errorf("level = %s, want %s", got, c.want)
+			}
+			if c.wantErr == "" {
+				if err != nil {
+					t.Fatalf("unexpected error: %v", err)
+				}
+				return
+			}
+			if !errors.Is(err, ErrRefused) || !strings.Contains(err.Error(), c.wantErr) {
+				t.Fatalf("err = %v, want ErrRefused containing %q", err, c.wantErr)
+			}
+		})
+	}
+}
+
+func TestRunLevelString(t *testing.T) {
+	for l, want := range map[RunLevel]string{
+		Refuse: "refuse", Report: "report", DryRun: "dry_run", Enforce: "enforce", RunLevel(7): "run_level(7)",
+	} {
+		if got := l.String(); got != want {
+			t.Errorf("RunLevel(%d) = %q, want %q", int(l), got, want)
+		}
+	}
+}
+
+func TestBuiltinProfiles(t *testing.T) {
+	none := NoneProfile()
+	if none.ID != "none" || none.MaxRun != Report || none.DefaultPolicy.Kind != NotApplicable ||
+		!strings.Contains(none.DefaultPolicy.Reason, "not applicable") || none.Miss != Unknown {
+		t.Errorf("none profile = %+v", none)
+	}
+	ref := RefuseProfile()
+	if ref.ID != "refuse" || ref.Status != Unverified || ref.MaxRun != Refuse ||
+		ref.DefaultPolicy.Reason != "platform not supported, nothing evaluated" || ref.Miss != Unknown {
+		t.Errorf("refuse profile = %+v", ref)
+	}
+	for _, p := range []Profile{none, ref} {
+		if err := p.Validate(); err != nil {
+			t.Errorf("%s: %v", p.ID, err)
+		}
+		if p.Reader != nil || len(p.Dimensions) != 0 {
+			t.Errorf("%s measures nothing but has a reader or dimensions", p.ID)
+		}
+	}
+}
+
+func TestValidate(t *testing.T) {
+	good := func() Profile {
+		p := NoneProfile()
+		p.ID = "x"
+		return p
+	}
+	cases := []struct {
+		name    string
+		mutate  func(*Profile)
+		wantErr string
+	}{
+		{"ok", func(*Profile) {}, ""},
+		{"ok with reader at enforce", func(p *Profile) { p.MaxRun = Enforce; p.Reader = fakeReader{} }, ""},
+		{"no id", func(p *Profile) { p.ID = "" }, "no id"},
+		{"bad status", func(p *Profile) { p.Status = "maybe" }, "unknown status"},
+		{"bad run level", func(p *Profile) { p.MaxRun = RunLevel(5) }, "unknown max run level"},
+		{"bad policy", func(p *Profile) { p.DefaultPolicy.Kind = "x" }, "unknown default policy"},
+		{"no reason", func(p *Profile) { p.DefaultPolicy.Reason = "" }, "no reason"},
+		{"bad miss", func(p *Profile) { p.Miss = "x" }, "unknown miss"},
+		{"bad selection", func(p *Profile) { p.Selection = "x" }, "unknown selection"},
+		{"thresholds ok", func(p *Profile) { p.Thresholds = Thresholds{Warn: 0.8, Full: 1} }, ""},
+		{"warn above full", func(p *Profile) { p.Thresholds = Thresholds{Warn: 0.9, Full: 0.8} }, "thresholds"},
+		{"warn zero", func(p *Profile) { p.Thresholds = Thresholds{Full: 0.9} }, "thresholds"},
+		{"full above one", func(p *Profile) { p.Thresholds = Thresholds{Warn: 0.5, Full: 1.5} }, "thresholds"},
+		{"unverified above refuse", func(p *Profile) { p.Status = Unverified }, "must be refuse"},
+		{"dry run without reader", func(p *Profile) { p.MaxRun = DryRun }, "needs a reader"},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			p := good()
+			c.mutate(&p)
+			err := p.Validate()
+			if c.wantErr == "" {
+				if err != nil {
+					t.Fatalf("unexpected error: %v", err)
+				}
+				return
+			}
+			if err == nil || !strings.Contains(err.Error(), c.wantErr) {
+				t.Fatalf("err = %v, want containing %q", err, c.wantErr)
+			}
+		})
+	}
+}
+
+func TestRegistryGet(t *testing.T) {
+	r := NewRegistry()
+	for _, id := range []string{"none", "refuse"} {
+		p, err := r.Get(id)
+		if err != nil || p.ID != id {
+			t.Errorf("Get(%q) = %+v, %v", id, p, err)
+		}
+	}
+	for _, id := range []string{"", "nokia-7750", "None", "refuse "} {
+		p, err := r.Get(id)
+		if !errors.Is(err, ErrUnknownProfile) {
+			t.Errorf("Get(%q) err = %v, want ErrUnknownProfile", id, err)
+		}
+		if !reflect.DeepEqual(p, Profile{}) {
+			t.Errorf("Get(%q) returned a profile for an unknown id: %+v", id, p)
+		}
+	}
+}
+
+func TestRegistryRegister(t *testing.T) {
+	r := NewRegistry()
+	p := NoneProfile()
+	p.ID = "lab-switch"
+	if err := r.Register(p); err != nil {
+		t.Fatal(err)
+	}
+	got, err := r.Get("lab-switch")
+	if err != nil || got.ID != "lab-switch" {
+		t.Fatalf("Get after Register = %+v, %v", got, err)
+	}
+	if err := r.Register(p); err == nil || !strings.Contains(err.Error(), "already registered") {
+		t.Errorf("duplicate Register err = %v", err)
+	}
+	if err := r.Register(NoneProfile()); err == nil {
+		t.Error("re-registering the built-in none profile was accepted")
+	}
+	bad := p
+	bad.ID = "bad"
+	bad.Miss = "x"
+	if err := r.Register(bad); err == nil {
+		t.Error("an invalid profile was registered")
+	}
+	if _, err := r.Get("bad"); !errors.Is(err, ErrUnknownProfile) {
+		t.Errorf("rejected profile is retrievable: %v", err)
+	}
+}
+
+func TestRegistryIDs(t *testing.T) {
+	r := NewRegistry()
+	if got, want := r.IDs(), []string{"none", "refuse"}; !reflect.DeepEqual(got, want) {
+		t.Errorf("IDs = %v, want %v", got, want)
+	}
+	p := NoneProfile()
+	p.ID = "alpha"
+	if err := r.Register(p); err != nil {
+		t.Fatal(err)
+	}
+	if got, want := r.IDs(), []string{"alpha", "none", "refuse"}; !reflect.DeepEqual(got, want) {
+		t.Errorf("IDs = %v, want %v", got, want)
+	}
+}
diff --git a/internal/offload/profile.go b/internal/offload/profile.go
new file mode 100644
index 00000000..f292fa82
--- /dev/null
+++ b/internal/offload/profile.go
@@ -0,0 +1,232 @@
+// Package offload is the shared core of the opt-in offload_aware mode: the
+// per-platform Profile, the registry of profiles, and the pure check of how
+// far a profile may be run. Nothing calls it from the decision path yet.
+package offload
+
+import (
+	"context"
+	"errors"
+	"fmt"
+)
+
+// Status is how far a platform's behavior has been verified in the lab.
+type Status string
+
+const (
+	Verified   Status = "verified"
+	Partial    Status = "partial"
+	Unverified Status = "unverified"
+)
+
+func (s Status) valid() bool {
+	return s == Verified || s == Partial || s == Unverified
+}
+
+// RunLevel is how far a profile may act. The levels are ordered: a profile
+// that allows a level allows every lower one.
+type RunLevel int
+
+const (
+	// Refuse evaluates nothing.
+	Refuse RunLevel = iota
+	// Report reads and reports; it never suggests or selects.
+	Report
+	// DryRun computes what Enforce would do and applies nothing.
+	DryRun
+	Enforce
+)
+
+func (l RunLevel) String() string {
+	switch l {
+	case Refuse:
+		return "refuse"
+	case Report:
+		return "report"
+	case DryRun:
+		return "dry_run"
+	case Enforce:
+		return "enforce"
+	}
+	return fmt.Sprintf("run_level(%d)", int(l))
+}
+
+func (l RunLevel) valid() bool { return l >= Refuse && l <= Enforce }
+
+// PolicyKind is where a platform puts a prefix that no rule covers.
+type PolicyKind string
+
+const (
+	OutOfHW       PolicyKind = "out_of_hw"
+	InHW          PolicyKind = "in_hw"
+	NotApplicable PolicyKind = "not_applicable"
+)
+
+func (k PolicyKind) valid() bool {
+	return k == OutOfHW || k == InHW || k == NotApplicable
+}
+
+// DefaultPolicy is the platform's default placement and the words a report
+// uses for it.
+type DefaultPolicy struct {
+	Kind   PolicyKind
+	Reason string
+}
+
+// Miss is what a platform does with a packet whose route is not in hardware.
+// Unknown is a valid answer: a platform that cannot say is never guessed.
+type Miss string
+
+const (
+	CPUPunt        Miss = "cpu_punt"
+	Drop           Miss = "drop"
+	ParentDrop     Miss = "parent_drop"
+	FollowCovering Miss = "follow_covering"
+	FlowCache      Miss = "flow_cache"
+	Unknown        Miss = "unknown"
+)
+
+func (m Miss) valid() bool {
+	switch m {
+	case CPUPunt, Drop, ParentDrop, FollowCovering, FlowCache, Unknown:
+		return true
+	}
+	return false
+}
+
+// Dimension is one hardware resource a reader can measure.
+type Dimension string
+
+const (
+	FIBv4     Dimension = "fib_v4"
+	FIBv6     Dimension = "fib_v6"
+	FlowTable Dimension = "flow_table"
+	CPU       Dimension = "cpu"
+)
+
+// Reading is one measurement. Known is false when the reader is unavailable
+// or the platform does not report the dimension: that is unknown, never zero.
+type Reading struct {
+	Used  uint64
+	Total uint64
+	Known bool
+}
+
+// Reader measures a profile's dimensions. An unreachable device or an
+// unsupported dimension yields Reading{Known: false}, not an error;
+// the error is for a failed read the caller should log.
+type Reader interface {
+	Read(ctx context.Context, d Dimension) (Reading, error)
+}
+
+// Cost is the hardware entries one route uses.
+type Cost struct {
+	EntriesV4 uint32
+	EntriesV6 uint32
+}
+
+// Selection is how a profile's advice reaches the operator.
+type Selection string
+
+const (
+	CommunitySnippet Selection = "community_snippet"
+	WithholdOnly     Selection = "withhold_only"
+	ObserveFlags     Selection = "observe_flags"
+)
+
+func (s Selection) valid() bool {
+	return s == CommunitySnippet || s == WithholdOnly || s == ObserveFlags
+}
+
+// Thresholds are fractions of a dimension's total at which a platform is
+// reported as filling up and as full. Both zero means none are set; otherwise
+// 0 < Warn <= Full <= 1.
+type Thresholds struct {
+	Warn float64
+	Full float64
+}
+
+// Flow says whether the profile needs per-prefix flow data to judge a route.
+type Flow struct {
+	NeedsFlow bool
+}
+
+// Timing is how long, in seconds, a platform needs to install or age out
+// hardware entries before a reading is trusted.
+type Timing struct {
+	InstallSeconds int
+	AgeOutSeconds  int
+}
+
+// KnownBad is a platform software version with a documented defect.
+type KnownBad struct {
+	Version string
+	Reason  string
+}
+
+// Profile describes one platform's hardware-offload behavior. Reader is nil
+// for a profile that measures nothing.
+type Profile struct {
+	ID            string
+	Status        Status
+	MaxRun        RunLevel
+	DefaultPolicy DefaultPolicy
+	Miss          Miss
+	Dimensions    []Dimension
+	Cost          Cost
+	Reader        Reader
+	Selection     Selection
+	Thresholds    Thresholds
+	PreChecks     []string
+	Flow          Flow
+	Timing        Timing
+	KnownBad      []KnownBad
+}
+
+// ErrRefused is returned when a profile does not allow the requested level.
+var ErrRefused = errors.New("offload: run level refused")
+
+// CheckRun returns the requested level when the profile allows it. A level
+// above the profile's MaxRun is refused, so a Refuse profile accepts only
+// Refuse. The error carries the profile's reason.
+func CheckRun(p Profile, requested RunLevel) (RunLevel, error) {
+	if !requested.valid() {
+		return Refuse, fmt.Errorf("%w: profile %q: unknown level %s", ErrRefused, p.ID, requested)
+	}
+	if !p.MaxRun.valid() {
+		return Refuse, fmt.Errorf("%w: profile %q has unknown max level %d", ErrRefused, p.ID, int(p.MaxRun))
+	}
+	if requested > p.MaxRun {
+		return Refuse, fmt.Errorf("%w: profile %q allows at most %s, requested %s: %s",
+			ErrRefused, p.ID, p.MaxRun, requested, p.DefaultPolicy.Reason)
+	}
+	return requested, nil
+}
+
+// Validate reports the first defect in p. An unverified platform must be a
+// Refuse profile: it ships as refuse, never as a guess.
+func (p Profile) Validate() error {
+	switch {
+	case p.ID == "":
+		return errors.New("offload: profile has no id")
+	case !p.Status.valid():
+		return fmt.Errorf("offload: profile %q: unknown status %q", p.ID, p.Status)
+	case !p.MaxRun.valid():
+		return fmt.Errorf("offload: profile %q: unknown max run level %d", p.ID, int(p.MaxRun))
+	case !p.DefaultPolicy.Kind.valid():
+		return fmt.Errorf("offload: profile %q: unknown default policy %q", p.ID, p.DefaultPolicy.Kind)
+	case p.DefaultPolicy.Reason == "":
+		return fmt.Errorf("offload: profile %q: default policy has no reason", p.ID)
+	case !p.Miss.valid():
+		return fmt.Errorf("offload: profile %q: unknown miss behavior %q", p.ID, p.Miss)
+	case !p.Selection.valid():
+		return fmt.Errorf("offload: profile %q: unknown selection %q", p.ID, p.Selection)
+	case p.Status == Unverified && p.MaxRun != Refuse:
+		return fmt.Errorf("offload: profile %q: an unverified platform must be refuse, not %s", p.ID, p.MaxRun)
+	case p.Thresholds != (Thresholds{}) &&
+		!(p.Thresholds.Warn > 0 && p.Thresholds.Warn <= p.Thresholds.Full && p.Thresholds.Full <= 1):
+		return fmt.Errorf("offload: profile %q: thresholds must satisfy 0 < warn <= full <= 1", p.ID)
+	case p.MaxRun > Report && p.Reader == nil:
+		return fmt.Errorf("offload: profile %q: %s needs a reader", p.ID, p.MaxRun)
+	}
+	return nil
+}
diff --git a/internal/offload/registry.go b/internal/offload/registry.go
new file mode 100644
index 00000000..34e03ea1
--- /dev/null
+++ b/internal/offload/registry.go
@@ -0,0 +1,96 @@
+package offload
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+)
+
+// ErrUnknownProfile is returned for a profile ID that is not registered.
+var ErrUnknownProfile = errors.New("offload: unknown profile")
+
+// IDs of the two built-in profiles.
+const (
+	NoneID   = "none"
+	RefuseID = "refuse"
+)
+
+// NoneProfile is for platforms with no hardware forwarding table to offload to
+// (verified trivially: there is nothing to measure):
+// software routers, CPU-only MikroTik, and CHR.
+func NoneProfile() Profile {
+	return Profile{
+		ID:     NoneID,
+		Status: Verified,
+		MaxRun: Report,
+		DefaultPolicy: DefaultPolicy{
+			Kind:   NotApplicable,
+			Reason: "not applicable: the platform forwards in software",
+		},
+		Miss:      Unknown,
+		Selection: ObserveFlags,
+	}
+}
+
+// RefuseProfile is for platforms no one has verified: Nokia 7250 and 7750, Cisco
+// Nexus 3k and 9k, Juniper ACX and non-4600 EX, Extreme, and UniFi.
+func RefuseProfile() Profile {
+	return Profile{
+		ID:     RefuseID,
+		Status: Unverified,
+		MaxRun: Refuse,
+		DefaultPolicy: DefaultPolicy{
+			Kind:   NotApplicable,
+			Reason: "platform not supported, nothing evaluated",
+		},
+		Miss:      Unknown,
+		Selection: ObserveFlags,
+	}
+}
+
+// Registry holds profiles by ID.
+type Registry struct {
+	profiles map[string]Profile
+}
+
+// NewRegistry returns a registry with the none and refuse profiles.
+func NewRegistry() *Registry {
+	r := &Registry{profiles: map[string]Profile{}}
+	for _, p := range []Profile{NoneProfile(), RefuseProfile()} {
+		if err := r.Register(p); err != nil {
+			panic(err)
+		}
+	}
+	return r
+}
+
+// Register adds a valid profile. A duplicate ID is an error.
+func (r *Registry) Register(p Profile) error {
+	if err := p.Validate(); err != nil {
+		return err
+	}
+	if _, dup := r.profiles[p.ID]; dup {
+		return fmt.Errorf("offload: profile %q already registered", p.ID)
+	}
+	r.profiles[p.ID] = p
+	return nil
+}
+
+// Get returns the profile for id, or ErrUnknownProfile.
+func (r *Registry) Get(id string) (Profile, error) {
+	p, ok := r.profiles[id]
+	if !ok {
+		return Profile{}, fmt.Errorf("%w: %q", ErrUnknownProfile, id)
+	}
+	return p, nil
+}
+
+// IDs returns the registered IDs, sorted.
+func (r *Registry) IDs() []string {
+	ids := make([]string, 0, len(r.profiles))
+	for id := range r.profiles {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	return ids
+}
