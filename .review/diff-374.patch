+func (c *Config) validateCoreLinks(add func(string, ...any)) {
+	ix := c.IXP
+	hasC, hasL := ix.Core != nil, len(ix.CoreLinks) > 0
+	switch {
+	case hasL && !hasC:
+		add("ixp.core_links requires ixp.core")
+	case hasC && !hasL:
+		add("ixp.core requires ixp.core_links")
