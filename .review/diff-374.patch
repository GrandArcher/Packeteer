diff --git a/internal/plugins/ixpcore/icmp/icmp.go b/internal/plugins/ixpcore/icmp/icmp.go
new file mode 100644
index 00000000..01229aa6
--- /dev/null
+++ b/internal/plugins/ixpcore/icmp/icmp.go
@@ -0,0 +1,209 @@
+// Package icmp is the ixp.core prober (#167). It sends ICMP echo from this
+// site to the address of each other site that ixp.core_links names, across
+// the exchange core, and records loss, RTT, and jitter. It does not
+// announce and it is not an input to Decide.
+package icmp
+
+import (
+	"context"
+	"fmt"
+	"log/slog"
+	"sync"
+	"time"
+
+	"github.com/GrandArcher/Packeteer/internal/probe"
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+
+	// The packet sender is the built-in icmp prober. Register it even when
+	// the controller did not import the prober set on its own.
+	_ "github.com/GrandArcher/Packeteer/internal/plugins/prober/icmp"
+)
+
+// TypeName is the config type.
+const TypeName = "icmp"
+
+// Defaults and bounds. A zero value in config selects the default.
+const (
+	DefaultInterval = time.Minute
+	minInterval     = 10 * time.Second
+	maxInterval     = time.Hour
+	DefaultTimeout  = time.Second
+	minTimeout      = 100 * time.Millisecond
+	maxTimeout      = 5 * time.Second
+	DefaultPackets  = 5
+	maxPackets      = 20
+)
+
+// Config is the core prober's config block.
+type Config struct {
+	Interval time.Duration `yaml:"interval"`
+	Timeout  time.Duration `yaml:"timeout"`
+	Packets  int           `yaml:"packets"`
+}
+
+func init() { plugin.CoreProbes.Register(TypeName, New) }
+
+// The controller stores the prober as a CoreProbe.
+var _ plugin.CoreProbe = (*Prober)(nil)
+
+// Prober is the icmp core prober.
+type Prober struct {
+	log      *slog.Logger
+	sender   plugin.Prober
+	interval time.Duration
+	timeout  time.Duration
+	packets  int
+	now      func() time.Time
+
+	mu     sync.Mutex
+	links  []plugin.CoreLink
+	view   plugin.CoreView
+	cancel context.CancelFunc
+	done   chan struct{}
+}
+
+// New validates the config. It does not dial.
+func New(c plugin.Config, env plugin.Env) (plugin.CoreProbe, error) {
+	var cfg Config
+	if err := c.Decode(&cfg); err != nil {
+		return nil, err
+	}
+	if cfg.Interval == 0 {
+		cfg.Interval = DefaultInterval
+	}
+	if cfg.Interval < minInterval || cfg.Interval > maxInterval {
+		return nil, fmt.Errorf("interval %s must be between %s and %s", cfg.Interval, minInterval, maxInterval)
+	}
+	if cfg.Timeout == 0 {
+		cfg.Timeout = DefaultTimeout
+	}
+	if cfg.Timeout < minTimeout || cfg.Timeout > maxTimeout {
+		return nil, fmt.Errorf("timeout %s must be between %s and %s", cfg.Timeout, minTimeout, maxTimeout)
+	}
+	if cfg.Packets == 0 {
+		cfg.Packets = DefaultPackets
+	}
+	if cfg.Packets < 1 || cfg.Packets > maxPackets {
+		return nil, fmt.Errorf("packets %d must be between 1 and %d", cfg.Packets, maxPackets)
+	}
+	sender, err := plugin.Probers.New(TypeName, plugin.NewConfig(nil), env)
+	if err != nil {
+		return nil, err
+	}
+	log := env.Logger
+	if log == nil {
+		log = slog.New(slog.DiscardHandler)
+	}
+	return &Prober{
+		log: log, sender: sender, interval: cfg.Interval, timeout: cfg.Timeout, packets: cfg.Packets,
+		view: plugin.CoreView{Configured: true, Links: []plugin.CoreLinkStatus{}},
+	}, nil
+}
+
+// SetLinks records the links to measure. The controller calls it before Start.
+func (p *Prober) SetLinks(l []plugin.CoreLink) {
+	p.mu.Lock()
+	p.links = append([]plugin.CoreLink(nil), l...)
+	p.mu.Unlock()
+}
+
+// View returns the latest round.
+func (p *Prober) View() plugin.CoreView {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	v := p.view
+	v.Links = append([]plugin.CoreLinkStatus{}, v.Links...)
+	return v
+}
+
+// Start begins the probe loop. It does not block.
+func (p *Prober) Start(ctx context.Context) error {
+	ctx, cancel := context.WithCancel(ctx)
+	done := make(chan struct{})
+	p.mu.Lock()
+	p.cancel, p.done = cancel, done
+	p.mu.Unlock()
+	go p.loop(ctx, done)
+	return nil
+}
+
+// Stop cancels the loop and waits for it to leave.
+func (p *Prober) Stop(ctx context.Context) error {
+	p.mu.Lock()
+	cancel, done := p.cancel, p.done
+	p.mu.Unlock()
+	if cancel != nil {
+		cancel()
+	}
+	if done == nil {
+		return nil
+	}
+	select {
+	case <-done:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func (p *Prober) loop(ctx context.Context, done chan struct{}) {
+	defer close(done)
+	t := time.NewTicker(p.interval)
+	defer t.Stop()
+	for {
+		p.round(ctx)
+		select {
+		case <-ctx.Done():
+			return
+		case <-t.C:
+		}
+	}
+}
+
+func (p *Prober) clock() time.Time {
+	if p.now != nil {
+		return p.now()
+	}
+	return time.Now()
+}
+
+// round measures every link once. A cancelled round leaves the previous
+// view in place.
+func (p *Prober) round(ctx context.Context) {
+	p.mu.Lock()
+	links := append([]plugin.CoreLink(nil), p.links...)
+	p.mu.Unlock()
+	now := p.clock()
+	out := make([]plugin.CoreLinkStatus, 0, len(links))
+	for _, l := range links {
+		if ctx.Err() != nil {
+			return
+		}
+		out = append(out, p.measure(ctx, l, now))
+	}
+	if ctx.Err() != nil {
+		return
+	}
+	p.mu.Lock()
+	p.view = plugin.CoreView{Configured: true, Round: now, Links: out}
+	p.mu.Unlock()
+	p.log.Info("ixp core round", "links", len(out))
+}
+
+func (p *Prober) measure(ctx context.Context, l plugin.CoreLink, now time.Time) plugin.CoreLinkStatus {
+	s := plugin.CoreLinkStatus{Name: l.Name, Peer: l.Peer, Address: l.Address.String(), At: now}
+	res, err := p.sender.Probe(ctx, plugin.ProbeRequest{
+		Provider: l.Name, Source: l.Source, Target: l.Address, Count: p.packets, Timeout: p.timeout,
+	})
+	if err != nil {
+		s.Error, s.Degraded = err.Error(), true
+		return s
+	}
+	st := probe.Compute(res)
+	s.Sent, s.LossPct = st.Sent, st.LossPct
+	s.RTTMs = float64(st.RTTAvg) / float64(time.Millisecond)
+	s.JitterMs = float64(st.Jitter) / float64(time.Millisecond)
+	s.Up = st.Received > 0
+	s.Degraded = !s.Up || st.LossPct > l.MaxLossPct || (l.MaxRTT > 0 && st.RTTAvg > l.MaxRTT)
+	return s
+}
diff --git a/internal/plugins/ixpcore/icmp/icmp_test.go b/internal/plugins/ixpcore/icmp/icmp_test.go
new file mode 100644
index 00000000..e9f6a027
--- /dev/null
+++ b/internal/plugins/ixpcore/icmp/icmp_test.go
@@ -0,0 +1,179 @@
+package icmp
+
+import (
+	"context"
+	"errors"
+	"net/netip"
+	"strings"
+	"testing"
+	"time"
+
+	"gopkg.in/yaml.v3"
+
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+var t0 = time.Date(2026, 10, 18, 12, 0, 0, 0, time.UTC)
+
+type fakeSender struct {
+	fn   func(plugin.ProbeRequest) (plugin.ProbeResult, error)
+	reqs []plugin.ProbeRequest
+}
+
+func (f *fakeSender) Start(context.Context) error { return nil }
+func (f *fakeSender) Stop(context.Context) error  { return nil }
+func (f *fakeSender) Probe(_ context.Context, r plugin.ProbeRequest) (plugin.ProbeResult, error) {
+	f.reqs = append(f.reqs, r)
+	return f.fn(r)
+}
+
+func newProber(t *testing.T, cfg string, fn func(plugin.ProbeRequest) (plugin.ProbeResult, error)) (*Prober, *fakeSender) {
+	t.Helper()
+	var node yaml.Node
+	if err := yaml.Unmarshal([]byte(cfg), &node); err != nil {
+		t.Fatal(err)
+	}
+	c, err := New(plugin.NewConfig(&node), plugin.Env{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := c.(*Prober)
+	f := &fakeSender{fn: fn}
+	p.sender = f
+	p.now = func() time.Time { return t0 }
+	return p, f
+}
+
+func replies(n int, rtt time.Duration) func(plugin.ProbeRequest) (plugin.ProbeResult, error) {
+	return func(r plugin.ProbeRequest) (plugin.ProbeResult, error) {
+		res := plugin.ProbeResult{Sent: r.Count}
+		for i := 0; i < n; i++ {
+			res.RTTs = append(res.RTTs, rtt)
+		}
+		return res, nil
+	}
+}
+
+func link(name, peer, addr string, loss float64, rtt time.Duration) plugin.CoreLink {
+	return plugin.CoreLink{Name: name, Peer: peer, Source: netip.MustParseAddr("192.0.2.30"),
+		Address: netip.MustParseAddr(addr), MaxLossPct: loss, MaxRTT: rtt}
+}
+
+func TestConfigBounds(t *testing.T) {
+	for cfg, want := range map[string]string{
+		"interval: 1s":   "interval",
+		"interval: 2h":   "interval",
+		"timeout: 1ms":   "timeout",
+		"timeout: 1h":    "timeout",
+		"packets: 99":    "packets",
+		"packets: -1":    "packets",
+		"unknown_key: 1": "unknown_key",
+	} {
+		var node yaml.Node
+		if err := yaml.Unmarshal([]byte(cfg), &node); err != nil {
+			t.Fatal(err)
+		}
+		_, err := New(plugin.NewConfig(&node), plugin.Env{})
+		if err == nil || !strings.Contains(err.Error(), want) {
+			t.Errorf("%q: err = %v, want %q", cfg, err, want)
+		}
+	}
+	if _, err := New(plugin.NewConfig(nil), plugin.Env{}); err != nil {
+		t.Fatalf("defaults: %v", err)
+	}
+}
+
+func TestRoundMeasuresEachLink(t *testing.T) {
+	p, f := newProber(t, "packets: 4", replies(4, 12*time.Millisecond))
+	p.SetLinks([]plugin.CoreLink{link("a-to-b", "site-b", "192.0.2.40", 10, 50*time.Millisecond)})
+	p.round(context.Background())
+	v := p.View()
+	if !v.Configured || !v.Round.Equal(t0) || len(v.Links) != 1 {
+		t.Fatalf("view = %+v", v)
+	}
+	l := v.Links[0]
+	if l.Name != "a-to-b" || l.Peer != "site-b" || l.Address != "192.0.2.40" || l.Sent != 4 || l.LossPct != 0 || l.RTTMs != 12 || !l.Up || l.Degraded {
+		t.Fatalf("link = %+v", l)
+	}
+	r := f.reqs[0]
+	if r.Target.String() != "192.0.2.40" || r.Source.String() != "192.0.2.30" || r.Count != 4 || r.Provider != "a-to-b" {
+		t.Fatalf("request = %+v", r)
+	}
+}
+
+func TestDegradedByLossRTTAndSilence(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		replies  int
+		rtt      time.Duration
+		degraded bool
+		up       bool
+	}{
+		{"healthy", 5, 10 * time.Millisecond, false, true},
+		{"loss over limit", 4, 10 * time.Millisecond, true, true}, // 20% > 10%
+		{"rtt over limit", 5, 80 * time.Millisecond, true, true},
+		{"no reply", 0, 0, true, false},
+	} {
+		p, _ := newProber(t, "packets: 5", replies(tc.replies, tc.rtt))
+		p.SetLinks([]plugin.CoreLink{link("l", "site-b", "192.0.2.40", 10, 50*time.Millisecond)})
+		p.round(context.Background())
+		l := p.View().Links[0]
+		if l.Degraded != tc.degraded || l.Up != tc.up {
+			t.Errorf("%s: degraded=%v up=%v, link = %+v", tc.name, l.Degraded, l.Up, l)
+		}
+	}
+}
+
+func TestNoRTTLimitMeansLossOnly(t *testing.T) {
+	p, _ := newProber(t, "", replies(5, 900*time.Millisecond))
+	p.SetLinks([]plugin.CoreLink{link("l", "site-b", "192.0.2.40", 10, 0)})
+	p.round(context.Background())
+	if l := p.View().Links[0]; l.Degraded {
+		t.Fatalf("max_rtt unset must not degrade on RTT: %+v", l)
+	}
+}
+
+func TestProbeErrorIsDegradedAndNotAMeasurement(t *testing.T) {
+	p, _ := newProber(t, "", func(plugin.ProbeRequest) (plugin.ProbeResult, error) {
+		return plugin.ProbeResult{}, errors.New("source address unavailable")
+	})
+	p.SetLinks([]plugin.CoreLink{link("l", "site-b", "192.0.2.40", 10, 0)})
+	p.round(context.Background())
+	l := p.View().Links[0]
+	if !l.Degraded || l.Up || l.Error != "source address unavailable" || l.RTTMs != 0 || l.LossPct != 0 {
+		t.Fatalf("link = %+v", l)
+	}
+}
+
+func TestCancelledRoundKeepsPreviousView(t *testing.T) {
+	p, _ := newProber(t, "", replies(5, time.Millisecond))
+	p.SetLinks([]plugin.CoreLink{link("l", "site-b", "192.0.2.40", 10, 0)})
+	p.round(context.Background())
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	p.SetLinks(nil)
+	p.round(ctx)
+	if v := p.View(); len(v.Links) != 1 {
+		t.Fatalf("view after cancelled round = %+v", v)
+	}
+}
+
+func TestStartStop(t *testing.T) {
+	p, _ := newProber(t, "", replies(5, time.Millisecond))
+	p.SetLinks([]plugin.CoreLink{link("l", "site-b", "192.0.2.40", 10, 0)})
+	if err := p.Start(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for len(p.View().Links) == 0 && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if len(p.View().Links) != 1 {
+		t.Fatal("first round did not run")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	if err := p.Stop(ctx); err != nil {
+		t.Fatal(err)
+	}
+}
