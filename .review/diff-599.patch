+func TestSetSourceMissingMarksAndIsReplacedByACheck(t *testing.T) {
+	p := &fakeProber{fn: ok(5, 5, 5)}
+	e, _ := New([]Provider{provA}, []NamedProber{{Name: "p", Prober: p}},
