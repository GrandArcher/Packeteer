+package main
+
+import (
+	"crypto/sha256"
+	"errors"
+	"io/fs"
+	"os"
+	"sort"
+)
+
+// fileState is a watched file's content hash; absent is a file that did
+// not exist.
+type fileState struct {
+	absent bool
+	sum    [sha256.Size]byte
+}
+
+// snapshot is the state of the config files the harness must not change.
+type snapshot map[string]fileState
+
+func takeSnapshot(paths []string) (snapshot, error) {
+	s := snapshot{}
+	for _, p := range paths {
+		st, err := readState(p)
+		if err != nil {
+			return nil, err
+		}
+		s[p] = st
+	}
+	return s, nil
+}
+
+func readState(path string) (fileState, error) {
+	data, err := os.ReadFile(path)
+	if errors.Is(err, fs.ErrNotExist) {
+		return fileState{absent: true}, nil
+	}
+	if err != nil {
+		return fileState{}, err
+	}
+	return fileState{sum: sha256.Sum256(data)}, nil
+}
+
+// changed lists the watched files that were written, created, or removed
+// since the snapshot, or can no longer be read.
+func (s snapshot) changed() []string {
+	var out []string
+	for p, was := range s {
+		if now, err := readState(p); err != nil || now != was {
+			out = append(out, p)
+		}
+	}
+	sort.Strings(out)
+	return out
+}
diff --git a/lab/evolve/main.go b/lab/evolve/main.go
new file mode 100644
index 00000000..7c95c635
--- /dev/null
+++ b/lab/evolve/main.go
@@ -0,0 +1,179 @@
+// Command evolve is an experimental, lab-only harness (#584). It replays
+// recorded decision rounds through the real Decide path under a baseline
+// config and under config variants (scorer weights, thresholds, hold and
+// confirm knobs), and scores each by the latency, loss, and flap count of
+// the paths it would have chosen:
+//
+//	evolve -history packeteer.db -base config.yaml -variant a.yaml -variant b.yaml [-json]
+//
+// -history is a sqlite storage file with round_retention on, opened
+// read-only, or a .jsonl round file such as testdata/history.jsonl. The
+// harness writes no config, signals no process, and builds no announcer.
+// It exits 1 when a variant changes the base's mode (so it can never turn
+// inject on) or when a watched config file changed during the run, and 2
+// on bad usage.
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/GrandArcher/Packeteer/internal/config"
+	"github.com/GrandArcher/Packeteer/internal/pluginhost"
+	_ "github.com/GrandArcher/Packeteer/internal/plugins/scorer/commit"
+	_ "github.com/GrandArcher/Packeteer/internal/plugins/scorer/cost"
+	_ "github.com/GrandArcher/Packeteer/internal/plugins/scorer/weighted"
+	"github.com/GrandArcher/Packeteer/internal/plugins/storage/sqlite"
+	"github.com/GrandArcher/Packeteer/internal/replay"
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+// Where the controller reads its config (cmd/controller ConfigEnv and
+// DefaultConfigPath). The harness watches it so a run that changed it fails.
+const (
+	controllerConfigEnv  = "PACKETEER_CONFIG"
+	controllerConfigPath = "/etc/packeteer/config.yaml"
+)
+
+type list []string
+
+func (l *list) String() string     { return strings.Join(*l, ",") }
+func (l *list) Set(v string) error { *l = append(*l, v); return nil }
+
+func main() {
+	os.Exit(run(context.Background(), os.Args[1:], os.Getenv, os.Stdout, os.Stderr))
+}
+
+func run(ctx context.Context, args []string, getenv func(string) string, stdout, stderr io.Writer) int {
+	fs := flag.NewFlagSet("evolve", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	history := fs.String("history", "", "sqlite storage file or .jsonl round file to replay")
+	base := fs.String("base", "", "baseline config: the running or checked-in config")
+	var variants list
+	fs.Var(&variants, "variant", "config variant to score against the baseline (repeatable)")
+	asJSON := fs.Bool("json", false, "print the scores as JSON")
+	if err := fs.Parse(args); err != nil {
+		return 2
+	}
+	if *history == "" || *base == "" || len(variants) == 0 {
+		fmt.Fprintln(stderr, "evolve: -history, -base, and at least one -variant are required")
+		return 2
+	}
+	fail := func(err error) int {
+		fmt.Fprintf(stderr, "evolve: %v\n", err)
+		return 1
+	}
+	before, err := takeSnapshot(watchedConfigs(*base, variants, getenv))
+	if err != nil {
+		return fail(err)
+	}
+	baseCfg, err := config.Load(*base)
+	if err != nil {
+		return fail(err)
+	}
+	cfgs := []*config.Config{baseCfg}
+	names := []string{"baseline"}
+	for _, v := range variants {
+		cfg, err := config.Load(v)
+		if err != nil {
+			return fail(err)
+		}
+		if err := sameMode(baseCfg, cfg, v); err != nil {
+			return fail(err)
+		}
+		cfgs = append(cfgs, cfg)
+		names = append(names, strings.TrimSuffix(filepath.Base(v), filepath.Ext(v)))
+	}
+	store, closeStore, err := openHistory(ctx, *history)
+	if err != nil {
+		return fail(err)
+	}
+	defer closeStore()
+	log := slog.New(slog.NewTextHandler(stderr, &slog.HandlerOptions{Level: slog.LevelWarn}))
+	sides := make([]replay.Side, len(cfgs))
+	paths := make([]*pathScore, len(cfgs))
+	for i, cfg := range cfgs {
+		s, err := replay.NewSide(names[i], cfg, pluginhost.Options{Logger: log, Getenv: getenv})
+		if err != nil {
+			return fail(fmt.Errorf("%s: %w", names[i], err))
+		}
+		paths[i] = &pathScore{}
+		s.Observe = paths[i].observe
+		sides[i] = s
+	}
+	res, err := replay.Run(ctx, store, time.Unix(0, 0), time.Date(9999, 1, 1, 0, 0, 0, 0, time.UTC), sides)
+	if err != nil {
+		return fail(err)
+	}
+	if changed := before.changed(); len(changed) > 0 {
+		return fail(fmt.Errorf("config changed during the run, which the harness must never do: %s", strings.Join(changed, ", ")))
+	}
+	rep := newReport(res, paths)
+	if *asJSON {
+		enc := json.NewEncoder(stdout)
+		enc.SetIndent("", "  ")
+		if err := enc.Encode(rep); err != nil {
+			return fail(err)
+		}
+		return 0
+	}
+	rep.format(stdout)
+	return 0
+}
+
+// watchedConfigs is every config file a run must leave as it found it:
+// the controller's, the base, and the variants.
+func watchedConfigs(base string, variants []string, getenv func(string) string) []string {
+	out := []string{controllerConfigPath, base}
+	if p := getenv(controllerConfigEnv); p != "" {
+		out = append(out, p)
+	}
+	return append(out, variants...)
+}
+
+// sameMode refuses a variant whose mode differs from the base's. Mode is
+// not a scoring knob, and refusing a change is what keeps a variant from
+// turning inject on.
+func sameMode(base, v *config.Config, path string) error {
+	if v.Mode == base.Mode {
+		return nil
+	}
+	if v.Mode == "inject" {
+		return fmt.Errorf("%s: mode inject where the base is %s: a variant may not enable inject", path, base.Mode)
+	}
+	return fmt.Errorf("%s: mode %s where the base is %s: a variant may not change the mode", path, v.Mode, base.Mode)
+}
+
+// openHistory opens a .jsonl round file, or else a sqlite storage file
+// read-only.
+func openHistory(ctx context.Context, path string) (replay.Source, func(), error) {
+	if strings.HasSuffix(path, ".jsonl") {
+		rf, err := loadRoundFile(path)
+		return rf, func() {}, err
+	}
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		return nil, nil, err
+	}
+	c, err := plugin.ConfigFromYAML("path: " + strconv.Quote(abs))
+	if err != nil {
+		return nil, nil, err
+	}
+	st, err := sqlite.New(c, plugin.Env{Name: "history"})
+	if err != nil {
+		return nil, nil, err
+	}
+	if err := st.OpenReadOnly(ctx); err != nil {
+		return nil, nil, err
+	}
+	return st, func() { _ = st.Stop(context.Background()) }, nil
+}
diff --git a/lab/evolve/main_test.go b/lab/evolve/main_test.go
new file mode 100644
index 00000000..5ae7e161
--- /dev/null
+++ b/lab/evolve/main_test.go
@@ -0,0 +1,333 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/GrandArcher/Packeteer/internal/plugins/storage/sqlite"
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+const (
+	fixture  = "testdata/history.jsonl"
+	baseline = "testdata/baseline.yaml"
+	worse    = "testdata/worse.yaml"
+	better   = "testdata/better.yaml"
+)
+
+func noEnv(string) string { return "" }
+
+func runJSON(t *testing.T, history string) Report {
+	t.Helper()
+	var out, errb bytes.Buffer
+	if rc := run(context.Background(), []string{"-history", history, "-base", baseline, "-variant", worse, "-variant", better, "-json"}, noEnv, &out, &errb); rc != 0 {
+		t.Fatalf("exit %d: %s", rc, errb.String())
+	}
+	var rep Report
+	if err := json.Unmarshal(out.Bytes(), &rep); err != nil {
+		t.Fatalf("%v: %s", err, out.String())
+	}
+	return rep
+}
+
+// The fixture: 198.51.100.0/24 loses 10% on its native lab-a in rounds
+// 10-49, 203.0.113.0/24 is 22 ms faster on lab-b throughout, and
+// 192.0.2.0/24 swaps which provider is 25 ms faster every round. worse
+// ignores the loss and chases the swaps; better also takes the 22 ms.
+func TestFixtureScoresBaselineWorseAndBetter(t *testing.T) {
+	rep := runJSON(t, fixture)
+	if rep.Rounds != 60 {
+		t.Fatalf("rounds %d, want 60", rep.Rounds)
+	}
+	b := rep.Baseline
+	if len(rep.Variants) != 2 {
+		t.Fatalf("variants %+v", rep.Variants)
+	}
+	w, g := rep.Variants[0], rep.Variants[1]
+	if w.Name != "worse" || g.Name != "better" || b.Name != "baseline" {
+		t.Fatalf("names %q %q %q", b.Name, w.Name, g.Name)
+	}
+	// 3 prefixes in each of 60 rounds, every path measured.
+	for _, s := range []Score{b, w, g} {
+		if s.Samples != 180 {
+			t.Fatalf("%s: %d samples, want 180", s.Name, s.Samples)
+		}
+	}
+	// The baseline takes 198.51.100.0/24 off the loss after confirm_rounds
+	// 3 and stays: 3 lossy rounds of 10% on one of three prefixes.
+	if b.Flaps != 0 || b.Moves != 1 || !near(b.LossPct, 3*10.0/180) {
+		t.Fatalf("baseline %+v", b)
+	}
+	if w.Verdict != verdictWorse || w.LossPct <= b.LossPct || w.RTTMs <= b.RTTMs || w.Flaps <= b.Flaps {
+		t.Fatalf("worse %+v against baseline %+v", w, b)
+	}
+	// better also moves 203.0.113.0/24 after round 2 and keeps it: 22 ms
+	// lower in the 57 rounds after.
+	if g.Verdict != verdictBetter || g.LossPct != b.LossPct || g.Flaps != 0 || !near(b.RTTMs-g.RTTMs, 22.0*57/180) {
+		t.Fatalf("better %+v against baseline %+v", g, b)
+	}
+}
+
+func near(a, b float64) bool { return a-b < 1e-6 && b-a < 1e-6 }
+
+// The same rounds stored in a sqlite file, as a controller with
+// round_retention keeps them, score the same as the round file.
+func TestSqliteHistoryScoresLikeTheRoundFile(t *testing.T) {
+	rf, err := loadRoundFile(fixture)
+	if err != nil {
+		t.Fatal(err)
+	}
+	db := filepath.Join(t.TempDir(), "packeteer.db")
+	c, err := plugin.ConfigFromYAML("path: " + strconv.Quote(db) + "\nround_retention: 24h")
+	if err != nil {
+		t.Fatal(err)
+	}
+	st, err := sqlite.New(c, plugin.Env{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	last := rf.rounds[len(rf.rounds)-1].At
+	st.SetClock(func() time.Time { return last })
+	ctx := context.Background()
+	if err := st.Start(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if err := st.PutRounds(ctx, rf.rounds); err != nil {
+		t.Fatal(err)
+	}
+	if err := st.Stop(ctx); err != nil {
+		t.Fatal(err)
+	}
+	before, err := os.ReadFile(db)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, want := runJSON(t, db), runJSON(t, fixture); !reflect.DeepEqual(got, want) {
+		t.Fatalf("sqlite report %+v\nround file report %+v", got, want)
+	}
+	after, err := os.ReadFile(db)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(before, after) {
+		t.Fatal("the replay wrote to the history file")
+	}
+}
+
+func TestTextReportListsEverySide(t *testing.T) {
+	var out, errb bytes.Buffer
+	if rc := run(context.Background(), []string{"-history", fixture, "-base", baseline, "-variant", worse, "-variant", better}, noEnv, &out, &errb); rc != 0 {
+		t.Fatalf("exit %d: %s", rc, errb.String())
+	}
+	t.Log("\n" + out.String())
+	lines := strings.Split(strings.TrimSpace(out.String()), "\n")
+	if len(lines) != 5 || !strings.Contains(lines[0], "replayed 60 rounds") || !strings.Contains(lines[0], "no config was written") {
+		t.Fatalf("report:\n%s", out.String())
+	}
+	for i, want := range [][]string{{"baseline"}, {"worse", verdictWorse}, {"better", verdictBetter}} {
+		f := strings.Fields(lines[2+i])
+		if f[0] != want[0] || (len(want) > 1 && f[len(f)-1] != want[1]) {
+			t.Fatalf("line %q, want %v", lines[2+i], want)
+		}
+	}
+}
+
+func setMode(t *testing.T, path, mode string) {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, bytes.Replace(data, []byte("mode: observe"), []byte("mode: "+mode), 1), 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func writeConfig(t *testing.T, dir, name, extra string) string {
+	t.Helper()
+	data, err := os.ReadFile(baseline)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := filepath.Join(dir, name)
+	if err := os.WriteFile(p, append(data, extra...), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// A variant that would turn inject on is refused before any round is
+// replayed, and so is any other mode change.
+func TestVariantMayNotChangeTheMode(t *testing.T) {
+	dir := t.TempDir()
+	inject := writeConfig(t, dir, "inject.yaml", `packeteer_community: "64512:666"
+local_pref: 250
+allowlist: {prefixes: [198.51.100.0/24]}
+bgp: {neighbors: [{address: 192.0.2.254}]}
+announcer: {type: gobgp}
+`)
+	setMode(t, inject, "inject")
+	suggest := writeConfig(t, dir, "suggest.yaml", "")
+	setMode(t, suggest, "suggest")
+	for v, want := range map[string]string{inject: "a variant may not enable inject", suggest: "a variant may not change the mode"} {
+		var out, errb bytes.Buffer
+		rc := run(context.Background(), []string{"-history", fixture, "-base", baseline, "-variant", better, "-variant", v}, noEnv, &out, &errb)
+		if rc == 0 || !strings.Contains(errb.String(), want) || out.Len() != 0 {
+			t.Fatalf("%s: exit %d, stdout %q, stderr %q", filepath.Base(v), rc, out.String(), errb.String())
+		}
+	}
+}
+
+func TestUsageErrors(t *testing.T) {
+	for _, args := range [][]string{
+		{"-base", baseline, "-variant", worse},
+		{"-history", fixture, "-variant", worse},
+		{"-history", fixture, "-base", baseline},
+		{"-nope"},
+	} {
+		var out, errb bytes.Buffer
+		if rc := run(context.Background(), args, noEnv, &out, &errb); rc != 2 {
+			t.Fatalf("%v: exit %d, want 2", args, rc)
+		}
+	}
+}
+
+func TestSnapshotReportsWrittenCreatedAndRemovedConfigs(t *testing.T) {
+	dir := t.TempDir()
+	kept, written, removed, created := filepath.Join(dir, "kept.yaml"), filepath.Join(dir, "written.yaml"), filepath.Join(dir, "removed.yaml"), filepath.Join(dir, "created.yaml")
+	for _, p := range []string{kept, written, removed} {
+		if err := os.WriteFile(p, []byte("mode: observe\n"), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	s, err := takeSnapshot([]string{kept, written, removed, created})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := s.changed(); len(got) != 0 {
+		t.Fatalf("changed before any write: %v", got)
+	}
+	if err := os.WriteFile(written, []byte("mode: inject\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Remove(removed); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(created, []byte("mode: observe\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if got, want := s.changed(), []string{created, removed, written}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("changed %v, want %v", got, want)
+	}
+}
+
+func TestWatchedConfigsCoverTheControllerBaseAndVariants(t *testing.T) {
+	getenv := func(k string) string {
+		if k == controllerConfigEnv {
+			return "/run/packeteer/config.yaml"
+		}
+		return ""
+	}
+	got := watchedConfigs("base.yaml", []string{"a.yaml", "b.yaml"}, getenv)
+	want := []string{controllerConfigPath, "base.yaml", "/run/packeteer/config.yaml", "a.yaml", "b.yaml"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("watched %v, want %v", got, want)
+	}
+	if got := watchedConfigs("base.yaml", nil, noEnv); !reflect.DeepEqual(got, []string{controllerConfigPath, "base.yaml"}) {
+		t.Fatalf("without the env: %v", got)
+	}
+}
+
+func TestRoundFileRejectsBadHistory(t *testing.T) {
+	dir := t.TempDir()
+	for name, body := range map[string]string{
+		"order":   `{"at":"2026-10-01T12:00:30Z","input":{}}` + "\n" + `{"at":"2026-10-01T12:00:00Z","input":{}}`,
+		"unknown": `{"at":"2026-10-01T12:00:00Z","input":{},"extra":1}`,
+		"no time": `{"input":{}}`,
+	} {
+		p := filepath.Join(dir, strings.ReplaceAll(name, " ", "")+".jsonl")
+		if err := os.WriteFile(p, []byte(body), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := loadRoundFile(p); err == nil {
+			t.Fatalf("%s: loaded", name)
+		}
+	}
+}
+
+func TestRoundFileWindowAndLimit(t *testing.T) {
+	rf, err := loadRoundFile(fixture)
+	if err != nil {
+		t.Fatal(err)
+	}
+	from := rf.rounds[10].At
+	got, err := rf.Rounds(context.Background(), from, rf.rounds[20].At, 4)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 4 || !got[0].At.Equal(from) || !got[3].At.Equal(rf.rounds[13].At) {
+		t.Fatalf("got %d rounds from %v", len(got), got[0].At)
+	}
+	got, _ = rf.Rounds(context.Background(), from, rf.rounds[12].At, 100)
+	if len(got) != 2 {
+		t.Fatalf("[10, 12) gave %d rounds, want 2", len(got))
+	}
+	if _, err := rf.Rounds(context.Background(), from, from, 0); err == nil {
+		t.Fatal("limit 0 accepted")
+	}
+}
+
+// The harness links the scorers and the history store, never an announcer
+// or a steerer. The gobgp library itself is linked: the RIB view's types
+// come from it.
+func TestNoAnnouncerIsLinked(t *testing.T) {
+	gobin, err := exec.LookPath("go")
+	if err != nil {
+		t.Skip("go is not on PATH")
+	}
+	out, err := exec.Command(gobin, "list", "-deps", ".").Output()
+	if err != nil {
+		t.Fatal(err)
+	}
+	const mod = "github.com/GrandArcher/Packeteer/"
+	linked := false
+	for _, dep := range strings.Fields(string(out)) {
+		if dep == mod+"internal/plugins/scorer/weighted" {
+			linked = true
+		}
+		for _, banned := range []string{"internal/plugins/announcer/", "internal/plugins/steerer/", "internal/plugins/all", "internal/announce"} {
+			if strings.HasPrefix(dep, mod+banned) {
+				t.Fatalf("%s is linked", dep)
+			}
+		}
+	}
+	if !linked {
+		t.Fatalf("the weighted scorer is not linked:\n%s", out)
+	}
+}
+
+func TestVerdictWeighsNoMetricAgainstAnother(t *testing.T) {
+	base := Score{LossPct: 1, RTTMs: 50, Flaps: 2}
+	for _, c := range []struct {
+		v    Score
+		want string
+	}{
+		{Score{LossPct: 1, RTTMs: 50, Flaps: 2}, verdictSame},
+		{Score{LossPct: 0.5, RTTMs: 50, Flaps: 2}, verdictBetter},
+		{Score{LossPct: 1, RTTMs: 50, Flaps: 3}, verdictWorse},
+		{Score{LossPct: 0, RTTMs: 70, Flaps: 0}, verdictMixed},
+	} {
+		if got := verdict(base, c.v); got != c.want {
+			t.Fatalf("%+v: %s, want %s", c.v, got, c.want)
+		}
+	}
+}
diff --git a/lab/evolve/roundfile.go b/lab/evolve/roundfile.go
new file mode 100644
index 00000000..69a8c091
--- /dev/null
+++ b/lab/evolve/roundfile.go
@@ -0,0 +1,73 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"time"
+
+	"github.com/GrandArcher/Packeteer/internal/policy"
+	"github.com/GrandArcher/Packeteer/internal/replay"
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+// fileRound is one line of a round file: the time of a decision round and
+// its input, as policy.Input marshals to JSON.
+type fileRound struct {
+	At    time.Time    `json:"at"`
+	Input policy.Input `json:"input"`
+}
+
+// roundFile is a recorded history in text form. Each round is encoded the
+// way the controller stores it, so the replay decodes it like a stored one.
+type roundFile struct {
+	rounds []plugin.RoundRecord
+}
+
+func loadRoundFile(path string) (*roundFile, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	rf := &roundFile{}
+	for n := 1; ; n++ {
+		var r fileRound
+		if err := dec.Decode(&r); errors.Is(err, io.EOF) {
+			break
+		} else if err != nil {
+			return nil, fmt.Errorf("%s: round %d: %w", path, n, err)
+		}
+		if r.At.IsZero() {
+			return nil, fmt.Errorf("%s: round %d has no time", path, n)
+		}
+		if k := len(rf.rounds); k > 0 && !r.At.After(rf.rounds[k-1].At) {
+			return nil, fmt.Errorf("%s: round %d at %s is not after the round before it", path, n, r.At.Format(time.RFC3339))
+		}
+		enc, err := replay.Encode(r.At, r.Input)
+		if err != nil {
+			return nil, fmt.Errorf("%s: round %d: %w", path, n, err)
+		}
+		rf.rounds = append(rf.rounds, plugin.RoundRecord{At: r.At, Input: enc})
+	}
+	return rf, nil
+}
+
+// Rounds implements replay.Source.
+func (f *roundFile) Rounds(_ context.Context, from, to time.Time, limit int) ([]plugin.RoundRecord, error) {
+	if limit <= 0 {
+		return nil, fmt.Errorf("limit %d must be positive", limit)
+	}
+	i := sort.Search(len(f.rounds), func(i int) bool { return !f.rounds[i].At.Before(from) })
+	var out []plugin.RoundRecord
+	for ; i < len(f.rounds) && f.rounds[i].At.Before(to) && len(out) < limit; i++ {
+		out = append(out, f.rounds[i])
+	}
+	return out, nil
+}
diff --git a/lab/evolve/score.go b/lab/evolve/score.go
new file mode 100644
index 00000000..5e1003f9
--- /dev/null
+++ b/lab/evolve/score.go
@@ -0,0 +1,128 @@
+package main
+
+import (
+	"fmt"
+	"io"
+	"net/netip"
+	"strings"
+	"time"
+
+	"github.com/GrandArcher/Packeteer/internal/policy"
+	"github.com/GrandArcher/Packeteer/internal/replay"
+)
+
+// pathScore sums the loss and RTT of the path each prefix was on during
+// each round: the provider an improvement left it on after the round
+// before, else the native provider. A move is scored by the rounds after
+// it, not by the measurement that made it. Only a usable measurement
+// counts, so a stale or failed probe adds nothing for that prefix and round.
+type pathScore struct {
+	samples   int
+	loss, rtt float64
+	steered   map[netip.Prefix]string
+}
+
+func (p *pathScore) observe(st policy.State, out policy.Output) {
+	for _, d := range out.Decisions {
+		on, ok := p.steered[d.Prefix]
+		if !ok {
+			on = d.Native
+		}
+		for _, c := range d.Candidates {
+			if c.Provider == on && c.Usable {
+				p.samples++
+				p.loss += c.LossPct
+				p.rtt += float64(c.RTTAvg) / float64(time.Millisecond)
+				break
+			}
+		}
+	}
+	p.steered = make(map[netip.Prefix]string, len(st.Improvements))
+	for pfx, imp := range st.Improvements {
+		p.steered[pfx] = imp.Provider
+	}
+}
+
+// Verdicts of a variant against the baseline, over loss, RTT, and flaps.
+const (
+	verdictBetter = "better" // none worse, at least one better
+	verdictWorse  = "worse"  // none better, at least one worse
+	verdictMixed  = "mixed"  // some better, some worse
+	verdictSame   = "same"
+)
+
+// epsilon absorbs float rounding when two means are compared.
+const epsilon = 1e-9
+
+// Score is one side's result. LossPct and RTTMs are means over Samples, the
+// prefix rounds whose path had a usable measurement.
+type Score struct {
+	Name    string  `json:"name"`
+	LossPct float64 `json:"loss_pct"`
+	RTTMs   float64 `json:"rtt_ms"`
+	Flaps   int     `json:"flaps"`
+	Moves   int     `json:"moves"`
+	Samples int     `json:"samples"`
+	Verdict string  `json:"verdict,omitempty"`
+}
+
+// Report is the baseline and every variant over the same rounds.
+type Report struct {
+	Rounds   int       `json:"rounds"`
+	From     time.Time `json:"from"`
+	To       time.Time `json:"to"`
+	Baseline Score     `json:"baseline"`
+	Variants []Score   `json:"variants"`
+}
+
+func newReport(res replay.Result, paths []*pathScore) Report {
+	scores := make([]Score, len(res.Sides))
+	for i, side := range res.Sides {
+		s, p := side.Summary, paths[i]
+		sc := Score{Name: side.Name, Flaps: s.Flaps, Moves: s.Improves + s.Switches + s.Retires, Samples: p.samples}
+		if p.samples > 0 {
+			sc.LossPct, sc.RTTMs = p.loss/float64(p.samples), p.rtt/float64(p.samples)
+		}
+		scores[i] = sc
+	}
+	for i := 1; i < len(scores); i++ {
+		scores[i].Verdict = verdict(scores[0], scores[i])
+	}
+	return Report{Rounds: res.Rounds, From: res.From, To: res.To, Baseline: scores[0], Variants: scores[1:]}
+}
+
+// verdict compares v with base on each metric alone, lower being better,
+// and weighs none against another: a trade-off is mixed, for a human.
+func verdict(base, v Score) string {
+	better, worse := false, false
+	cmp := func(b, x float64) {
+		switch {
+		case x < b-epsilon:
+			better = true
+		case x > b+epsilon:
+			worse = true
+		}
+	}
+	cmp(base.LossPct, v.LossPct)
+	cmp(base.RTTMs, v.RTTMs)
+	cmp(float64(base.Flaps), float64(v.Flaps))
+	switch {
+	case better && worse:
+		return verdictMixed
+	case better:
+		return verdictBetter
+	case worse:
+		return verdictWorse
+	}
+	return verdictSame
+}
+
+func (r Report) format(w io.Writer) {
+	fmt.Fprintf(w, "replayed %d rounds from %s to %s; nothing was announced and no config was written\n",
+		r.Rounds, r.From.UTC().Format(time.RFC3339), r.To.UTC().Format(time.RFC3339))
+	fmt.Fprintf(w, "%-20s %10s %10s %6s %6s %8s  %s\n", "side", "loss %", "rtt ms", "flaps", "moves", "samples", "vs baseline")
+	for _, s := range append([]Score{r.Baseline}, r.Variants...) {
+		line := fmt.Sprintf("%-20s %10.3f %10.2f %6d %6d %8d  %s", s.Name, s.LossPct, s.RTTMs, s.Flaps, s.Moves, s.Samples, s.Verdict)
+		fmt.Fprintln(w, strings.TrimRight(line, " "))
+	}
+}
