diff --git a/internal/ebpfpath/track.go b/internal/ebpfpath/track.go
new file mode 100644
index 00000000..c60fbc36
--- /dev/null
+++ b/internal/ebpfpath/track.go
@@ -0,0 +1,578 @@
+package ebpfpath
+
+import (
+	"encoding/binary"
+	"fmt"
+	"net/netip"
+	"time"
+
+	"github.com/cilium/ebpf/asm"
+)
+
+// The tracker program (#631) follows TCP connections in the kernel, as the
+// span source's userspace tracker does from frame heads. The kernel keeps
+// one entry per connection, oriented local to remote with the local
+// prefixes in an LPM trie, and hands the connection's running counts to
+// userspace through a ring buffer. The counts only grow, so userspace turns
+// them into deltas and can also read them from the table. What the kernel
+// cannot do without a timer stays in userspace: SYN timeouts, and expiry of
+// idle connections.
+// The program only reads packets and returns TCX_NEXT.
+
+// Sizes shared by the tracker program and its readers.
+const (
+	// TrackKeySize is the connection key: family, one pad byte, local and
+	// remote port (network order), then the local and remote address as 16
+	// bytes each, an IPv4 address in its IPv4-mapped IPv6 form.
+	TrackKeySize = 40
+	// TrackValueSize is the kernel's per-connection state.
+	TrackValueSize = 88
+	// SummarySize is the fixed ring buffer record.
+	SummarySize = 96
+	// LocalKeySize is the LPM trie key: a u32 prefix length, then a 16
+	// byte address in IPv4-mapped form.
+	LocalKeySize = 20
+	// MinTrackFlows and MaxTrackFlows bound the connection table.
+	MinTrackFlows = 1
+	MaxTrackFlows = 10000000
+	// reportEvery is how often a connection that keeps sending reports its
+	// counts. Events (new connection, retransmission, handshake RTT, reset,
+	// FIN) report at once.
+	reportEvery = time.Second
+	// trackRingBytes holds about 10000 summaries.
+	trackRingBytes = 1 << 20
+	// Slots of the drop counter array.
+	dropRing  = 0
+	dropFlows = 1
+	dropSlots = 2
+)
+
+// Connection state, as the kernel lays it out in the flow map value.
+const (
+	vSynAt    = 0  // u64 ktime of the pending local SYN, 0 when none
+	vSynAckAt = 8  // u64 ktime of the pending local SYN-ACK, 0 when none
+	vLast     = 16 // u64 ktime of the last packet
+	vReportAt = 24 // u64 ktime of the last summary
+	// Six u64 counters that only grow, in the order of the summary record.
+	vSegs    = 32 // outbound payload segments
+	vRetrans = 40 // of those, repeats of bytes already sent
+	vRTTSum  = 48 // nanoseconds
+	vRTTN    = 56 // handshake round trips measured
+	vResets  = 64 // RSTs from the remote side
+	vCreated = 72 // ktime the connection was first seen; tells reused 4-tuples apart
+	vNextSeq = 80 // u32 next expected outbound sequence number
+	vFlags   = 84 // u32 flag* bits
+
+	flagHaveSeq    = 1
+	flagSynRetx    = 2
+	flagSynAckRetx = 4
+
+	// A summary is the six counters, then 1 when the kernel forgot the
+	// connection with it, then the key.
+	sumFinal = 48
+	sumKey   = 56
+)
+
+// TCP flag bits.
+const (
+	tcpFIN = 0x01
+	tcpSYN = 0x02
+	tcpRST = 0x04
+	tcpACK = 0x10
+)
+
+// Stack layout of the tracker program, from r10.
+const (
+	sLPM     = -68  // LPM key: u32 prefix length, 16 byte address at -64
+	sNow     = -80  // u64 ktime
+	sSeq     = -88  // u32 sequence number, host order
+	sPay     = -96  // u32 TCP payload length
+	sFlags   = -104 // u32 TCP flags
+	sOut     = -112 // u32 1 when the local side sent the packet
+	sEmit    = -120 // u32 0 nothing, 1 report, 2 report and forget the connection
+	sTOff    = -128 // u32 offset of the TCP header
+	sL4      = -136 // u32 TCP length from the IP header
+	sTmp     = -144 // scratch for small header reads
+	sTCP     = -176 // 20 TCP header bytes
+	sDropKey = -184
+	sNew     = -280 // zero value for a new connection
+
+	kLocalPort  = 2
+	kRemotePort = 4
+	kLocal      = 8
+	kRemote     = 24
+
+	tkLocal  = keyOff + kLocal
+	tkRemote = keyOff + kRemote
+)
+
+// TrackProgram is the tc program of the tracker. synTimeout bounds the
+// handshake round trips it will report: a SYN-ACK later than that is the
+// userspace sweep's timeout, not an RTT.
+func TrackProgram(flowsFD, localFD, ringFD, dropsFD int, synTimeout time.Duration) asm.Instructions {
+	var b builder
+	b.add(asm.Mov.Reg(asm.R6, asm.R1))
+	b.zero(keyOff, TrackKeySize)
+	b.add(
+		asm.StoreImm(asm.R10, sLPM, 128, asm.Word),
+		asm.StoreImm(asm.R10, sEmit, 0, asm.Word),
+		asm.LoadMem(asm.R2, asm.R6, ctxProto, asm.Word),
+		asm.JEq.Imm(asm.R2, htons16(ethIPv4), "v4"),
+		asm.JEq.Imm(asm.R2, htons16(ethIPv6), "v6"),
+		asm.Ja.Label(labelExit),
+	)
+
+	// IPv4: TCP only, not a later fragment. r9 is the header length, r8
+	// the total length.
+	b.at("v4", asm.StoreImm(asm.R10, keyOff, famV4, asm.Byte))
+	b.loadBytes(v4Proto, sTmp, 1)
+	b.add(asm.LoadMem(asm.R2, asm.R10, sTmp, asm.Byte), asm.JNE.Imm(asm.R2, protoTCP, labelExit))
+	b.loadBytes(ethHeader, sTmp, 1)
+	b.add(
+		asm.LoadMem(asm.R9, asm.R10, sTmp, asm.Byte),
+		asm.And.Imm(asm.R9, 0x0f),
+		asm.LSh.Imm(asm.R9, 2),
+		asm.JLT.Imm(asm.R9, 20, labelExit),
+	)
+	b.loadBytes(ethHeader+6, sTmp, 2)
+	b.add(
+		asm.LoadMem(asm.R2, asm.R10, sTmp, asm.Half),
+		asm.HostTo(asm.BE, asm.R2, asm.Half),
+		asm.And.Imm(asm.R2, 0x1fff),
+		asm.JNE.Imm(asm.R2, 0, labelExit),
+	)
+	b.loadBytes(ethHeader+2, sTmp, 2)
+	b.add(
+		asm.LoadMem(asm.R8, asm.R10, sTmp, asm.Half),
+		asm.HostTo(asm.BE, asm.R8, asm.Half),
+		asm.StoreImm(asm.R10, tkLocal+10, 0xffff, asm.Half),
+		asm.StoreImm(asm.R10, tkRemote+10, 0xffff, asm.Half),
+	)
+	b.loadBytes(v4Src, tkLocal+12, 4)
+	b.loadBytes(v4Dst, tkRemote+12, 4)
+	b.add(
+		asm.Sub.Reg(asm.R8, asm.R9),
+		asm.JSLT.Imm(asm.R8, 20, labelExit),
+		asm.StoreMem(asm.R10, sL4, asm.R8, asm.Word),
+		asm.Add.Imm(asm.R9, ethHeader),
+		asm.StoreMem(asm.R10, sTOff, asm.R9, asm.Word),
+		asm.Ja.Label("tcp"),
+	)
+
+	// IPv6: TCP directly after the fixed header. A packet with extension
+	// headers is not tracked.
+	b.at("v6", asm.StoreImm(asm.R10, keyOff, famV6, asm.Byte))
+	b.loadBytes(v6Next, sTmp, 1)
+	b.add(asm.LoadMem(asm.R2, asm.R10, sTmp, asm.Byte), asm.JNE.Imm(asm.R2, protoTCP, labelExit))
+	b.loadBytes(ethHeader+4, sTmp, 2)
+	b.add(
+		asm.LoadMem(asm.R8, asm.R10, sTmp, asm.Half),
+		asm.HostTo(asm.BE, asm.R8, asm.Half),
+		asm.JLT.Imm(asm.R8, 20, labelExit),
+		asm.StoreMem(asm.R10, sL4, asm.R8, asm.Word),
+		asm.StoreImm(asm.R10, sTOff, ethHeader+40, asm.Word),
+	)
+	b.loadBytes(v6Src, tkLocal, 16)
+	b.loadBytes(v6Dst, tkRemote, 16)
+
+	// TCP header: ports in packet orientation for now, sequence number in
+	// host order, payload length, flags.
+	b.at("tcp", asm.Mov.Reg(asm.R1, asm.R6))
+	b.add(asm.LoadMem(asm.R2, asm.R10, sTOff, asm.Word))
+	b.stackPtr(asm.R3, sTCP)
+	b.add(asm.Mov.Imm(asm.R4, 20), asm.FnSkbLoadBytes.Call(), asm.JNE.Imm(asm.R0, 0, labelExit))
+	b.add(
+		asm.LoadMem(asm.R2, asm.R10, sTCP, asm.Half),
+		asm.StoreMem(asm.R10, keyOff+kLocalPort, asm.R2, asm.Half),
+		asm.LoadMem(asm.R2, asm.R10, sTCP+2, asm.Half),
+		asm.StoreMem(asm.R10, keyOff+kRemotePort, asm.R2, asm.Half),
+		asm.LoadMem(asm.R2, asm.R10, sTCP+4, asm.Word),
+		asm.HostTo(asm.BE, asm.R2, asm.Word),
+		asm.StoreMem(asm.R10, sSeq, asm.R2, asm.Word),
+		asm.LoadMem(asm.R2, asm.R10, sTCP+12, asm.Byte),
+		asm.And.Imm(asm.R2, 0xf0),
+		asm.RSh.Imm(asm.R2, 2),
+		asm.JLT.Imm(asm.R2, 20, labelExit),
+		asm.LoadMem(asm.R3, asm.R10, sL4, asm.Word),
+		asm.JLT.Reg(asm.R3, asm.R2, labelExit),
+		asm.Sub.Reg(asm.R3, asm.R2),
+		asm.StoreMem(asm.R10, sPay, asm.R3, asm.Word),
+		asm.LoadMem(asm.R2, asm.R10, sTCP+13, asm.Byte),
+		asm.StoreMem(asm.R10, sFlags, asm.R2, asm.Word),
+	)
+
+	// Orientation: exactly one side must be in a local prefix. Afterwards
+	// the key holds the local side first.
+	b.lpm(localFD, tkLocal)
+	b.add(asm.JEq.Imm(asm.R0, 0, "srcRemote"))
+	b.lpm(localFD, tkRemote)
+	b.add(
+		asm.JNE.Imm(asm.R0, 0, labelExit),
+		asm.StoreImm(asm.R10, sOut, 1, asm.Word),
+		asm.Ja.Label("oriented"),
+	)
+	b.label("srcRemote")
+	b.lpm(localFD, tkRemote)
+	b.add(
+		asm.JEq.Imm(asm.R0, 0, labelExit),
+		asm.StoreImm(asm.R10, sOut, 0, asm.Word),
+		asm.LoadMem(asm.R1, asm.R10, tkLocal, asm.DWord),
+		asm.LoadMem(asm.R2, asm.R10, tkLocal+8, asm.DWord),
+		asm.LoadMem(asm.R3, asm.R10, tkRemote, asm.DWord),
+		asm.LoadMem(asm.R4, asm.R10, tkRemote+8, asm.DWord),
+		asm.StoreMem(asm.R10, tkLocal, asm.R3, asm.DWord),
+		asm.StoreMem(asm.R10, tkLocal+8, asm.R4, asm.DWord),
+		asm.StoreMem(asm.R10, tkRemote, asm.R1, asm.DWord),
+		asm.StoreMem(asm.R10, tkRemote+8, asm.R2, asm.DWord),
+		asm.LoadMem(asm.R1, asm.R10, keyOff+kLocalPort, asm.Half),
+		asm.LoadMem(asm.R2, asm.R10, keyOff+kRemotePort, asm.Half),
+		asm.StoreMem(asm.R10, keyOff+kLocalPort, asm.R2, asm.Half),
+		asm.StoreMem(asm.R10, keyOff+kRemotePort, asm.R1, asm.Half),
+	)
+
+	// Find or create the connection. A stray RST does not create one. A
+	// full table counts the connection as dropped, like max_flows.
+	b.label("oriented")
+	b.add(asm.FnKtimeGetNs.Call(), asm.StoreMem(asm.R10, sNow, asm.R0, asm.DWord))
+	b.lookup(flowsFD, keyOff)
+	b.add(
+		asm.JNE.Imm(asm.R0, 0, "have"),
+		asm.LoadMem(asm.R2, asm.R10, sFlags, asm.Word),
+		asm.JSet.Imm(asm.R2, tcpRST, labelExit),
+	)
+	b.zero(sNew, TrackValueSize)
+	b.add(asm.LoadMem(asm.R1, asm.R10, sNow, asm.DWord), asm.StoreMem(asm.R10, sNew+vCreated, asm.R1, asm.DWord))
+	b.add(asm.LoadMapPtr(asm.R1, flowsFD))
+	b.stackPtr(asm.R2, keyOff)
+	b.stackPtr(asm.R3, sNew)
+	b.add(asm.Mov.Imm(asm.R4, noExist), asm.FnMapUpdateElem.Call(), asm.JNE.Imm(asm.R0, 0, "updateFailed"))
+	b.lookup(flowsFD, keyOff)
+	b.add(
+		asm.JEq.Imm(asm.R0, 0, labelExit),
+		asm.StoreImm(asm.R10, sEmit, 1, asm.Word),
+		asm.Ja.Label("have"),
+	)
+	b.label("updateFailed")
+	b.lookup(flowsFD, keyOff)
+	b.add(asm.JNE.Imm(asm.R0, 0, "have"))
+	b.countDrop(dropsFD, dropFlows)
+
+	b.at("have", asm.Mov.Reg(asm.R7, asm.R0))
+	b.add(
+		asm.LoadMem(asm.R1, asm.R10, sNow, asm.DWord),
+		asm.StoreMem(asm.R7, vLast, asm.R1, asm.DWord),
+		asm.LoadMem(asm.R1, asm.R10, sOut, asm.Word),
+		asm.JEq.Imm(asm.R1, 0, "inbound"),
+		asm.LoadMem(asm.R8, asm.R10, sFlags, asm.Word),
+		asm.JSet.Imm(asm.R8, tcpRST, "outRST"),
+		asm.Mov.Reg(asm.R1, asm.R8),
+		asm.And.Imm(asm.R1, tcpSYN|tcpACK),
+		asm.JEq.Imm(asm.R1, tcpSYN|tcpACK, "synack"),
+		asm.JEq.Imm(asm.R1, tcpSYN, "syn"),
+		asm.Ja.Label("data"),
+	)
+
+	// Outbound.
+	b.at("outRST", asm.StoreImm(asm.R10, sEmit, 2, asm.Word))
+	b.add(asm.Ja.Label("flush"))
+	b.handshakeOut("syn", vSynAt, flagSynRetx)
+	b.handshakeOut("synack", vSynAckAt, flagSynAckRetx)
+
+	// Outbound payload: count the segment, then tell a new one from a
+	// repeat in 32-bit sequence space. A one-byte probe that repeats the
+	// last byte is a keepalive, not a retransmission.
+	b.at("data", asm.LoadMem(asm.R2, asm.R10, sPay, asm.Word))
+	b.add(
+		asm.JEq.Imm(asm.R2, 0, "post"),
+		asm.Mov.Imm(asm.R1, 1),
+		asm.AddAtomic.Mem(asm.R7, asm.R1, asm.DWord, vSegs),
+		asm.LoadMem(asm.R3, asm.R10, sSeq, asm.Word),
+		asm.Mov.Reg(asm.R4, asm.R3),
+		asm.Add.Reg32(asm.R4, asm.R2),
+		asm.LoadMem(asm.R5, asm.R7, vFlags, asm.Word),
+		asm.JSet.Imm(asm.R5, flagHaveSeq, "haveSeq"),
+		asm.Or.Imm(asm.R5, flagHaveSeq),
+		asm.StoreMem(asm.R7, vFlags, asm.R5, asm.Word),
+		asm.StoreMem(asm.R7, vNextSeq, asm.R4, asm.Word),
+		asm.Ja.Label("post"),
+	)
+	b.at("haveSeq", asm.LoadMem(asm.R5, asm.R7, vNextSeq, asm.Word))
+	b.add(
+		asm.Mov.Reg(asm.R0, asm.R4),
+		asm.Sub.Reg32(asm.R0, asm.R5),
+		asm.JEq.Imm(asm.R0, 0, "endEqual"),
+		asm.JSet.Imm(asm.R0, -0x80000000, "retrans"),
+		asm.Mov.Reg(asm.R0, asm.R3),
+		asm.Sub.Reg32(asm.R0, asm.R5),
+		asm.JSet.Imm(asm.R0, -0x80000000, "retransAdvance"),
+		asm.Ja.Label("advance"),
+	)
+	b.at("endEqual", asm.JEq.Imm(asm.R2, 1, "post"))
+	b.add(asm.Ja.Label("retrans"))
+	b.at("retransAdvance", asm.StoreMem(asm.R7, vNextSeq, asm.R4, asm.Word))
+	b.at("retrans", asm.Mov.Imm(asm.R1, 1))
+	b.add(
+		asm.AddAtomic.Mem(asm.R7, asm.R1, asm.DWord, vRetrans),
+		asm.StoreImm(asm.R10, sEmit, 1, asm.Word),
+		asm.Ja.Label("post"),
+	)
+	b.at("advance", asm.StoreMem(asm.R7, vNextSeq, asm.R4, asm.Word))
+	b.add(asm.Ja.Label("post"))
+
+	// Inbound: a RST ends the connection, a SYN-ACK answers a local SYN,
+	// and an ACK answers a local SYN-ACK.
+	b.at("inbound", asm.LoadMem(asm.R8, asm.R10, sFlags, asm.Word))
+	b.add(
+		asm.JSet.Imm(asm.R8, tcpRST, "inRST"),
+		asm.Mov.Reg(asm.R1, asm.R8),
+		asm.And.Imm(asm.R1, tcpSYN|tcpACK),
+		asm.JEq.Imm(asm.R1, tcpSYN|tcpACK, "inSynAck"),
+		asm.JSet.Imm(asm.R8, tcpACK, "inAck"),
+		asm.Ja.Label("post"),
+	)
+	b.at("inRST", asm.Mov.Imm(asm.R1, 1))
+	b.add(
+		asm.AddAtomic.Mem(asm.R7, asm.R1, asm.DWord, vResets),
+		asm.StoreImm(asm.R10, sEmit, 2, asm.Word),
+		asm.Ja.Label("flush"),
+	)
+	b.handshakeIn("inSynAck", vSynAt, flagSynRetx, synTimeout)
+	b.handshakeIn("inAck", vSynAckAt, flagSynAckRetx, synTimeout)
+
+	// Report when something happened, when the connection closes, or when
+	// it has unreported segments and the last report is old.
+	b.at("post", asm.LoadMem(asm.R1, asm.R10, sEmit, asm.Word))
+	b.add(
+		asm.JNE.Imm(asm.R1, 0, "flush"),
+		asm.LoadMem(asm.R2, asm.R10, sFlags, asm.Word),
+		asm.JSet.Imm(asm.R2, tcpFIN, "flush"),
+		asm.LoadMem(asm.R2, asm.R7, vSegs, asm.DWord),
+		asm.JEq.Imm(asm.R2, 0, labelExit),
+		asm.LoadMem(asm.R3, asm.R10, sNow, asm.DWord),
+		asm.LoadMem(asm.R4, asm.R7, vReportAt, asm.DWord),
+		asm.Sub.Reg(asm.R3, asm.R4),
+		asm.JLT.Imm(asm.R3, int32(reportEvery), labelExit),
+	)
+
+	// Summary: copy the counters and the key into a ring buffer record.
+	// Each counter only grows, so the copy needs no lock. When the ring is
+	// full the connection stays, even after a RST, so the table read scores it.
+	b.at("flush", asm.LoadMapPtr(asm.R1, ringFD))
+	b.add(asm.Mov.Imm(asm.R2, SummarySize), asm.Mov.Imm(asm.R3, 0), asm.FnRingbufReserve.Call(),
+		asm.JNE.Imm(asm.R0, 0, "reserved"))
+	b.countDrop(dropsFD, dropRing)
+	b.at("reserved", asm.Mov.Reg(asm.R8, asm.R0))
+	for off := int16(0); off < vCreated-vSegs+8; off += 8 {
+		b.add(
+			asm.LoadMem(asm.R1, asm.R7, vSegs+off, asm.DWord),
+			asm.StoreMem(asm.R8, off, asm.R1, asm.DWord),
+		)
+	}
+	b.add(
+		asm.LoadMem(asm.R1, asm.R10, sEmit, asm.Word),
+		asm.RSh.Imm(asm.R1, 1),
+		asm.StoreMem(asm.R8, sumFinal, asm.R1, asm.DWord),
+	)
+	for off := int16(0); off < TrackKeySize; off += 8 {
+		b.add(
+			asm.LoadMem(asm.R1, asm.R10, keyOff+off, asm.DWord),
+			asm.StoreMem(asm.R8, sumKey+off, asm.R1, asm.DWord),
+		)
+	}
+	b.add(
+		asm.LoadMem(asm.R1, asm.R10, sNow, asm.DWord),
+		asm.StoreMem(asm.R7, vReportAt, asm.R1, asm.DWord),
+		asm.Mov.Reg(asm.R1, asm.R8),
+		asm.Mov.Imm(asm.R2, 0),
+		asm.FnRingbufSubmit.Call(),
+	)
+	b.add(asm.LoadMem(asm.R1, asm.R10, sEmit, asm.Word), asm.JNE.Imm(asm.R1, 2, labelExit))
+	b.add(asm.LoadMapPtr(asm.R1, flowsFD))
+	b.stackPtr(asm.R2, keyOff)
+	b.add(asm.FnMapDeleteElem.Call())
+	b.exit()
+	return b.insns
+}
+
+// lpm looks up the 16 byte address at stack offset addr in the local
+// prefix trie. r0 is the value pointer, or zero.
+func (b *builder) lpm(mapFD int, addr int32) {
+	b.add(
+		asm.LoadMem(asm.R2, asm.R10, int16(addr), asm.DWord),
+		asm.StoreMem(asm.R10, sLPM+4, asm.R2, asm.DWord),
+		asm.LoadMem(asm.R2, asm.R10, int16(addr+8), asm.DWord),
+		asm.StoreMem(asm.R10, sLPM+12, asm.R2, asm.DWord),
+	)
+	b.lookup(mapFD, sLPM)
+}
+
+// countDrop adds one to slot of the drop counters and leaves the program.
+func (b *builder) countDrop(dropsFD int, slot int64) {
+	b.add(asm.StoreImm(asm.R10, sDropKey, slot, asm.Word))
+	b.lookup(dropsFD, sDropKey)
+	b.add(
+		asm.JEq.Imm(asm.R0, 0, labelExit),
+		asm.Mov.Imm(asm.R1, 1),
+		asm.AddAtomic.Mem(asm.R0, asm.R1, asm.DWord, 0),
+		asm.Ja.Label(labelExit),
+	)
+}
+
+// handshakeOut records a local SYN or SYN-ACK. The first one starts the
+// round trip clock; a repeat before it was answered marks the handshake
+// retransmitted, so it yields no RTT. Either sets the sequence number.
+func (b *builder) handshakeOut(label string, at int16, retx int32) {
+	b.at(label, asm.LoadMem(asm.R2, asm.R7, at, asm.DWord))
+	b.add(
+		asm.LoadMem(asm.R3, asm.R7, vFlags, asm.Word),
+		asm.JNE.Imm(asm.R2, 0, label+"Repeat"),
+		asm.JSet.Imm(asm.R3, retx, label+"Repeat"),
+		asm.LoadMem(asm.R4, asm.R10, sNow, asm.DWord),
+		asm.StoreMem(asm.R7, at, asm.R4, asm.DWord),
+		asm.Ja.Label(label+"Seq"),
+	)
+	b.at(label+"Repeat", asm.Or.Imm(asm.R3, retx))
+	b.at(label+"Seq", asm.Or.Imm(asm.R3, flagHaveSeq))
+	b.add(
+		asm.StoreMem(asm.R7, vFlags, asm.R3, asm.Word),
+		asm.LoadMem(asm.R4, asm.R10, sSeq, asm.Word),
+		asm.Add.Imm(asm.R4, 1),
+		asm.StoreMem(asm.R7, vNextSeq, asm.R4, asm.Word),
+		asm.Ja.Label("post"),
+	)
+}
+
+// handshakeIn closes a round trip. It reports an RTT only for a handshake
+// that was not retransmitted and was answered inside the SYN timeout.
+func (b *builder) handshakeIn(label string, at int16, retx int32, synTimeout time.Duration) {
+	b.at(label, asm.LoadMem(asm.R2, asm.R7, at, asm.DWord))
+	b.add(
+		asm.JEq.Imm(asm.R2, 0, "post"),
+		asm.Mov.Imm(asm.R1, 0),
+		asm.StoreMem(asm.R7, at, asm.R1, asm.DWord),
+		asm.LoadMem(asm.R3, asm.R7, vFlags, asm.Word),
+		asm.JSet.Imm(asm.R3, retx, "post"),
+		asm.LoadMem(asm.R4, asm.R10, sNow, asm.DWord),
+		asm.Sub.Reg(asm.R4, asm.R2),
+		asm.LoadImm(asm.R5, int64(synTimeout), asm.DWord),
+		asm.JGE.Reg(asm.R4, asm.R5, "post"),
+		asm.AddAtomic.Mem(asm.R7, asm.R4, asm.DWord, vRTTSum),
+		asm.Mov.Imm(asm.R1, 1),
+		asm.AddAtomic.Mem(asm.R7, asm.R1, asm.DWord, vRTTN),
+		asm.StoreImm(asm.R10, sEmit, 1, asm.Word),
+		asm.Ja.Label("post"),
+	)
+}
+
+// TrackKey is one connection, local side first.
+type TrackKey struct {
+	Local, Remote netip.AddrPort
+}
+
+// DecodeTrackKey reads a flow map key.
+func DecodeTrackKey(k [TrackKeySize]byte) (TrackKey, error) {
+	if k[0] != famV4 && k[0] != famV6 {
+		return TrackKey{}, fmt.Errorf("tracker key has unknown family %d", k[0])
+	}
+	local := netip.AddrFrom16([16]byte(k[kLocal : kLocal+16])).Unmap()
+	remote := netip.AddrFrom16([16]byte(k[kRemote : kRemote+16])).Unmap()
+	return TrackKey{
+		Local:  netip.AddrPortFrom(local, binary.BigEndian.Uint16(k[kLocalPort:])),
+		Remote: netip.AddrPortFrom(remote, binary.BigEndian.Uint16(k[kRemotePort:])),
+	}, nil
+}
+
+// Counters are the running counts of one connection. They only grow while
+// the connection lives; Created tells a connection from an earlier one that
+// used the same 4-tuple.
+type Counters struct {
+	Created, Segments, Retrans, Resets, RTTSamples uint64
+	RTTSum                                         time.Duration
+}
+
+func decodeCounters(b []byte) Counters {
+	u := func(off int) uint64 { return binary.NativeEndian.Uint64(b[off-vSegs:]) }
+	return Counters{
+		Segments:   u(vSegs),
+		Retrans:    u(vRetrans),
+		RTTSum:     time.Duration(u(vRTTSum)),
+		RTTSamples: u(vRTTN),
+		Resets:     u(vResets),
+		Created:    u(vCreated),
+	}
+}
+
+// TrackState is a connection as read from the table. SynAt and SynAckAt
+// identify a pending local SYN or SYN-ACK (zero when none is pending);
+// the ages and Idle are measured at the read.
+type TrackState struct {
+	Key TrackKey
+	Counters
+	SynAt, SynAckAt         uint64
+	SynAge, SynAckAge, Idle time.Duration
+}
+
+// DecodeTrackState reads a flow map entry. now is the kernel clock
+// (CLOCK_MONOTONIC) in nanoseconds when the entry was read.
+func DecodeTrackState(key [TrackKeySize]byte, val [TrackValueSize]byte, now uint64) (TrackState, error) {
+	k, err := DecodeTrackKey(key)
+	if err != nil {
+		return TrackState{}, err
+	}
+	st := TrackState{
+		Key:      k,
+		Counters: decodeCounters(val[vSegs : vCreated+8]),
+		SynAt:    binary.NativeEndian.Uint64(val[vSynAt:]),
+		SynAckAt: binary.NativeEndian.Uint64(val[vSynAckAt:]),
+	}
+	age := func(t uint64) time.Duration {
+		if t == 0 || t > now {
+			return 0
+		}
+		return time.Duration(now - t)
+	}
+	st.SynAge, st.SynAckAge = age(st.SynAt), age(st.SynAckAt)
+	st.Idle = age(binary.NativeEndian.Uint64(val[vLast:]))
+	return st, nil
+}
+
+// Summary is one ring buffer record: a connection's counters at the time
+// of the report. Final is set when the kernel forgot the connection with
+// it (a RST).
+type Summary struct {
+	Key TrackKey
+	Counters
+	Final bool
+}
+
+// DecodeSummary reads a ring buffer record. ok is false for a malformed one.
+func DecodeSummary(rec []byte) (Summary, bool) {
+	if len(rec) < SummarySize {
+		return Summary{}, false
+	}
+	key, err := DecodeTrackKey([TrackKeySize]byte(rec[sumKey : sumKey+TrackKeySize]))
+	if err != nil {
+		return Summary{}, false
+	}
+	return Summary{
+		Key:      key,
+		Counters: decodeCounters(rec[:vCreated-vSegs+8]),
+		Final:    binary.NativeEndian.Uint64(rec[sumFinal:]) != 0,
+	}, true
+}
+
+// LocalKey is the LPM trie key of a local prefix.
+type LocalKey struct {
+	PrefixLen uint32
+	Addr      [16]byte
+}
+
+// NewLocalKey is the trie key of p, with an IPv4 prefix in its mapped form.
+func NewLocalKey(p netip.Prefix) LocalKey {
+	p = p.Masked()
+	bits := p.Bits()
+	if p.Addr().Is4() {
+		bits += 96
+	}
+	return LocalKey{PrefixLen: uint32(bits), Addr: p.Addr().As16()}
+}
diff --git a/internal/ebpfpath/track_test.go b/internal/ebpfpath/track_test.go
new file mode 100644
index 00000000..da305f4a
--- /dev/null
+++ b/internal/ebpfpath/track_test.go
@@ -0,0 +1,109 @@
+package ebpfpath
+
+import (
+	"encoding/binary"
+	"net/netip"
+	"testing"
+	"time"
+)
+
+func put64(b []byte, off int, v uint64) { binary.NativeEndian.PutUint64(b[off:], v) }
+
+func trackKeyBytes(local, remote string, lport, rport uint16) [TrackKeySize]byte {
+	var k [TrackKeySize]byte
+	la, ra := netip.MustParseAddr(local), netip.MustParseAddr(remote)
+	k[0] = famV4
+	if la.Is6() {
+		k[0] = famV6
+	}
+	binary.BigEndian.PutUint16(k[kLocalPort:], lport)
+	binary.BigEndian.PutUint16(k[kRemotePort:], rport)
+	l, r := la.As16(), ra.As16()
+	copy(k[kLocal:], l[:])
+	copy(k[kRemote:], r[:])
+	return k
+}
+
+func TestTrackKeyDecode(t *testing.T) {
+	for _, c := range []struct{ local, remote string }{
+		{"192.0.2.10", "198.51.100.7"},
+		{"2001:db8:1::10", "2001:db8:ffff::20"},
+	} {
+		got, err := DecodeTrackKey(trackKeyBytes(c.local, c.remote, 40000, 443))
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := TrackKey{
+			Local:  netip.AddrPortFrom(netip.MustParseAddr(c.local), 40000),
+			Remote: netip.AddrPortFrom(netip.MustParseAddr(c.remote), 443),
+		}
+		if got != want {
+			t.Errorf("key = %+v, want %+v", got, want)
+		}
+	}
+	var bad [TrackKeySize]byte
+	if _, err := DecodeTrackKey(bad); err == nil {
+		t.Fatal("unknown family accepted")
+	}
+}
+
+func TestSummaryDecode(t *testing.T) {
+	rec := make([]byte, SummarySize)
+	// Counters in the order of the flow map value.
+	for i, v := range []uint64{276, 36, 480_000_000, 12, 2, 777} {
+		put64(rec, i*8, v)
+	}
+	put64(rec, sumFinal, 1)
+	k := trackKeyBytes("192.0.2.10", "198.51.100.7", 40000, 443)
+	copy(rec[sumKey:], k[:])
+	got, ok := DecodeSummary(rec)
+	if !ok {
+		t.Fatal("record rejected")
+	}
+	want := Summary{
+		Key:      TrackKey{Local: netip.MustParseAddrPort("192.0.2.10:40000"), Remote: netip.MustParseAddrPort("198.51.100.7:443")},
+		Counters: Counters{Segments: 276, Retrans: 36, RTTSum: 480 * time.Millisecond, RTTSamples: 12, Resets: 2, Created: 777},
+		Final:    true,
+	}
+	if got != want {
+		t.Fatalf("summary = %+v, want %+v", got, want)
+	}
+	if _, ok := DecodeSummary(rec[:SummarySize-1]); ok {
+		t.Error("short record accepted")
+	}
+	copy(rec[sumKey:], make([]byte, TrackKeySize))
+	if _, ok := DecodeSummary(rec); ok {
+		t.Error("record with an unknown family accepted")
+	}
+}
+
+func TestTrackStateDecode(t *testing.T) {
+	val := make([]byte, TrackValueSize)
+	put64(val, vSynAt, 900)
+	put64(val, vSynAckAt, 1500) // after now: no age
+	put64(val, vLast, 400)
+	put64(val, vSegs, 5)
+	put64(val, vRetrans, 1)
+	put64(val, vCreated, 100)
+	st, err := DecodeTrackState(trackKeyBytes("2001:db8:1::10", "2001:db8:ffff::20", 1, 2), [TrackValueSize]byte(val), 1000)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if st.SynAt != 900 || st.SynAge != 100 || st.SynAckAge != 0 || st.Idle != 600 {
+		t.Errorf("handshake state = %+v", st)
+	}
+	if st.Segments != 5 || st.Retrans != 1 || st.Created != 100 {
+		t.Errorf("counters = %+v", st.Counters)
+	}
+}
+
+func TestLocalKey(t *testing.T) {
+	v4 := NewLocalKey(netip.MustParsePrefix("192.0.2.77/24"))
+	if v4.PrefixLen != 96+24 || netip.AddrFrom16(v4.Addr) != netip.MustParseAddr("::ffff:192.0.2.0") {
+		t.Errorf("v4 key = %+v", v4)
+	}
+	v6 := NewLocalKey(netip.MustParsePrefix("2001:db8:1::/48"))
+	if v6.PrefixLen != 48 || netip.AddrFrom16(v6.Addr) != netip.MustParseAddr("2001:db8:1::") {
+		t.Errorf("v6 key = %+v", v6)
+	}
+}
diff --git a/internal/plugins/source/span/ebpf_track_lab_linux_test.go b/internal/plugins/source/span/ebpf_track_lab_linux_test.go
new file mode 100644
index 00000000..6f48fbc4
--- /dev/null
+++ b/internal/plugins/source/span/ebpf_track_lab_linux_test.go
@@ -0,0 +1,324 @@
+//go:build linux
+
+package span
+
+import (
+	"context"
+	"net/netip"
+	"testing"
+	"time"
+
+	"github.com/GrandArcher/Packeteer/internal/ebpfpath/labtest"
+	"github.com/GrandArcher/Packeteer/internal/passive"
+)
+
+// rttTolerance is how far the kernel's handshake RTT average may be from
+// the userspace tracker's on the veth pair. The userspace tracker stamps a
+// frame when its reader wakes, the kernel stamps it in the tc hook.
+const rttTolerance = 10 * time.Millisecond
+
+// paced sends the packets at their fixture offsets in real time, so
+// handshake round trips are real. VLAN tags are dropped: the eBPF path
+// does not parse them.
+func paced(t *testing.T, j *injector, ps []pkt) {
+	t.Helper()
+	start := time.Now()
+	for _, p := range ps {
+		if d := time.Until(start.Add(p.at)); d > 0 {
+			time.Sleep(d)
+		}
+		p.vlan = 0
+		if err := j.send(frame(p)); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func totals(s *Source) map[netip.Prefix]passive.Counts {
+	now := s.now()
+	s.sweep(now)
+	out := map[netip.Prefix]passive.Counts{}
+	for p, pr := range s.win.Totals(now) {
+		out[p] = pr.Counts
+	}
+	return out
+}
+
+func sameCounts(want, got map[netip.Prefix]passive.Counts) (string, bool) {
+	if len(want) != len(got) {
+		return "prefix sets differ", false
+	}
+	for p, w := range want {
+		g, ok := got[p]
+		if !ok {
+			return p.String() + " missing", false
+		}
+		diff := w.RTTAvg() - g.RTTAvg()
+		if diff < 0 {
+			diff = -diff
+		}
+		w.RTTSum, g.RTTSum = 0, 0
+		if w != g {
+			return p.String() + " counts differ", false
+		}
+		if diff > rttTolerance {
+			return p.String() + " RTT differs by " + diff.String(), false
+		}
+	}
+	return "", true
+}
+
+// The kernel tracker and the userspace tracker read the same synthetic
+// traffic on a veth pair and agree: connections, segments, retransmissions,
+// resets, handshake timeouts exactly, handshake RTT within rttTolerance
+// (#631). The traffic is the pcap fixture: IPv4 and IPv6, retransmissions,
+// unanswered SYNs and SYN-ACKs, resets, and noise that must be ignored.
+func TestEBPFTrackVethSameCountsAsUserspace(t *testing.T) {
+	labtest.RequireRoot(t)
+	dev, _ := labtest.Veth(t, "192.0.2.1/24")
+	y := "interface: " + dev + "\npromiscuous: false\nsyn_timeout: 500ms\nlocal: [192.0.2.0/24, \"2001:db8:1::/48\"]\n"
+	user := startSource(t, mustSource(t, y+"ebpf: true\n"))
+	kern := startSource(t, mustSource(t, y+"ebpf: true\nebpf_track: true\n"))
+	if kern.kt == nil {
+		t.Fatal("ebpf_track: true did not load the kernel tracker; the lab kernel must support TCX (Linux 6.6)")
+	}
+	if user.kt != nil {
+		t.Fatal("ebpf_track off used the kernel tracker")
+	}
+
+	paced(t, newInjector(t, dev), fixturePackets())
+	time.Sleep(time.Second)
+
+	deadline := time.Now().Add(10 * time.Second)
+	var why string
+	var want, got map[netip.Prefix]passive.Counts
+	for time.Now().Before(deadline) {
+		want, got = totals(user), totals(kern)
+		var ok bool
+		if why, ok = sameCounts(want, got); ok && len(want) == 4 {
+			c := want[netip.MustParsePrefix("198.51.100.0/24")]
+			if c.Segments != 276 || c.Retrans != 36 || c.Flows != 12 || c.RTTSamples != 12 {
+				t.Fatalf("userspace tracker counted %+v for the retransmission prefix", c)
+			}
+			if f := want[netip.MustParsePrefix("203.0.113.0/24")]; f.Timeouts != 6 || f.Resets != 2 {
+				t.Fatalf("userspace tracker counted %+v for the failing prefix", f)
+			}
+			for p, w := range want {
+				t.Logf("%s userspace rtt_avg=%v kernel rtt_avg=%v counts=%+v", p, w.RTTAvg(), got[p].RTTAvg(), got[p])
+			}
+			return
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	t.Fatalf("%s\nuserspace: %+v\nkernel:    %+v", why, want, got)
+}
+
+// Sequence numbers that wrap, a keepalive probe, and a partial overlap give
+// the kernel tracker and the userspace tracker the same verdicts (#631).
+func TestEBPFTrackSequenceEdgesMatchUserspace(t *testing.T) {
+	labtest.RequireRoot(t)
+	dev, _ := labtest.Veth(t, "192.0.2.1/24")
+	y := "interface: " + dev + "\npromiscuous: false\nlocal: [192.0.2.0/24]\n"
+	user := startSource(t, mustSource(t, y+"ebpf: true\n"))
+	kern := startSource(t, mustSource(t, y+"ebpf: true\nebpf_track: true\n"))
+	if kern.kt == nil {
+		t.Fatal("kernel tracker not loaded")
+	}
+
+	l, r := ap(localV4, 45000), ap(netip.MustParseAddr("198.51.100.77"), 443)
+	var first uint32 = 0xffffff01
+	var ps []pkt
+	add := func(p pkt) { ps = append(ps, p) }
+	add(pkt{src: l, dst: r, seq: first - 1, flags: flagSYN})
+	add(pkt{src: r, dst: l, seq: 9, flags: flagSYN | flagACK})
+	add(pkt{src: l, dst: r, seq: first, flags: flagACK})
+	// Six segments of 100 bytes; the third crosses 2^32.
+	for k := range 6 {
+		add(pkt{src: l, dst: r, seq: first + uint32(k)*100, flags: flagACK, data: 100})
+	}
+	next := first + 600
+	add(pkt{src: l, dst: r, seq: first + 400, flags: flagACK, data: 100}) // repeat after the wrap
+	add(pkt{src: l, dst: r, seq: next - 1, flags: flagACK, data: 1})      // keepalive probe
+	add(pkt{src: l, dst: r, seq: next - 50, flags: flagACK, data: 100})   // overlaps old and new bytes
+	add(pkt{src: l, dst: r, seq: next + 50, flags: flagACK, data: 100})   // new bytes
+	add(pkt{src: l, dst: r, seq: next + 150, flags: flagFIN | flagACK})
+	paced(t, newInjector(t, dev), ps)
+
+	deadline := time.Now().Add(5 * time.Second)
+	var want, got map[netip.Prefix]passive.Counts
+	for time.Now().Before(deadline) {
+		want, got = totals(user), totals(kern)
+		if _, ok := sameCounts(want, got); ok && len(want) == 1 {
+			c := want[netip.MustParsePrefix("198.51.100.0/24")]
+			if c.Segments != 10 || c.Retrans != 2 {
+				t.Fatalf("userspace tracker counted %+v, want 10 segments and 2 retransmissions", c)
+			}
+			return
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	t.Fatalf("userspace: %+v\nkernel:    %+v", want, got)
+}
+
+// A full connection table counts the connections it turned away, as
+// max_flows does for the userspace tracker.
+func TestEBPFTrackMaxFlowsMatchesUserspace(t *testing.T) {
+	labtest.RequireRoot(t)
+	dev, _ := labtest.Veth(t, "192.0.2.1/24")
+	y := "interface: " + dev + "\npromiscuous: false\nmax_flows: 2\nlocal: [192.0.2.0/24]\n"
+	user := startSource(t, mustSource(t, y+"ebpf: true\n"))
+	kern := startSource(t, mustSource(t, y+"ebpf: true\nebpf_track: true\n"))
+	var ps []pkt
+	for i := range 5 {
+		ps = append(ps, pkt{src: ap(localV4, uint16(46000+i)), dst: ap(retransV4, 443), seq: 1, flags: flagSYN})
+	}
+	paced(t, newInjector(t, dev), ps)
+
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		if user.Truncated()["max_flows"] == 3 && kern.Truncated()["max_flows"] == 3 {
+			return
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	t.Fatalf("max_flows: userspace %d, kernel %d, want 3", user.Truncated()["max_flows"], kern.Truncated()["max_flows"])
+}
+
+// A device the program cannot attach to leaves the userspace tracker in
+// charge, without an error.
+func TestEBPFTrackUnsupportedDeviceFallsBack(t *testing.T) {
+	labtest.RequireRoot(t)
+	dev := labtest.Tun(t)
+	s := startSource(t, mustSource(t, "interface: "+dev+"\npromiscuous: false\nebpf: true\nebpf_track: true\nlocal: [192.0.2.0/24]\n"))
+	if s.kt != nil {
+		t.Fatal("kernel tracker attached to a device without an Ethernet header")
+	}
+	if s.cap == nil {
+		t.Fatal("no capture after fallback")
+	}
+}
+
+// TestEBPFTrackCPUPerGbit prints the CPU cost of following one busy
+// connection on each path: seconds of process CPU above a run with no
+// capture, per gigabit of frames sent. The three paths are AF_PACKET with
+// the userspace tracker, the eBPF ring buffer with the userspace tracker,
+// and the kernel tracker.
+func TestEBPFTrackCPUPerGbit(t *testing.T) {
+	labtest.RequireRoot(t)
+	const (
+		segments = 200000
+		payload  = 1448
+	)
+	dev, _ := labtest.Veth(t, "192.0.2.1/24")
+	j := newInjector(t, dev)
+	l, r := ap(localV4, 47000), ap(retransV4, 443)
+	var frames [][]byte
+	frames = append(frames, frame(pkt{src: l, dst: r, seq: 999, flags: flagSYN}),
+		frame(pkt{src: r, dst: l, seq: 5, flags: flagSYN | flagACK}),
+		frame(pkt{src: l, dst: r, seq: 1000, flags: flagACK}))
+	seq := uint32(1000)
+	retrans := 0
+	for i := range segments {
+		frames = append(frames, frame(pkt{src: l, dst: r, seq: seq, flags: flagACK, data: payload}))
+		if i%100 == 99 { // every 100th segment goes out twice
+			frames = append(frames, frames[len(frames)-1])
+			retrans++
+		}
+		seq += payload
+	}
+	frames = append(frames, frame(pkt{src: l, dst: r, seq: seq, flags: flagFIN | flagACK}))
+	var bits int
+	for _, f := range frames {
+		bits += len(f) * 8
+	}
+	gbit := float64(bits) / 1e9
+	wantSegs := uint64(segments + retrans)
+
+	send := func() (cpu time.Duration) {
+		before := cpuTime(t)
+		for _, f := range frames {
+			_ = j.send(f)
+		}
+		return cpuTime(t) - before
+	}
+	base := send()
+
+	run := func(extra string) (time.Duration, passive.Counts) {
+		s := mustSource(t, "interface: "+dev+"\npromiscuous: false\nlocal: [192.0.2.0/24]\n"+extra)
+		before := cpuTime(t)
+		if err := s.Start(t.Context()); err != nil {
+			t.Fatal(err)
+		}
+		send()
+		var c passive.Counts
+		deadline := time.Now().Add(15 * time.Second)
+		for time.Now().Before(deadline) {
+			c = totals(s)[netip.MustParsePrefix("198.51.100.0/24")]
+			if c.Segments >= wantSegs {
+				break
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+		cpu := cpuTime(t) - before
+		stop, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		if err := s.Stop(stop); err != nil {
+			t.Errorf("stop: %v", err)
+		}
+		return cpu, c
+	}
+
+	t.Logf("%d frames, %.2f Gbit per run, %d data segments of which %d repeated; sending alone costs %.2fs CPU", len(frames), gbit, wantSegs, retrans, base.Seconds())
+	for _, m := range []struct{ name, cfg string }{
+		{"af_packet + userspace tracker", ""},
+		{"ebpf ring + userspace tracker", "ebpf: true\n"},
+		{"ebpf kernel tracker", "ebpf: true\nebpf_track: true\n"},
+	} {
+		cpu, c := run(m.cfg)
+		above := cpu - base
+		t.Logf("%-30s %d segments %d retransmissions, %.2fs CPU above sending alone, %.2f CPU-seconds per Gbit", m.name, c.Segments, c.Retrans, above.Seconds(), above.Seconds()/gbit)
+		if m.cfg == "ebpf: true\nebpf_track: true\n" && (c.Segments != wantSegs || c.Retrans != uint64(retrans)) {
+			t.Errorf("kernel tracker counted %d segments and %d retransmissions, want %d and %d", c.Segments, c.Retrans, wantSegs, retrans)
+		}
+	}
+}
+
+// Idle connections leave the kernel table, with their last counts scored
+// first, and the table read sees live ones.
+func TestEBPFTrackIdleConnectionsAreForgotten(t *testing.T) {
+	labtest.RequireRoot(t)
+	dev, _ := labtest.Veth(t, "192.0.2.1/24")
+	s := startSource(t, mustSource(t, "interface: "+dev+"\npromiscuous: false\nebpf: true\nebpf_track: true\n"+
+		"syn_timeout: 100ms\nflow_idle: 1s\nlocal: [192.0.2.0/24]\n"))
+	if s.kt == nil {
+		t.Fatal("kernel tracker not loaded")
+	}
+	l, r := ap(localV4, 48000), ap(retransV4, 443)
+	paced(t, newInjector(t, dev), []pkt{
+		{src: l, dst: r, seq: 1, flags: flagSYN},
+		{at: time.Millisecond, src: l, dst: r, seq: 2, flags: flagACK, data: 100},
+		{at: 2 * time.Millisecond, src: l, dst: r, seq: 102, flags: flagACK, data: 100},
+	})
+	live := func() int {
+		st, err := s.kt.flows()
+		if err != nil {
+			t.Fatal(err)
+		}
+		return len(st)
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for live() != 1 {
+		if time.Now().After(deadline) {
+			t.Fatal("the connection never reached the kernel table")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	time.Sleep(1200 * time.Millisecond)
+	s.sweep(s.now())
+	if n := live(); n != 0 {
+		t.Fatalf("%d connections still in the table after the idle time", n)
+	}
+	if c := prefixTotals(s, "198.51.100.0/24"); c.Segments != 2 || c.Flows != 1 || c.Timeouts != 1 {
+		t.Fatalf("counts = %+v, want 2 segments and 1 timeout in 1 flow", c)
+	}
+}
diff --git a/internal/plugins/source/span/ktrack.go b/internal/plugins/source/span/ktrack.go
new file mode 100644
index 00000000..e7dc8b96
--- /dev/null
+++ b/internal/plugins/source/span/ktrack.go
@@ -0,0 +1,212 @@
+package span
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/GrandArcher/Packeteer/internal/ebpfpath"
+	"github.com/GrandArcher/Packeteer/internal/passive"
+)
+
+// kernelTracker is the eBPF connection tracker (#631): the kernel follows
+// the TCP connections and reports count deltas per remote address. What it
+// cannot do without a timer (SYN timeouts, expiry of idle connections) the
+// source does by reading the connection table.
+type kernelTracker interface {
+	next() (ebpfpath.Summary, error)
+	flows() ([]ebpfpath.TrackState, error)
+	forget(ebpfpath.TrackKey) error
+	drops() (ring, flows uint64)
+	close() error
+}
+
+type ebpfTracker struct{ t *ebpfpath.Tracker }
+
+func (e ebpfTracker) next() (ebpfpath.Summary, error) {
+	s, err := e.t.Next()
+	if errors.Is(err, ebpfpath.ErrTimeout) {
+		return s, errReadTimeout
+	}
+	return s, err
+}
+
+func (e ebpfTracker) flows() ([]ebpfpath.TrackState, error) { return e.t.Flows() }
+func (e ebpfTracker) forget(k ebpfpath.TrackKey) error      { return e.t.Forget(k) }
+func (e ebpfTracker) close() error                          { return e.t.Close() }
+
+func (e ebpfTracker) drops() (ring, flows uint64) {
+	ring, flows, _ = e.t.Drops()
+	return ring, flows
+}
+
+func openKernelTracker(o ebpfpath.TrackOptions) (kernelTracker, error) {
+	t, err := ebpfpath.OpenTracker(o)
+	if err != nil {
+		return nil, err
+	}
+	return ebpfTracker{t}, nil
+}
+
+// connState is what userspace remembers of a connection the kernel tracks:
+// the counters already scored, and the handshake timeouts already counted
+// (by the kernel timestamp of the SYN or SYN-ACK). A final connection, one
+// the kernel or the sweep forgot, is kept as a tombstone for finalHold: a
+// table read taken before it was forgotten can still arrive, and must not
+// score it again.
+type connState struct {
+	ebpfpath.Counters
+	synAt, synAckAt uint64
+	touched         time.Time
+	final           bool
+}
+
+const finalHold = 10 * time.Second
+
+// kernelRun reads summaries until the source stops, and reads the
+// connection table every sweepEvery, as the userspace tracker sweeps while
+// packets arrive.
+func (s *Source) kernelRun(ctx context.Context, kt kernelTracker) {
+	defer s.wg.Done()
+	defer func() {
+		s.capMu.Lock()
+		s.kt = nil
+		s.capMu.Unlock()
+		_ = kt.close()
+	}()
+	lastSweep := s.now()
+	for !s.stopped(ctx) {
+		sum, err := kt.next()
+		switch {
+		case errors.Is(err, errReadTimeout):
+		case err != nil:
+			s.log.Warn("span eBPF tracker stopped", "interface", s.iface, "err", err)
+			return
+		default:
+			s.kmu.Lock()
+			s.account(s.now(), sum.Key, sum.Counters, sum.Final)
+			s.kmu.Unlock()
+		}
+		if now := s.now(); now.Sub(lastSweep) >= sweepEvery {
+			lastSweep = now
+			s.kernelSweep(now, kt)
+		}
+	}
+}
+
+// account scores what a connection's counters gained since the last time
+// they were seen, with the same remote filter, prefix, and counters as the
+// userspace tracker. A summary and a table read can arrive in either order:
+// a counter that did not grow adds nothing. kmu is held.
+func (s *Source) account(at time.Time, key ebpfpath.TrackKey, c ebpfpath.Counters, final bool) {
+	remote := key.Remote.Addr()
+	if !s.keep(remote) {
+		return
+	}
+	p := s.prefixFor(remote)
+	if !p.IsValid() || !p.Contains(remote) {
+		return
+	}
+	cs := s.conns[key]
+	if cs != nil && cs.final && cs.Created == c.Created {
+		return
+	}
+	var d passive.Counts
+	if cs == nil || cs.Created != c.Created {
+		cs = &connState{Counters: ebpfpath.Counters{Created: c.Created}}
+		s.conns[key] = cs
+		d.Flows = 1
+	}
+	cs.touched = at
+	grow := func(now uint64, seen *uint64) uint64 {
+		if now <= *seen {
+			return 0
+		}
+		g := now - *seen
+		*seen = now
+		return g
+	}
+	d.Segments = grow(c.Segments, &cs.Segments)
+	d.Retrans = grow(c.Retrans, &cs.Retrans)
+	d.Resets = grow(c.Resets, &cs.Resets)
+	d.RTTSamples = grow(c.RTTSamples, &cs.RTTSamples)
+	sum := uint64(cs.RTTSum)
+	d.RTTSum = time.Duration(grow(uint64(c.RTTSum), &sum))
+	cs.RTTSum = time.Duration(sum)
+	if d != (passive.Counts{}) {
+		s.win.Add(at, p, remote, d)
+	}
+	cs.final = final
+}
+
+// kernelSweep reads the connection table. It scores the counts no summary
+// has carried yet, counts handshakes that timed out once each (the kernel
+// has no timer), and removes connections that went idle. A handshake
+// answered after syn_timeout and before the read is counted as neither a
+// timeout nor an RTT, as in the userspace tracker between its sweeps.
+func (s *Source) kernelSweep(now time.Time, kt kernelTracker) {
+	states, err := kt.flows()
+	if err != nil {
+		s.log.Warn("span eBPF connection table unreadable", "err", err)
+		return
+	}
+	s.kmu.Lock()
+	defer s.kmu.Unlock()
+	for _, st := range states {
+		s.account(now, st.Key, st.Counters, false)
+		if cs := s.conns[st.Key]; cs != nil && !cs.final {
+			s.timeouts(now, st, cs)
+		}
+		if st.Idle >= s.trk.idle {
+			_ = kt.forget(st.Key)
+			// Two sweeps can hold the same table read; the second must
+			// not score the forgotten connection again.
+			if cs := s.conns[st.Key]; cs != nil {
+				cs.final, cs.touched = true, now
+			}
+		}
+	}
+	// Entries of connections that left the table without a summary, and
+	// tombstones, expire here.
+	for k, cs := range s.conns {
+		ttl := s.trk.idle
+		if cs.final {
+			ttl = finalHold
+		}
+		if now.Sub(cs.touched) >= ttl {
+			delete(s.conns, k)
+		}
+	}
+}
+
+// timeouts counts the handshakes of st that outlived syn_timeout and were
+// not counted yet. kmu is held.
+func (s *Source) timeouts(now time.Time, st ebpfpath.TrackState, cs *connState) {
+	var n uint64
+	if st.SynAt != 0 && st.SynAge >= s.trk.synTimeout && cs.synAt != st.SynAt {
+		cs.synAt = st.SynAt
+		n++
+	}
+	if st.SynAckAt != 0 && st.SynAckAge >= s.trk.synTimeout && cs.synAckAt != st.SynAckAt {
+		cs.synAckAt = st.SynAckAt
+		n++
+	}
+	if n == 0 {
+		return
+	}
+	remote := st.Key.Remote.Addr()
+	if p := s.prefixFor(remote); p.IsValid() && p.Contains(remote) {
+		s.win.Add(now, p, remote, passive.Counts{Timeouts: n})
+	}
+}
+
+func (s *Source) trackOptions() ebpfpath.TrackOptions {
+	return ebpfpath.TrackOptions{
+		Interface:  s.iface,
+		Promisc:    s.promisc,
+		Local:      s.trk.local,
+		SYNTimeout: s.trk.synTimeout,
+		MaxFlows:   s.trk.maxFlows,
+		Timeout:    readTimeout,
+	}
+}
