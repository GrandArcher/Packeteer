diff --git a/lab/herdhub/main.go b/lab/herdhub/main.go
new file mode 100644
index 00000000..80ec9e10
--- /dev/null
+++ b/lab/herdhub/main.go
@@ -0,0 +1,55 @@
+// Command herdhub is the local herd hub of the herd lab (lab/e2e-herd.sh,
+// #659): an https server that serves one hub list document at /herd.json,
+// as a hub repository would publish it (docs/herd-hub.md). The script
+// builds the list from the members' entries with "packeteer herd
+// hub-check -list" and adds the entries a node must refuse. The hub signs
+// and checks nothing and holds no measurements: every node checks every
+// entry itself. Each request is logged, so the script can see which
+// members fetched the list. It is a lab tool, not a public hub, and it
+// announces nothing.
+//
+// Usage: herdhub -cert FILE -key FILE -list FILE
+package main
+
+import (
+	"flag"
+	"log"
+	"net/http"
+	"os"
+	"time"
+)
+
+func main() {
+	cert := flag.String("cert", "", "TLS certificate")
+	key := flag.String("key", "", "TLS key")
+	list := flag.String("list", "", "hub list document to serve")
+	flag.Parse()
+	if *cert == "" || *key == "" || *list == "" {
+		log.Fatal("herdhub: -cert, -key, and -list are required")
+	}
+	srv := &http.Server{Addr: ":8443", Handler: handler(*list, log.Default()), ReadHeaderTimeout: 10 * time.Second}
+	log.Fatal(srv.ListenAndServeTLS(*cert, *key))
+}
+
+// handler serves the list file at GET /herd.json, read on every request.
+func handler(list string, logger *log.Logger) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		logger.Printf("herdhub: %s %s from %s", r.Method, r.URL.Path, r.RemoteAddr)
+		if r.URL.Path != "/herd.json" {
+			http.NotFound(w, r)
+			return
+		}
+		if r.Method != http.MethodGet {
+			w.Header().Set("Allow", http.MethodGet)
+			http.Error(w, "GET only", http.StatusMethodNotAllowed)
+			return
+		}
+		b, err := os.ReadFile(list)
+		if err != nil {
+			http.Error(w, "no hub list", http.StatusServiceUnavailable)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write(b)
+	})
+}
diff --git a/lab/herdhub/main_test.go b/lab/herdhub/main_test.go
new file mode 100644
index 00000000..c160dd72
--- /dev/null
+++ b/lab/herdhub/main_test.go
@@ -0,0 +1,53 @@
+package main
+
+import (
+	"bytes"
+	"log"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestHandlerServesTheListAndLogsEachRequest(t *testing.T) {
+	list := filepath.Join(t.TempDir(), "herd.json")
+	var logs bytes.Buffer
+	h := handler(list, log.New(&logs, "", 0))
+
+	get := func(method, path string) *httptest.ResponseRecorder {
+		rec := httptest.NewRecorder()
+		req := httptest.NewRequest(method, path, nil)
+		req.RemoteAddr = "192.0.2.10:40000"
+		h.ServeHTTP(rec, req)
+		return rec
+	}
+
+	if rec := get(http.MethodGet, "/herd.json"); rec.Code != http.StatusServiceUnavailable {
+		t.Fatalf("no list file: status %d, want 503", rec.Code)
+	}
+	if err := os.WriteFile(list, []byte(`{"schema":"packeteer-herd-hub/1","entries":[]}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	rec := get(http.MethodGet, "/herd.json")
+	if rec.Code != http.StatusOK || rec.Header().Get("Content-Type") != "application/json" || !strings.Contains(rec.Body.String(), "packeteer-herd-hub/1") {
+		t.Fatalf("GET /herd.json: %d %q %q", rec.Code, rec.Header().Get("Content-Type"), rec.Body.String())
+	}
+	// The file is read on every request, not cached at start.
+	if err := os.WriteFile(list, []byte(`{"replaced":true}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if rec := get(http.MethodGet, "/herd.json"); rec.Body.String() != `{"replaced":true}` {
+		t.Fatalf("second GET served %q, want the replaced file", rec.Body.String())
+	}
+	if rec := get(http.MethodPost, "/herd.json"); rec.Code != http.StatusMethodNotAllowed || rec.Header().Get("Allow") != http.MethodGet {
+		t.Fatalf("POST: status %d, Allow %q", rec.Code, rec.Header().Get("Allow"))
+	}
+	if rec := get(http.MethodGet, "/entries/64496.json"); rec.Code != http.StatusNotFound {
+		t.Fatalf("other path: status %d, want 404", rec.Code)
+	}
+	if !strings.Contains(logs.String(), "herdhub: GET /herd.json from 192.0.2.10:40000") || strings.Count(logs.String(), "\n") != 5 {
+		t.Fatalf("every request is logged with its client:\n%s", logs.String())
+	}
+}
