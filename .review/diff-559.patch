diff --git a/internal/plugins/covering/ripestat/ripestat.go b/internal/plugins/covering/ripestat/ripestat.go
new file mode 100644
index 00000000..85aa1968
--- /dev/null
+++ b/internal/plugins/covering/ripestat/ripestat.go
@@ -0,0 +1,123 @@
+// Package ripestat answers the non-BGP mode's covering-prefix question
+// (#300) with the RIPEstat network-info data call: the prefix that RIPE
+// RIS sees announced for an address. Each lookup sends one block's network
+// address (the first address of a /24 or /48, never a flow's own
+// address) to RIPE NCC, and the plugin spends at most rate_per_minute
+// requests. It is read-only and never announces.
+package ripestat
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/netip"
+	"net/url"
+	"strconv"
+	"time"
+
+	"golang.org/x/time/rate"
+
+	"github.com/GrandArcher/Packeteer/internal/outbound"
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+// TypeName is the config type.
+const TypeName = "ripestat"
+
+// Defaults and bounds.
+const (
+	DefaultRatePerMinute = 10
+	MaxRatePerMinute     = 60
+	fetchTimeout         = 10 * time.Second
+	maxBody              = 1 << 20
+)
+
+const defaultBase = "https://stat.ripe.net"
+
+func init() { plugin.Coverings.Register(TypeName, New) }
+
+// Config is the plugin's config block.
+type Config struct {
+	// RatePerMinute caps the lookups sent to RIPEstat (default 10, at most
+	// 60).
+	RatePerMinute int `yaml:"rate_per_minute"`
+}
+
+// Client is the covering plugin.
+type Client struct {
+	plugin.Base
+	base  string
+	http  *http.Client
+	limit *rate.Limiter
+}
+
+// New is the plugin factory. It validates the config and sends nothing.
+func New(c plugin.Config, _ plugin.Env) (plugin.Covering, error) {
+	var cfg Config
+	if err := c.Decode(&cfg); err != nil {
+		return nil, err
+	}
+	if cfg.RatePerMinute == 0 {
+		cfg.RatePerMinute = DefaultRatePerMinute
+	}
+	if cfg.RatePerMinute < 1 || cfg.RatePerMinute > MaxRatePerMinute {
+		return nil, fmt.Errorf("rate_per_minute %d must be between 1 and %d", cfg.RatePerMinute, MaxRatePerMinute)
+	}
+	return &Client{
+		base:  defaultBase,
+		http:  &http.Client{Timeout: fetchTimeout, CheckRedirect: outbound.SameHost},
+		limit: rate.NewLimiter(rate.Limit(float64(cfg.RatePerMinute)/60), 1),
+	}, nil
+}
+
+// response is the part of the network-info data call that matters.
+type response struct {
+	Data struct {
+		Prefix string   `json:"prefix"`
+		ASNs   []string `json:"asns"`
+	} `json:"data"`
+}
+
+// Covering waits for the rate limit, then asks RIPEstat for the announced
+// prefix that holds addr.
+func (c *Client) Covering(ctx context.Context, addr netip.Addr) (plugin.Announced, error) {
+	if err := c.limit.Wait(ctx); err != nil {
+		return plugin.Announced{}, err
+	}
+	q := url.Values{}
+	q.Set("resource", addr.String())
+	q.Set("sourceapp", "packeteer")
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, c.base+"/data/network-info/data.json?"+q.Encode(), nil)
+	if err != nil {
+		return plugin.Announced{}, err
+	}
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return plugin.Announced{}, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return plugin.Announced{}, fmt.Errorf("ripestat: %s", resp.Status)
+	}
+	var r response
+	if err := json.NewDecoder(io.LimitReader(resp.Body, maxBody)).Decode(&r); err != nil {
+		return plugin.Announced{}, fmt.Errorf("ripestat: %w", err)
+	}
+	if r.Data.Prefix == "" {
+		return plugin.Announced{}, fmt.Errorf("ripestat: no announced prefix for %s", addr)
+	}
+	p, err := netip.ParsePrefix(r.Data.Prefix)
+	if err != nil {
+		return plugin.Announced{}, fmt.Errorf("ripestat: prefix %q: %w", r.Data.Prefix, err)
+	}
+	out := plugin.Announced{Prefix: p.Masked()}
+	// An address announced by several origins names none.
+	if len(r.Data.ASNs) == 1 {
+		if n, err := strconv.ParseUint(r.Data.ASNs[0], 10, 32); err == nil {
+			out.Origin = uint32(n)
+		}
+	}
+	return out, nil
+}
diff --git a/internal/plugins/covering/ripestat/ripestat_test.go b/internal/plugins/covering/ripestat/ripestat_test.go
new file mode 100644
index 00000000..e651fec2
--- /dev/null
+++ b/internal/plugins/covering/ripestat/ripestat_test.go
@@ -0,0 +1,137 @@
+package ripestat
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"strings"
+	"testing"
+	"time"
+
+	"golang.org/x/time/rate"
+	"gopkg.in/yaml.v3"
+
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+func cfgOf(t *testing.T, y string) plugin.Config {
+	t.Helper()
+	var n yaml.Node
+	if err := yaml.Unmarshal([]byte(y), &n); err != nil {
+		t.Fatal(err)
+	}
+	if len(n.Content) == 0 {
+		return plugin.Config{}
+	}
+	return plugin.NewConfig(n.Content[0])
+}
+
+func newClient(t *testing.T, srv *httptest.Server) *Client {
+	t.Helper()
+	p, err := New(cfgOf(t, ""), plugin.Env{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := p.(*Client)
+	c.base = srv.URL
+	c.limit = rate.NewLimiter(rate.Inf, 1)
+	return c
+}
+
+func TestCoveringReadsTheAnnouncedPrefix(t *testing.T) {
+	var gotPath, gotResource string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotPath, gotResource = r.URL.Path, r.URL.Query().Get("resource")
+		_, _ = w.Write([]byte(`{"status":"ok","data":{"asns":["64496"],"prefix":"198.51.100.0/24"}}`))
+	}))
+	defer srv.Close()
+	got, err := newClient(t, srv).Covering(context.Background(), netip.MustParseAddr("198.51.100.0"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.Prefix != netip.MustParsePrefix("198.51.100.0/24") || got.Origin != 64496 {
+		t.Fatalf("answer = %+v", got)
+	}
+	if gotPath != "/data/network-info/data.json" || gotResource != "198.51.100.0" {
+		t.Fatalf("asked %s resource %q", gotPath, gotResource)
+	}
+}
+
+func TestSeveralOriginsNameNone(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = w.Write([]byte(`{"data":{"asns":["64496","64497"],"prefix":"192.0.2.0/24"}}`))
+	}))
+	defer srv.Close()
+	got, err := newClient(t, srv).Covering(context.Background(), netip.MustParseAddr("192.0.2.0"))
+	if err != nil || got.Prefix != netip.MustParsePrefix("192.0.2.0/24") || got.Origin != 0 {
+		t.Fatalf("answer = %+v, %v", got, err)
+	}
+}
+
+func TestCoveringRefusesBadAnswers(t *testing.T) {
+	for name, tc := range map[string]struct {
+		status int
+		body   string
+		want   string
+	}{
+		"http error":  {http.StatusTooManyRequests, `{}`, "429"},
+		"no prefix":   {200, `{"data":{"asns":[]}}`, "no announced prefix"},
+		"bad prefix":  {200, `{"data":{"prefix":"not-a-prefix"}}`, "prefix"},
+		"not json":    {200, `<html>`, "ripestat"},
+		"host bits":   {200, `{"data":{"prefix":"2001:db8:1::5/48"}}`, ""},
+		"empty reply": {200, ``, "ripestat"},
+	} {
+		srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			w.WriteHeader(tc.status)
+			_, _ = w.Write([]byte(tc.body))
+		}))
+		got, err := newClient(t, srv).Covering(context.Background(), netip.MustParseAddr("2001:db8:1::"))
+		srv.Close()
+		if tc.want == "" {
+			if err != nil || got.Prefix != netip.MustParsePrefix("2001:db8:1::/48") || got.Origin != 0 {
+				t.Errorf("%s: got %s, %v; want the masked prefix", name, got.Prefix, err)
+			}
+			continue
+		}
+		if err == nil || !strings.Contains(err.Error(), tc.want) {
+			t.Errorf("%s: err %v, want %q", name, err, tc.want)
+		}
+	}
+}
+
+func TestCoveringWaitsForTheRateLimit(t *testing.T) {
+	calls := 0
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		calls++
+		_, _ = w.Write([]byte(`{"data":{"prefix":"192.0.2.0/24"}}`))
+	}))
+	defer srv.Close()
+	c := newClient(t, srv)
+	c.limit = rate.NewLimiter(rate.Every(time.Hour), 1)
+	if _, err := c.Covering(context.Background(), netip.MustParseAddr("192.0.2.0")); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+	defer cancel()
+	if _, err := c.Covering(ctx, netip.MustParseAddr("192.0.2.0")); err == nil {
+		t.Fatal("a second lookup inside the limit was sent")
+	}
+	if calls != 1 {
+		t.Fatalf("server saw %d requests, want 1", calls)
+	}
+}
+
+func TestConfigBounds(t *testing.T) {
+	for _, y := range []string{"rate_per_minute: 61", "rate_per_minute: -1", "unknown_key: 1"} {
+		if _, err := New(cfgOf(t, y), plugin.Env{}); err == nil {
+			t.Errorf("%q accepted", y)
+		}
+	}
+	if _, err := New(cfgOf(t, "rate_per_minute: 60"), plugin.Env{}); err != nil {
+		t.Fatal(err)
+	}
+	if !plugin.Coverings.Has(TypeName) {
+		t.Fatal("ripestat is not registered as a covering plugin")
+	}
+}
diff --git a/internal/plugins/steerer/linux/linux.go b/internal/plugins/steerer/linux/linux.go
new file mode 100644
index 00000000..812c050b
--- /dev/null
+++ b/internal/plugins/steerer/linux/linux.go
@@ -0,0 +1,172 @@
+// Package linux is the non-BGP mode's steerer for a Linux router (#300):
+// Packeteer runs on the router itself (the container needs host networking
+// and NET_ADMIN) and keeps one static route per steered prefix in the main
+// table over netlink. Every route carries protocol number Proto. The plugin
+// lists the main table and changes or deletes only routes with that
+// protocol, checked here rather than left to a filter of the ip tool
+// (BusyBox's, in the image, does not filter by protocol). It refuses to add
+// a route for a prefix the host already routes, because a replace would
+// take that route over.
+package linux
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/netip"
+	"runtime"
+
+	"github.com/vishvananda/netlink"
+	"golang.org/x/sys/unix"
+
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+// TypeName is the config type.
+const TypeName = "linux"
+
+// Proto is the routing protocol number on every route this plugin owns.
+// It is in the range the kernel leaves to administrators and clear of the
+// numbers routing daemons use.
+const Proto = 250
+
+func init() { plugin.Steerers.Register(TypeName, New) }
+
+// Config has no keys: the routes go in the main table, tagged with Proto.
+type Config struct{}
+
+// routeTable is the main routing table as the steerer reaches it.
+type routeTable interface {
+	// list returns every main-table route of one family, any protocol.
+	list(family int) ([]netlink.Route, error)
+	replace(r *netlink.Route) error
+	del(r *netlink.Route) error
+}
+
+// kernel is this host's main table over netlink.
+type kernel struct{}
+
+func (kernel) list(family int) ([]netlink.Route, error) {
+	return netlink.RouteListFiltered(family, &netlink.Route{Table: unix.RT_TABLE_MAIN}, netlink.RT_FILTER_TABLE)
+}
+func (kernel) replace(r *netlink.Route) error { return netlink.RouteReplace(r) }
+func (kernel) del(r *netlink.Route) error     { return netlink.RouteDel(r) }
+
+// Steerer keeps static routes in this host's main table.
+type Steerer struct {
+	plugin.Base
+	table routeTable
+}
+
+// New is the plugin factory. It validates the config and changes nothing.
+func New(c plugin.Config, _ plugin.Env) (plugin.Steerer, error) {
+	var cfg Config
+	if err := c.Decode(&cfg); err != nil {
+		return nil, err
+	}
+	if runtime.GOOS != "linux" {
+		return nil, errors.New("the linux steerer runs only on Linux")
+	}
+	return &Steerer{table: kernel{}}, nil
+}
+
+func family(p netip.Prefix) int {
+	if p.Addr().Is6() {
+		return netlink.FAMILY_V6
+	}
+	return netlink.FAMILY_V4
+}
+
+// dst is a route's destination; a route with none is the default route.
+func dst(r netlink.Route, fam int) netip.Prefix {
+	if r.Dst == nil {
+		if fam == netlink.FAMILY_V6 {
+			return netip.MustParsePrefix("::/0")
+		}
+		return netip.MustParsePrefix("0.0.0.0/0")
+	}
+	a, ok := netip.AddrFromSlice(r.Dst.IP)
+	if !ok {
+		return netip.Prefix{}
+	}
+	ones, _ := r.Dst.Mask.Size()
+	return netip.PrefixFrom(a.Unmap(), ones).Masked()
+}
+
+// routes lists the main-table routes for p.
+func (s *Steerer) routes(p netip.Prefix) ([]netlink.Route, error) {
+	all, err := s.table.list(family(p))
+	if err != nil {
+		return nil, fmt.Errorf("list routes: %w", err)
+	}
+	var out []netlink.Route
+	for _, r := range all {
+		if dst(r, family(p)) == p {
+			out = append(out, r)
+		}
+	}
+	return out, nil
+}
+
+// Install replaces nothing it does not own: a prefix with a route lacking
+// Proto is refused.
+func (s *Steerer) Install(_ context.Context, r plugin.SteerRoute) error {
+	p := r.Prefix.Masked()
+	have, err := s.routes(p)
+	if err != nil {
+		return err
+	}
+	for _, h := range have {
+		if h.Protocol != Proto {
+			return fmt.Errorf("the host already has a route for %s that was not added with proto %d; remove it or leave the prefix out of the allowlist", p, Proto)
+		}
+	}
+	route := &netlink.Route{
+		Dst:      &net.IPNet{IP: p.Addr().AsSlice(), Mask: net.CIDRMask(p.Bits(), p.Addr().BitLen())},
+		Gw:       r.NextHop.AsSlice(),
+		Protocol: Proto,
+		Table:    unix.RT_TABLE_MAIN,
+	}
+	if err := s.table.replace(route); err != nil {
+		return fmt.Errorf("add route %s via %s: %w", p, r.NextHop, err)
+	}
+	return nil
+}
+
+// Remove deletes the routes for p that carry Proto. A route that is gone
+// is not an error.
+func (s *Steerer) Remove(_ context.Context, p netip.Prefix) error {
+	p = p.Masked()
+	have, err := s.routes(p)
+	if err != nil {
+		return err
+	}
+	var errs []error
+	for i := range have {
+		if have[i].Protocol != Proto {
+			continue
+		}
+		if err := s.table.del(&have[i]); err != nil {
+			errs = append(errs, fmt.Errorf("delete route %s: %w", p, err))
+		}
+	}
+	return errors.Join(errs...)
+}
+
+// Owned lists the routes that carry Proto, both families.
+func (s *Steerer) Owned(context.Context) ([]netip.Prefix, error) {
+	var out []netip.Prefix
+	for _, fam := range []int{netlink.FAMILY_V4, netlink.FAMILY_V6} {
+		all, err := s.table.list(fam)
+		if err != nil {
+			return nil, fmt.Errorf("list routes: %w", err)
+		}
+		for _, r := range all {
+			if r.Protocol == Proto {
+				out = append(out, dst(r, fam))
+			}
+		}
+	}
+	return out, nil
+}
diff --git a/internal/plugins/steerer/linux/linux_test.go b/internal/plugins/steerer/linux/linux_test.go
new file mode 100644
index 00000000..d225fbd8
--- /dev/null
+++ b/internal/plugins/steerer/linux/linux_test.go
@@ -0,0 +1,217 @@
+package linux
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"strings"
+	"testing"
+
+	"github.com/vishvananda/netlink"
+	"gopkg.in/yaml.v3"
+
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+// fakeTable is a host's main routing table. Like the kernel it lists every
+// route of the family, whatever its protocol: the steerer must pick its own.
+type fakeTable struct {
+	routes   []netlink.Route
+	replaced int
+	failList bool
+	failAdd  bool
+}
+
+func ipnet(s string) *net.IPNet {
+	p := netip.MustParsePrefix(s)
+	return &net.IPNet{IP: p.Addr().AsSlice(), Mask: net.CIDRMask(p.Bits(), p.Addr().BitLen())}
+}
+
+func (f *fakeTable) list(fam int) ([]netlink.Route, error) {
+	if f.failList {
+		return nil, errors.New("netlink: operation not permitted")
+	}
+	var out []netlink.Route
+	for _, r := range f.routes {
+		if (r.Dst == nil || r.Dst.IP.To4() != nil) == (fam == netlink.FAMILY_V4) {
+			out = append(out, r)
+		}
+	}
+	return out, nil
+}
+
+func (f *fakeTable) replace(r *netlink.Route) error {
+	if f.failAdd {
+		return errors.New("netlink: operation not permitted")
+	}
+	f.replaced++
+	for i := range f.routes {
+		if f.routes[i].Dst != nil && f.routes[i].Dst.String() == r.Dst.String() {
+			f.routes[i] = *r
+			return nil
+		}
+	}
+	f.routes = append(f.routes, *r)
+	return nil
+}
+
+func (f *fakeTable) del(r *netlink.Route) error {
+	for i := range f.routes {
+		if f.routes[i].Dst != nil && f.routes[i].Dst.String() == r.Dst.String() && f.routes[i].Protocol == r.Protocol {
+			f.routes = append(f.routes[:i], f.routes[i+1:]...)
+			return nil
+		}
+	}
+	return errors.New("no such process")
+}
+
+// find returns the route for dst, or nil.
+func (f *fakeTable) find(dst string) *netlink.Route {
+	for i := range f.routes {
+		if f.routes[i].Dst != nil && f.routes[i].Dst.String() == dst {
+			return &f.routes[i]
+		}
+	}
+	return nil
+}
+
+// host is a router with a default route, two connected links, and a
+// static route an operator added.
+func host() *fakeTable {
+	return &fakeTable{routes: []netlink.Route{
+		{Dst: nil, Gw: net.ParseIP("192.0.2.3"), Protocol: 3},
+		{Dst: ipnet("192.0.2.0/24"), Protocol: 2},
+		{Dst: ipnet("198.51.100.0/24"), Protocol: 2},
+		{Dst: ipnet("203.0.113.0/24"), Gw: net.ParseIP("192.0.2.1"), Protocol: 4},
+	}}
+}
+
+func pfx(s string) netip.Prefix { return netip.MustParsePrefix(s) }
+
+func TestInstallRemoveBothFamilies(t *testing.T) {
+	f := &fakeTable{}
+	s := &Steerer{table: f}
+	ctx := context.Background()
+	v4 := plugin.SteerRoute{Prefix: pfx("198.51.100.0/24"), NextHop: netip.MustParseAddr("192.0.2.1")}
+	v6 := plugin.SteerRoute{Prefix: pfx("2001:db8:1::/48"), NextHop: netip.MustParseAddr("2001:db8:ffff::1")}
+	for _, r := range []plugin.SteerRoute{v4, v6} {
+		if err := s.Install(ctx, r); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if r := f.find("198.51.100.0/24"); r == nil || !r.Gw.Equal(net.ParseIP("192.0.2.1")) || r.Protocol != Proto || r.Table != 254 {
+		t.Fatalf("v4 route = %+v", r)
+	}
+	if r := f.find("2001:db8:1::/48"); r == nil || !r.Gw.Equal(net.ParseIP("2001:db8:ffff::1")) || r.Protocol != Proto {
+		t.Fatalf("v6 route = %+v", r)
+	}
+	// Installing again, even through another gateway, replaces the one route.
+	v4.NextHop = netip.MustParseAddr("198.51.100.1")
+	if err := s.Install(ctx, v4); err != nil {
+		t.Fatal(err)
+	}
+	if len(f.routes) != 2 || !f.find("198.51.100.0/24").Gw.Equal(net.ParseIP("198.51.100.1")) {
+		t.Fatalf("routes = %+v", f.routes)
+	}
+	owned, err := s.Owned(ctx)
+	if err != nil || len(owned) != 2 || owned[0] != v4.Prefix || owned[1] != v6.Prefix {
+		t.Fatalf("owned = %v, %v", owned, err)
+	}
+	for _, r := range []plugin.SteerRoute{v4, v6} {
+		if err := s.Remove(ctx, r.Prefix); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if len(f.routes) != 0 {
+		t.Fatalf("routes stayed: %+v", f.routes)
+	}
+	if err := s.Remove(ctx, v4.Prefix); err != nil {
+		t.Fatalf("removing a route that is gone: %v", err)
+	}
+}
+
+// The table lists every protocol, as BusyBox's ip does even when asked for
+// one: only routes with Proto are owned, removed, or replaced.
+func TestForeignRoutesAreNeverTakenOrDeleted(t *testing.T) {
+	f := host()
+	s := &Steerer{table: f}
+	ctx := context.Background()
+	owned, err := s.Owned(ctx)
+	if err != nil || len(owned) != 0 {
+		t.Fatalf("owned = %v, %v; the host's own routes are not owned", owned, err)
+	}
+	err = s.Install(ctx, plugin.SteerRoute{Prefix: pfx("203.0.113.0/24"), NextHop: netip.MustParseAddr("198.51.100.1")})
+	if err == nil || !strings.Contains(err.Error(), "already has a route") || f.replaced != 0 {
+		t.Fatalf("err = %v, replaced %d", err, f.replaced)
+	}
+	for _, p := range []string{"203.0.113.0/24", "192.0.2.0/24", "0.0.0.0/0"} {
+		if err := s.Remove(ctx, pfx(p)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if len(f.routes) != 4 || !f.find("203.0.113.0/24").Gw.Equal(net.ParseIP("192.0.2.1")) {
+		t.Fatalf("a route without proto %d was changed or deleted: %+v", Proto, f.routes)
+	}
+	// Its own route beside them is found and removed alone.
+	if err := s.Install(ctx, plugin.SteerRoute{Prefix: pfx("198.51.100.0/25"), NextHop: netip.MustParseAddr("198.51.100.1")}); err != nil {
+		t.Fatal(err)
+	}
+	if owned, _ := s.Owned(ctx); len(owned) != 1 || owned[0] != pfx("198.51.100.0/25") {
+		t.Fatalf("owned = %v", owned)
+	}
+	if err := s.Remove(ctx, pfx("198.51.100.0/25")); err != nil || len(f.routes) != 4 {
+		t.Fatalf("remove: %v, routes %+v", err, f.routes)
+	}
+}
+
+func TestNetlinkErrorsAreReturned(t *testing.T) {
+	f := &fakeTable{failAdd: true}
+	err := (&Steerer{table: f}).Install(context.Background(), plugin.SteerRoute{Prefix: pfx("198.51.100.0/24"), NextHop: netip.MustParseAddr("192.0.2.1")})
+	if err == nil || !strings.Contains(err.Error(), "operation not permitted") {
+		t.Fatalf("err = %v", err)
+	}
+	f.failList = true
+	if _, err := (&Steerer{table: f}).Owned(context.Background()); err == nil {
+		t.Fatal("a failed listing was not reported")
+	}
+	if err := (&Steerer{table: f}).Remove(context.Background(), pfx("198.51.100.0/24")); err == nil {
+		t.Fatal("a failed listing was not reported by Remove")
+	}
+}
+
+func TestDst(t *testing.T) {
+	for _, tc := range []struct {
+		r    netlink.Route
+		fam  int
+		want string
+	}{
+		{netlink.Route{Dst: ipnet("198.51.100.0/24")}, netlink.FAMILY_V4, "198.51.100.0/24"},
+		{netlink.Route{Dst: ipnet("192.0.2.9/32")}, netlink.FAMILY_V4, "192.0.2.9/32"},
+		{netlink.Route{Dst: ipnet("2001:db8::/48")}, netlink.FAMILY_V6, "2001:db8::/48"},
+		{netlink.Route{}, netlink.FAMILY_V4, "0.0.0.0/0"},
+		{netlink.Route{}, netlink.FAMILY_V6, "::/0"},
+	} {
+		if got := dst(tc.r, tc.fam); got != pfx(tc.want) {
+			t.Errorf("dst(%v) = %s, want %s", tc.r.Dst, got, tc.want)
+		}
+	}
+}
+
+func TestConfigAndRegistration(t *testing.T) {
+	var n yaml.Node
+	_ = yaml.Unmarshal([]byte("table: 5"), &n)
+	if _, err := New(plugin.NewConfig(n.Content[0]), plugin.Env{}); err == nil {
+		t.Error("an unknown key was accepted")
+	}
+	s, err := New(plugin.Config{}, plugin.Env{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := s.(*Steerer).table.(kernel); !ok {
+		t.Fatal("the plugin does not use the kernel table")
+	}
+	if !plugin.Steerers.Has(TypeName) {
+		t.Fatal("linux is not registered as a steerer")
+	}
+}
diff --git a/internal/plugins/steerer/mikrotik/mikrotik.go b/internal/plugins/steerer/mikrotik/mikrotik.go
new file mode 100644
index 00000000..53216833
--- /dev/null
+++ b/internal/plugins/steerer/mikrotik/mikrotik.go
@@ -0,0 +1,243 @@
+// Package mikrotik is the non-BGP mode's steerer for RouterOS 7 (#300). It
+// keeps one static route per steered prefix through the router's REST API
+// (/rest/ip/route and /rest/ipv6/route), each tagged with a fixed comment.
+// It lists, changes, and deletes only tagged routes, and refuses to add a
+// route for a prefix the operator already routes by hand, because a second
+// route for the same prefix would share the traffic with it.
+package mikrotik
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/netip"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/GrandArcher/Packeteer/internal/outbound"
+	"github.com/GrandArcher/Packeteer/internal/plugins/exporter/sinkcfg"
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+// TypeName is the config type.
+const TypeName = "mikrotik"
+
+// Tag is the comment on every route this plugin owns.
+const Tag = "packeteer-steer"
+
+const (
+	requestTimeout = 10 * time.Second
+	maxBody        = 4 << 20
+)
+
+func init() { plugin.Steerers.Register(TypeName, New) }
+
+// Config is the plugin's config block. The REST API carries the router
+// login, so the URL must be https (http only to a loopback host).
+type Config struct {
+	URL         string `yaml:"url"`
+	UsernameEnv string `yaml:"username_env"`
+	PasswordEnv string `yaml:"password_env"`
+	// CAFile is an absolute path to the PEM certificate that signed the
+	// router's REST certificate. Without it the system roots are used.
+	CAFile string `yaml:"ca_file"`
+}
+
+// Steerer is the RouterOS REST steerer.
+type Steerer struct {
+	plugin.Base
+	base       string
+	user, pass string
+	http       *http.Client
+}
+
+// New is the plugin factory. It validates the config and contacts nothing.
+func New(c plugin.Config, env plugin.Env) (plugin.Steerer, error) {
+	var cfg Config
+	if err := c.Decode(&cfg); err != nil {
+		return nil, err
+	}
+	u, err := sinkcfg.HTTPURL(cfg.URL)
+	if err != nil {
+		return nil, fmt.Errorf("url: %w", err)
+	}
+	if err := sinkcfg.TokenURL(u); err != nil {
+		return nil, fmt.Errorf("url: %w", err)
+	}
+	if cfg.UsernameEnv == "" || cfg.PasswordEnv == "" {
+		return nil, errors.New("username_env and password_env are required: the REST API needs a login")
+	}
+	user, pass, err := sinkcfg.Credentials(env.Getenv, cfg.UsernameEnv, cfg.PasswordEnv)
+	if err != nil && !env.CheckOnly {
+		return nil, err
+	}
+	tlsConf, err := sinkcfg.TLS(u.Scheme == "https", cfg.CAFile)
+	if err != nil {
+		return nil, err
+	}
+	tr := http.DefaultTransport.(*http.Transport).Clone()
+	tr.TLSClientConfig = tlsConf
+	return &Steerer{
+		base: strings.TrimRight(u.String(), "/") + "/rest", user: user, pass: pass,
+		// The login must never follow a redirect to another host.
+		http: &http.Client{Timeout: requestTimeout, Transport: tr, CheckRedirect: outbound.SameHost},
+	}, nil
+}
+
+// row is one route as RouterOS lists it. Every value is a string.
+type row struct {
+	ID      string `json:".id"`
+	Dst     string `json:"dst-address"`
+	Gateway string `json:"gateway"`
+	Comment string `json:"comment"`
+}
+
+func path(p netip.Prefix) string {
+	if p.Addr().Is6() {
+		return "/ipv6/route"
+	}
+	return "/ip/route"
+}
+
+func (s *Steerer) do(ctx context.Context, method, p string, body any, out any) error {
+	var rd io.Reader
+	if body != nil {
+		b, err := json.Marshal(body)
+		if err != nil {
+			return err
+		}
+		rd = bytes.NewReader(b)
+	}
+	req, err := http.NewRequestWithContext(ctx, method, s.base+p, rd)
+	if err != nil {
+		return err
+	}
+	req.SetBasicAuth(s.user, s.pass)
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	resp, err := s.http.Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	data, err := io.ReadAll(io.LimitReader(resp.Body, maxBody))
+	if err != nil {
+		return err
+	}
+	if resp.StatusCode/100 != 2 {
+		return fmt.Errorf("routeros %s %s: %s", method, p, httpError(resp.Status, data))
+	}
+	if out == nil {
+		return nil
+	}
+	return json.Unmarshal(data, out)
+}
+
+// httpError is the status and the router's one-line message, which holds
+// no credentials.
+func httpError(status string, body []byte) string {
+	var m struct {
+		Message string `json:"message"`
+		Detail  string `json:"detail"`
+	}
+	if json.Unmarshal(body, &m) == nil && m.Message != "" {
+		if m.Detail != "" {
+			return status + ": " + m.Message + " (" + m.Detail + ")"
+		}
+		return status + ": " + m.Message
+	}
+	return status
+}
+
+// routes lists the routes for dst. RouterOS filters by property in the
+// query; the result is filtered again here so a router that ignores the
+// filter cannot make this plugin touch a route it did not match.
+func (s *Steerer) routes(ctx context.Context, p netip.Prefix) ([]row, error) {
+	var rows []row
+	q := url.Values{"dst-address": {p.Masked().String()}}
+	if err := s.do(ctx, http.MethodGet, path(p)+"?"+q.Encode(), nil, &rows); err != nil {
+		return nil, err
+	}
+	var out []row
+	for _, r := range rows {
+		if got, err := netip.ParsePrefix(r.Dst); err == nil && got.Masked() == p.Masked() {
+			out = append(out, r)
+		}
+	}
+	return out, nil
+}
+
+// Install adds the tagged route, or points the tagged route at the new
+// gateway. It refuses a prefix that has a route it did not add.
+func (s *Steerer) Install(ctx context.Context, r plugin.SteerRoute) error {
+	p := r.Prefix.Masked()
+	rows, err := s.routes(ctx, p)
+	if err != nil {
+		return err
+	}
+	var mine *row
+	var errs []error
+	for i := range rows {
+		if rows[i].Comment != Tag {
+			return fmt.Errorf("routeros already has a route for %s that %s did not add; remove it or leave the prefix out of the allowlist", p, Tag)
+		}
+		if mine == nil {
+			mine = &rows[i]
+		}
+	}
+	if mine == nil {
+		return s.do(ctx, http.MethodPut, path(p), map[string]string{
+			"dst-address": p.String(), "gateway": r.NextHop.String(), "comment": Tag,
+		}, nil)
+	}
+	// A second tagged row would keep the old gateway and split the traffic.
+	for _, extra := range rows {
+		if extra.ID != mine.ID {
+			errs = append(errs, s.do(ctx, http.MethodDelete, path(p)+"/"+url.PathEscape(extra.ID), nil, nil))
+		}
+	}
+	if mine.Gateway != r.NextHop.String() {
+		errs = append(errs, s.do(ctx, http.MethodPatch, path(p)+"/"+url.PathEscape(mine.ID), map[string]string{"gateway": r.NextHop.String()}, nil))
+	}
+	return errors.Join(errs...)
+}
+
+// Remove deletes the tagged routes for p.
+func (s *Steerer) Remove(ctx context.Context, p netip.Prefix) error {
+	rows, err := s.routes(ctx, p)
+	if err != nil {
+		return err
+	}
+	var errs []error
+	for _, r := range rows {
+		if r.Comment != Tag {
+			continue
+		}
+		errs = append(errs, s.do(ctx, http.MethodDelete, path(p)+"/"+url.PathEscape(r.ID), nil, nil))
+	}
+	return errors.Join(errs...)
+}
+
+// Owned lists the tagged routes of both families.
+func (s *Steerer) Owned(ctx context.Context) ([]netip.Prefix, error) {
+	var out []netip.Prefix
+	for _, p := range []string{"/ip/route", "/ipv6/route"} {
+		var rows []row
+		q := url.Values{"comment": {Tag}}
+		if err := s.do(ctx, http.MethodGet, p+"?"+q.Encode(), nil, &rows); err != nil {
+			return nil, err
+		}
+		for _, r := range rows {
+			if pf, err := netip.ParsePrefix(r.Dst); err == nil && r.Comment == Tag {
+				out = append(out, pf.Masked())
+			}
+		}
+	}
+	return out, nil
+}
diff --git a/internal/plugins/steerer/mikrotik/mikrotik_test.go b/internal/plugins/steerer/mikrotik/mikrotik_test.go
new file mode 100644
index 00000000..b3d7ce8b
--- /dev/null
+++ b/internal/plugins/steerer/mikrotik/mikrotik_test.go
@@ -0,0 +1,308 @@
+package mikrotik
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"strings"
+	"sync"
+	"testing"
+
+	"gopkg.in/yaml.v3"
+
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+// fakeRouterOS is the part of the RouterOS 7 REST API the steerer uses:
+// each family has its own route list, and a request must carry the login.
+type fakeRouterOS struct {
+	mu     sync.Mutex
+	rows   map[string][]map[string]string // "/ip/route" -> routes
+	next   int
+	calls  []string
+	failOn string
+}
+
+func newFakeRouterOS() *fakeRouterOS {
+	return &fakeRouterOS{rows: map[string][]map[string]string{"/ip/route": nil, "/ipv6/route": nil}}
+}
+
+func (f *fakeRouterOS) add(kind, dst, gw, comment string) string {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.next++
+	id := fmt.Sprintf("*%d", f.next)
+	f.rows[kind] = append(f.rows[kind], map[string]string{".id": id, "dst-address": dst, "gateway": gw, "comment": comment})
+	return id
+}
+
+func (f *fakeRouterOS) find(kind, dst string) []map[string]string {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	var out []map[string]string
+	for _, r := range f.rows[kind] {
+		if r["dst-address"] == dst {
+			out = append(out, r)
+		}
+	}
+	return out
+}
+
+func (f *fakeRouterOS) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	if u, p, ok := r.BasicAuth(); !ok || u != "pk" || p != "lab-secret" {
+		w.WriteHeader(http.StatusUnauthorized)
+		return
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.calls = append(f.calls, r.Method+" "+r.URL.RequestURI())
+	if f.failOn != "" && strings.HasPrefix(r.Method+" "+r.URL.Path, f.failOn) {
+		w.WriteHeader(http.StatusBadRequest)
+		_, _ = w.Write([]byte(`{"error":400,"message":"Bad Request","detail":"failure to create route"}`))
+		return
+	}
+	trim := strings.TrimPrefix(r.URL.Path, "/rest")
+	kind, id := trim, ""
+	if i := strings.LastIndex(trim, "/*"); i >= 0 {
+		kind, id = trim[:i], trim[i+1:]
+	}
+	rows, ok := f.rows[kind]
+	if !ok {
+		w.WriteHeader(http.StatusNotFound)
+		return
+	}
+	switch r.Method {
+	case http.MethodGet:
+		// The router filters on the query. Ignore it on purpose half of
+		// the time would hide a bug, so the fake honors it fully.
+		var out []map[string]string
+		for _, row := range rows {
+			match := true
+			for k, v := range r.URL.Query() {
+				if row[k] != v[0] {
+					match = false
+				}
+			}
+			if match {
+				out = append(out, row)
+			}
+		}
+		_ = json.NewEncoder(w).Encode(out)
+	case http.MethodPut:
+		var body map[string]string
+		_ = json.NewDecoder(r.Body).Decode(&body)
+		f.next++
+		body[".id"] = fmt.Sprintf("*%d", f.next)
+		f.rows[kind] = append(rows, body)
+		_ = json.NewEncoder(w).Encode(body)
+	case http.MethodPatch:
+		var body map[string]string
+		_ = json.NewDecoder(r.Body).Decode(&body)
+		for _, row := range rows {
+			if row[".id"] == "*"+strings.TrimPrefix(id, "*") || row[".id"] == id {
+				for k, v := range body {
+					row[k] = v
+				}
+			}
+		}
+		_ = json.NewEncoder(w).Encode(map[string]string{})
+	case http.MethodDelete:
+		var keep []map[string]string
+		for _, row := range rows {
+			if row[".id"] != id {
+				keep = append(keep, row)
+			}
+		}
+		f.rows[kind] = keep
+		w.WriteHeader(http.StatusNoContent)
+	}
+}
+
+func newSteerer(t *testing.T, h http.Handler) plugin.Steerer {
+	t.Helper()
+	srv := httptest.NewServer(h)
+	t.Cleanup(srv.Close)
+	return mustNew(t, "url: "+srv.URL+"\nusername_env: PK_USER\npassword_env: PK_PASS\n")
+}
+
+func mustNew(t *testing.T, y string) plugin.Steerer {
+	t.Helper()
+	var n yaml.Node
+	if err := yaml.Unmarshal([]byte(y), &n); err != nil {
+		t.Fatal(err)
+	}
+	env := plugin.Env{Getenv: func(k string) string { return map[string]string{"PK_USER": "pk", "PK_PASS": "lab-secret"}[k] }}
+	s, err := New(plugin.NewConfig(n.Content[0]), env)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+
+func pfx(s string) netip.Prefix { return netip.MustParsePrefix(s) }
+
+func TestInstallSwitchRemove(t *testing.T) {
+	rt := newFakeRouterOS()
+	s := newSteerer(t, rt)
+	ctx := context.Background()
+	r := plugin.SteerRoute{Prefix: pfx("198.51.100.0/24"), NextHop: netip.MustParseAddr("192.0.2.1")}
+	if err := s.Install(ctx, r); err != nil {
+		t.Fatal(err)
+	}
+	rows := rt.find("/ip/route", "198.51.100.0/24")
+	if len(rows) != 1 || rows[0]["gateway"] != "192.0.2.1" || rows[0]["comment"] != Tag {
+		t.Fatalf("route = %v", rows)
+	}
+	// Installing the same route again changes nothing.
+	n := len(rt.calls)
+	if err := s.Install(ctx, r); err != nil {
+		t.Fatal(err)
+	}
+	for _, c := range rt.calls[n:] {
+		if !strings.HasPrefix(c, "GET ") {
+			t.Fatalf("a repeat install wrote: %s", c)
+		}
+	}
+	// A new gateway updates the one route in place.
+	r.NextHop = netip.MustParseAddr("198.51.100.1")
+	if err := s.Install(ctx, r); err != nil {
+		t.Fatal(err)
+	}
+	rows = rt.find("/ip/route", "198.51.100.0/24")
+	if len(rows) != 1 || rows[0]["gateway"] != "198.51.100.1" {
+		t.Fatalf("after switch: %v", rows)
+	}
+	if err := s.Remove(ctx, r.Prefix); err != nil {
+		t.Fatal(err)
+	}
+	if rows = rt.find("/ip/route", "198.51.100.0/24"); len(rows) != 0 {
+		t.Fatalf("route stayed: %v", rows)
+	}
+	if err := s.Remove(ctx, r.Prefix); err != nil {
+		t.Fatalf("removing a route that is gone: %v", err)
+	}
+}
+
+func TestIPv6UsesItsOwnRouteTable(t *testing.T) {
+	rt := newFakeRouterOS()
+	s := newSteerer(t, rt)
+	err := s.Install(context.Background(), plugin.SteerRoute{Prefix: pfx("2001:db8:1::/48"), NextHop: netip.MustParseAddr("2001:db8:ffff::1")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rt.find("/ipv6/route", "2001:db8:1::/48")) != 1 || len(rt.rows["/ip/route"]) != 0 {
+		t.Fatalf("rows = %v", rt.rows)
+	}
+}
+
+func TestInstallLeavesOneTaggedRowOnTheNewGateway(t *testing.T) {
+	rt := newFakeRouterOS()
+	rt.add("/ip/route", "203.0.113.0/24", "192.0.2.1", Tag)
+	rt.add("/ip/route", "203.0.113.0/24", "192.0.2.1", Tag)
+	s := newSteerer(t, rt)
+	if err := s.Install(context.Background(), plugin.SteerRoute{Prefix: pfx("203.0.113.0/24"), NextHop: netip.MustParseAddr("198.51.100.1")}); err != nil {
+		t.Fatal(err)
+	}
+	rows := rt.find("/ip/route", "203.0.113.0/24")
+	if len(rows) != 1 || rows[0]["gateway"] != "198.51.100.1" {
+		t.Fatalf("rows = %v, want one row on the new gateway", rows)
+	}
+}
+
+func TestInstallRefusesAHandWrittenRoute(t *testing.T) {
+	rt := newFakeRouterOS()
+	rt.add("/ip/route", "203.0.113.0/24", "192.0.2.1", "operator route")
+	s := newSteerer(t, rt)
+	err := s.Install(context.Background(), plugin.SteerRoute{Prefix: pfx("203.0.113.0/24"), NextHop: netip.MustParseAddr("198.51.100.1")})
+	if err == nil || !strings.Contains(err.Error(), "did not add") {
+		t.Fatalf("err = %v", err)
+	}
+	rows := rt.find("/ip/route", "203.0.113.0/24")
+	if len(rows) != 1 || rows[0]["gateway"] != "192.0.2.1" {
+		t.Fatalf("the operator's route was changed: %v", rows)
+	}
+	// Remove never deletes a route without the tag either.
+	if err := s.Remove(context.Background(), pfx("203.0.113.0/24")); err != nil {
+		t.Fatal(err)
+	}
+	if len(rt.find("/ip/route", "203.0.113.0/24")) != 1 {
+		t.Fatal("Remove deleted a route it does not own")
+	}
+}
+
+func TestOwnedListsOnlyTaggedRoutesOfBothFamilies(t *testing.T) {
+	rt := newFakeRouterOS()
+	rt.add("/ip/route", "198.51.100.0/24", "192.0.2.1", Tag)
+	rt.add("/ip/route", "0.0.0.0/0", "192.0.2.1", "")
+	rt.add("/ip/route", "203.0.113.0/24", "192.0.2.1", "someone else")
+	rt.add("/ipv6/route", "2001:db8:1::/48", "2001:db8:ffff::1", Tag)
+	got, err := newSteerer(t, rt).Owned(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got[0] != pfx("198.51.100.0/24") || got[1] != pfx("2001:db8:1::/48") {
+		t.Fatalf("owned = %v", got)
+	}
+}
+
+func TestRouterErrorsAreReportedWithoutTheLogin(t *testing.T) {
+	rt := newFakeRouterOS()
+	rt.failOn = "PUT"
+	err := newSteerer(t, rt).Install(context.Background(), plugin.SteerRoute{Prefix: pfx("198.51.100.0/24"), NextHop: netip.MustParseAddr("192.0.2.1")})
+	if err == nil || !strings.Contains(err.Error(), "400 Bad Request: Bad Request (failure to create route)") {
+		t.Fatalf("err = %v", err)
+	}
+	if strings.Contains(err.Error(), "lab-secret") {
+		t.Fatal("the password is in the error")
+	}
+	// A wrong login is a plain status error.
+	srv := httptest.NewServer(rt)
+	defer srv.Close()
+	s, err2 := New(func() plugin.Config {
+		var n yaml.Node
+		_ = yaml.Unmarshal([]byte("url: "+srv.URL+"\nusername_env: PK_USER\npassword_env: PK_PASS\n"), &n)
+		return plugin.NewConfig(n.Content[0])
+	}(), plugin.Env{Getenv: func(string) string { return "wrong" }})
+	if err2 != nil {
+		t.Fatal(err2)
+	}
+	if _, err := s.Owned(context.Background()); err == nil || !strings.Contains(err.Error(), "401") {
+		t.Fatalf("a wrong login: %v", err)
+	}
+}
+
+func TestConfigChecks(t *testing.T) {
+	env := plugin.Env{Getenv: func(string) string { return "x" }}
+	for name, y := range map[string]string{
+		"plain http to a router": "url: http://192.0.2.1\nusername_env: A\npassword_env: B\n",
+		"no scheme":              "url: 192.0.2.1\nusername_env: A\npassword_env: B\n",
+		"credentials in url":     "url: https://u:p@192.0.2.1\nusername_env: A\npassword_env: B\n",
+		"no login":               "url: https://192.0.2.1\n",
+		"one half of the login":  "url: https://192.0.2.1\nusername_env: A\n",
+		"bad env name":           "url: https://192.0.2.1\nusername_env: \"a b\"\npassword_env: B\n",
+		"ca file not absolute":   "url: https://192.0.2.1\nusername_env: A\npassword_env: B\nca_file: ca.pem\n",
+		"unknown key":            "url: https://192.0.2.1\nusername_env: A\npassword_env: B\ninsecure: true\n",
+	} {
+		var n yaml.Node
+		if err := yaml.Unmarshal([]byte(y), &n); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := New(plugin.NewConfig(n.Content[0]), env); err == nil {
+			t.Errorf("%s: accepted", name)
+		}
+	}
+	var n yaml.Node
+	_ = yaml.Unmarshal([]byte("url: https://192.0.2.1\nusername_env: A\npassword_env: B\n"), &n)
+	if _, err := New(plugin.NewConfig(n.Content[0]), plugin.Env{Getenv: func(string) string { return "" }}); err == nil {
+		t.Error("an unset login variable was accepted outside a config check")
+	}
+	if _, err := New(plugin.NewConfig(n.Content[0]), plugin.Env{Getenv: func(string) string { return "" }, CheckOnly: true}); err != nil {
+		t.Errorf("a config check needs no secrets: %v", err)
+	}
+	if !plugin.Steerers.Has(TypeName) {
+		t.Fatal("mikrotik is not registered as a steerer")
+	}
+}
