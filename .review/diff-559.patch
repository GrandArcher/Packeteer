@@ -0,0 +1,52 @@
+# Non-BGP mode lab (#300): a simulated Linux router with two links and no
+# BGP, and Packeteer in the router's network namespace driving its routes
+# with the linux steerer. Documentation addresses (RFC 5737) and a documentation
+# ASN only. Brought up by lab/e2e-nonbgp.sh, which sends synthetic NetFlow
+# v5 from the host to 192.0.2.10:2055 and reads the router's routes. The
+# router container holds the namespace, so routes outlive a killed Packeteer
+# as they would on a real router.
+name: packeteer-e2e-nonbgp
+services:
+  router:
+    build:
+      context: ..
+      dockerfile: Dockerfile
+      args:
+        VERSION: e2e
+    image: packeteer:e2e
+    hostname: router
+    # iproute2 for the script's checks: BusyBox ip does not filter by proto.
+    entrypoint: ["/bin/sh", "-c", "apk add --no-cache iproute2 >/dev/null && touch /tmp/ready && trap 'exit 0' TERM; while true; do sleep 1; done"]
+    networks:
+      isp-a:
+        ipv4_address: 192.0.2.10
+      isp-b:
+        ipv4_address: 198.51.100.10
+  packeteer:
+    image: packeteer:e2e
+    depends_on:
+      - router
+    network_mode: "service:router"
+    restart: "no"
+    cap_add:
+      - NET_RAW
+      - NET_ADMIN
+    environment:
+      PACKETEER_CONFIG: /etc/packeteer/config.yaml
+      PACKETEER_LOG_LEVEL: debug
+    volumes:
+      - ./packeteer-nonbgp.yaml:/etc/packeteer/config.yaml:ro
+      - ${PACKETEER_NONBGP_FIXED:?set by lab/e2e-nonbgp.sh}:/lab/fixed:ro
+networks:
+  isp-a:
+    driver: bridge
+    ipam:
+      config:
+        - subnet: 192.0.2.0/24
+          gateway: 192.0.2.3
+  isp-b:
+    driver: bridge
+    ipam:
+      config:
+        - subnet: 198.51.100.0/24
+          gateway: 198.51.100.3
diff --git a/lab/e2e-nonbgp.sh b/lab/e2e-nonbgp.sh
