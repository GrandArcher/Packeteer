+package nonbgp
+
+import (
+	"net/netip"
+	"time"
+)
+
+// SourceSynthetic labels a route learned from flow data. A route from a BGP
+// session never carries it.
+const SourceSynthetic = "synthetic"
+
+// Meta is the configuration shown beside the routes.
+type Meta struct {
+	Mode            string `json:"mode"`
+	InstallRoutes   bool   `json:"install_routes"`
+	DefaultProvider string `json:"default_provider"`
+	Steerer         string `json:"steerer,omitempty"`
+	Covering        string `json:"covering,omitempty"`
+	WidenBits       int    `json:"widen_bits"`
+	MaxBlocks       int    `json:"max_blocks"`
+}
+
+// RouteStatus is one synthetic prefix and, when it is steered, the static
+// route that carries it.
+type RouteStatus struct {
+	Source       string       `json:"source"`
+	Prefix       netip.Prefix `json:"prefix"`
+	Upper        netip.Prefix `json:"upper,omitzero"`
+	Origin       uint32       `json:"origin,omitempty"`
+	Blocks       int          `json:"blocks"`
+	LastSeen     time.Time    `json:"last_seen"`
+	SteeredTo    string       `json:"steered_to,omitempty"`
+	NextHop      netip.Addr   `json:"next_hop,omitzero"`
+	SteeredSince time.Time    `json:"steered_since,omitzero"`
+}
+
+// Status is /api/synthetic.
+type Status struct {
+	Meta
+	Blocks       int           `json:"tracked_blocks"`
+	Pending      int           `json:"pending_lookups"`
+	Dropped      uint64        `json:"dropped_blocks"`
+	LookupErrors uint64        `json:"lookup_errors"`
+	LastError    string        `json:"last_error,omitempty"`
+	Routes       []RouteStatus `json:"routes"`
+}
+
+// Report joins the table with the routes the steer controller has on the
+// router. steer may be nil.
+func Report(meta Meta, t *Table, s *Steer) Status {
+	st := t.Stats()
+	out := Status{Meta: meta, Blocks: st.Blocks, Pending: st.Pending, Dropped: st.Dropped,
+		LookupErrors: st.LookupErrors, LastError: st.LastError, Routes: []RouteStatus{}}
+	steered := map[netip.Prefix]Steered{}
+	for _, r := range s.Active() {
+		steered[r.Prefix] = r
+	}
+	for _, r := range t.Routes() {
+		row := RouteStatus{Source: SourceSynthetic, Prefix: r.Prefix, Upper: r.Upper, Origin: r.Origin, Blocks: r.Blocks, LastSeen: r.LastSeen}
+		if sr, ok := steered[r.Prefix]; ok {
+			row.SteeredTo, row.NextHop, row.SteeredSince = sr.Provider, sr.NextHop, sr.Since
+		}
+		out.Routes = append(out.Routes, row)
+	}
+	return out
+}
diff --git a/internal/nonbgp/steer.go b/internal/nonbgp/steer.go
new file mode 100644
index 00000000..25670aa7
--- /dev/null
+++ b/internal/nonbgp/steer.go
@@ -0,0 +1,293 @@
+package nonbgp
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"net/netip"
+	"sync"
+	"time"
+
+	"github.com/GrandArcher/Packeteer/internal/netpfx"
+	"github.com/GrandArcher/Packeteer/internal/policy"
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+// SteerConfig is what the Steer controller needs from the config.
+type SteerConfig struct {
+	// Inject is true only in mode inject. Observe and suggest never call
+	// the steerer.
+	Inject bool
+	// Allowlist holds the prefixes a route may fall inside.
+	Allowlist []netip.Prefix
+	// Max caps the routes on the router (max_improvements).
+	Max int
+	// NextHops maps a provider name to its gateway.
+	NextHops map[string]netip.Addr
+	// Live reports whether a prefix is still a synthetic prefix. A route
+	// for one that aged out is removed even if the decision engine still
+	// lists its improvement.
+	Live func(netip.Prefix) bool
+	// Now is the clock; nil is time.Now.
+	Now func() time.Time
+}
+
+// RouteTimeout bounds the router requests for one route: the listing, an
+// install, or a removal. It covers what one route takes: the mikrotik
+// steerer lists, deletes a duplicate tagged row, and patches, each with
+// its own 10s timeout. Only Packeteer adds tagged rows, so more than one
+// duplicate is not expected.
+const RouteTimeout = 30 * time.Second
+
+// Steered is one static route this process put on the router.
+type Steered struct {
+	Prefix   netip.Prefix
+	Provider string
+	NextHop  netip.Addr
+	Since    time.Time
+}
+
+// Steer turns improvements into static routes. It installs only inside the
+// allowlist and the cap, never a prefix more specific than the floor, and
+// it removes every route it installed when told to or when its
+// improvement ends. A nil *Steer does nothing.
+type Steer struct {
+	cfg SteerConfig
+	drv plugin.Steerer
+	log *slog.Logger
+
+	// mu serializes passes and is held through router I/O.
+	mu sync.Mutex
+	// amu also guards writes to active, so Active (the status API) does
+	// not wait for a pass on a slow router.
+	amu    sync.RWMutex
+	active map[netip.Prefix]Steered
+	// leftover holds tagged routes an earlier process left that could not
+	// be removed yet. They count against the cap until they are gone.
+	leftover map[netip.Prefix]struct{}
+	swept    bool
+}
+
+// NewSteer returns a controller that drives drv. drv may be nil in
+// observe and suggest, where nothing is installed.
+func NewSteer(cfg SteerConfig, drv plugin.Steerer, log *slog.Logger) (*Steer, error) {
+	if cfg.Inject {
+		if drv == nil {
+			return nil, errors.New("inject mode needs a steerer")
+		}
+		if len(cfg.Allowlist) == 0 {
+			return nil, errors.New("inject mode needs a non-empty allowlist")
+		}
+		if cfg.Live == nil {
+			return nil, errors.New("inject mode needs the synthetic table")
+		}
+	}
+	if cfg.Now == nil {
+		cfg.Now = time.Now
+	}
+	if log == nil {
+		log = slog.Default()
+	}
+	return &Steer{cfg: cfg, drv: drv, log: log, active: map[netip.Prefix]Steered{}, leftover: map[netip.Prefix]struct{}{}}, nil
+}
+
+// Sync makes the routes on the router match imps. The first sync removes
+// the tagged routes a previous process left behind; it runs in every mode
+// with a steerer, so a restart in observe also cleans up after a crash.
+// Observe and suggest install nothing. An improvement for a prefix that is
+// no longer in the table is skipped. Sync returns the failures; a route
+// whose removal failed stays tracked and is retried by the next sync.
+func (s *Steer) Sync(ctx context.Context, imps []policy.Improvement) error {
+	if s == nil || s.drv == nil {
+		return nil
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !s.swept {
+		if err := s.listLeftoversLocked(ctx); err != nil {
+			// The router's routes are unknown: nothing is installed on top of
+			// them this round, and the next sync lists again.
+			return err
+		}
+	}
+	errs := s.removeLeftoversLocked(ctx)
+	if !s.cfg.Inject {
+		return joinStopped(ctx, errs)
+	}
+	want := make(map[netip.Prefix]policy.Improvement, len(imps))
+	for _, im := range imps {
+		if p := im.Prefix.Masked(); s.cfg.Live(p) {
+			want[p] = im
+		}
+	}
+	for _, p := range netpfx.SortedKeys(s.active) {
+		if _, ok := want[p]; ok {
+			continue
+		}
+		if ctx.Err() != nil {
+			break
+		}
+		if err := s.removeLocked(ctx, p); err != nil {
+			errs = append(errs, err)
+		}
+	}
+	for _, p := range netpfx.SortedKeys(want) {
+		if ctx.Err() != nil {
+			break
+		}
+		if err := s.installLocked(ctx, want[p]); err != nil {
+			errs = append(errs, err)
+		}
+	}
+	return joinStopped(ctx, errs)
+}
+
+// joinStopped adds, once, that ctx ended the pass before every route was
+// tried, instead of one error per route left.
+func joinStopped(ctx context.Context, errs []error) error {
+	if err := ctx.Err(); err != nil {
+		errs = append(errs, fmt.Errorf("non-BGP: pass stopped: %w", err))
+	}
+	return errors.Join(errs...)
+}
+
+// removeLeftoversLocked tries every left-over route once more.
+func (s *Steer) removeLeftoversLocked(ctx context.Context) []error {
+	var errs []error
+	for _, p := range netpfx.SortedKeys(s.leftover) {
+		if ctx.Err() != nil {
+			break
+		}
+		if err := s.op(ctx, func(c context.Context) error { return s.drv.Remove(c, p) }); err != nil {
+			errs = append(errs, fmt.Errorf("non-BGP: remove left-over route %s: %w", p, err))
+			continue
+		}
+		delete(s.leftover, p)
+		s.log.Warn("non-BGP: removed a route left on the router by an earlier run", "prefix", p)
+	}
+	return errs
+}
+
+// op runs one route's router requests under their own deadline.
+// Cancelling ctx only ends a pass between routes, so a route is never cut
+// off halfway. A deadline on ctx (the shutdown budget) still bounds them.
+func (s *Steer) op(ctx context.Context, fn func(context.Context) error) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	end := time.Now().Add(RouteTimeout)
+	if d, ok := ctx.Deadline(); ok && d.Before(end) {
+		end = d
+	}
+	c, cancel := context.WithDeadline(context.WithoutCancel(ctx), end)
+	defer cancel()
+	return fn(c)
+}
+
+// listLeftoversLocked records every tagged route on the router: this
+// process owns none yet, so each one is left by an earlier run. They are
+// removed even when wanted; a wanted route is installed again afterwards,
+// which keeps every route on the router tracked.
+func (s *Steer) listLeftoversLocked(ctx context.Context) error {
+	var owned []netip.Prefix
+	err := s.op(ctx, func(c context.Context) error {
+		var err error
+		owned, err = s.drv.Owned(c)
+		return err
+	})
+	if err != nil {
+		return fmt.Errorf("non-BGP: list routes left on the router: %w", err)
+	}
+	for _, p := range owned {
+		s.leftover[p.Masked()] = struct{}{}
+	}
+	s.swept = true
+	return nil
+}
+
+func (s *Steer) installLocked(ctx context.Context, im policy.Improvement) error {
+	p := im.Prefix.Masked()
+	cur, on := s.active[p]
+	if on && cur.Provider == im.Provider {
+		return nil
+	}
+	_, stale := s.leftover[p]
+	floor := floorBits(p.Addr())
+	nh, known := s.cfg.NextHops[im.Provider]
+	switch {
+	case p.Bits() == 0 || p.Bits() > floor:
+		return fmt.Errorf("non-BGP: %s is more specific than /%d or a default route and is never steered", p, floor)
+	case !netpfx.CoveredBy(s.cfg.Allowlist, p):
+		return fmt.Errorf("non-BGP: %s is outside the allowlist", p)
+	case !known || nh.Is4() != p.Addr().Is4():
+		return fmt.Errorf("non-BGP: provider %q has no next hop for %s", im.Provider, p)
+	case !on && !stale && len(s.active)+len(s.leftover) >= s.cfg.Max:
+		return fmt.Errorf("non-BGP: %s refused, %d routes on the router is the max_improvements cap", p, s.cfg.Max)
+	}
+	if err := s.op(ctx, func(c context.Context) error { return s.drv.Install(c, plugin.SteerRoute{Prefix: p, NextHop: nh}) }); err != nil {
+		return fmt.Errorf("non-BGP: install %s via %s: %w", p, im.Provider, err)
+	}
+	// The install replaced the left-over route for p, so it is tracked now.
+	delete(s.leftover, p)
+	since := s.cfg.Now()
+	if on {
+		since = cur.Since
+	}
+	s.amu.Lock()
+	s.active[p] = Steered{Prefix: p, Provider: im.Provider, NextHop: nh, Since: since}
+	s.amu.Unlock()
+	s.log.Info("non-BGP: steered", "prefix", p, "provider", im.Provider, "next_hop", nh)
+	return nil
+}
+
+func (s *Steer) removeLocked(ctx context.Context, p netip.Prefix) error {
+	if err := s.op(ctx, func(c context.Context) error { return s.drv.Remove(c, p) }); err != nil {
+		return fmt.Errorf("non-BGP: remove %s: %w", p, err)
+	}
+	s.amu.Lock()
+	delete(s.active, p)
+	s.amu.Unlock()
+	s.log.Info("non-BGP: route removed", "prefix", p)
+	return nil
+}
+
+func (s *Steer) removeAllLocked(ctx context.Context) error {
+	var errs []error
+	errs = append(errs, s.removeLeftoversLocked(ctx)...)
+	for _, p := range netpfx.SortedKeys(s.active) {
+		if ctx.Err() != nil {
+			break
+		}
+		if err := s.removeLocked(ctx, p); err != nil {
+			errs = append(errs, err)
+		}
+	}
+	return joinStopped(ctx, errs)
+}
+
+// WithdrawAll removes every route this process installed, and tries the
+// left-over routes of an earlier run once more. It is called on shutdown.
+// It leaves alone a tagged route that appeared after the start-up sweep.
+func (s *Steer) WithdrawAll(ctx context.Context) error {
+	if s == nil {
+		return nil
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.removeAllLocked(ctx)
+}
+
+// Active lists the routes this process has on the router, in prefix order.
+func (s *Steer) Active() []Steered {
+	if s == nil {
+		return nil
+	}
+	s.amu.RLock()
+	defer s.amu.RUnlock()
+	out := make([]Steered, 0, len(s.active))
+	for _, p := range netpfx.SortedKeys(s.active) {
+		out = append(out, s.active[p])
+	}
+	return out
+}
diff --git a/internal/nonbgp/steer_test.go b/internal/nonbgp/steer_test.go
new file mode 100644
index 00000000..d224fcb2
--- /dev/null
+++ b/internal/nonbgp/steer_test.go
@@ -0,0 +1,515 @@
+package nonbgp
+
+import (
+	"context"
+	"errors"
+	"io"
+	"log/slog"
+	"net/netip"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/GrandArcher/Packeteer/internal/policy"
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+// fakeRouter is a router whose route table holds only tagged routes.
+type fakeRouter struct {
+	plugin.Base
+	mu         sync.Mutex
+	routes     map[netip.Prefix]netip.Addr
+	installs   int
+	removes    int
+	listErr    error
+	removeErr  error
+	installErr error
+	// removeFail fails the removal of this one prefix.
+	removeFail netip.Prefix
+	onInstall  func(context.Context)
+}
+
+func newFakeRouter() *fakeRouter {
+	return &fakeRouter{routes: map[netip.Prefix]netip.Addr{}}
+}
+
+func (f *fakeRouter) Install(ctx context.Context, r plugin.SteerRoute) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.onInstall != nil {
+		f.onInstall(ctx)
+	}
+	if f.installErr != nil {
+		return f.installErr
+	}
+	f.installs++
+	f.routes[r.Prefix] = r.NextHop
+	return nil
+}
+
+func (f *fakeRouter) Remove(_ context.Context, p netip.Prefix) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.removeErr != nil {
+		return f.removeErr
+	}
+	if p == f.removeFail {
+		return errors.New("route is locked")
+	}
+	f.removes++
+	delete(f.routes, p)
+	return nil
+}
+
+func (f *fakeRouter) Owned(context.Context) ([]netip.Prefix, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.listErr != nil {
+		return nil, f.listErr
+	}
+	var out []netip.Prefix
+	for p := range f.routes {
+		out = append(out, p)
+	}
+	return out, nil
+}
+
+func (f *fakeRouter) has(p string) (netip.Addr, bool) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	nh, ok := f.routes[pfx(p)]
+	return nh, ok
+}
+
+func (f *fakeRouter) set(fn func()) {
+	f.mu.Lock()
+	fn()
+	f.mu.Unlock()
+}
+
+type steerRig struct {
+	r    *fakeRouter
+	s    *Steer
+	live map[netip.Prefix]bool
+}
+
+func newRig(t *testing.T, inject bool, max int) *steerRig {
+	t.Helper()
+	rig := &steerRig{r: newFakeRouter(), live: map[netip.Prefix]bool{}}
+	for _, p := range []string{"192.0.2.0/24", "198.51.100.0/24", "203.0.113.0/24", "2001:db8:1::/48", "2001:db8::/46", "198.51.100.0/25", "0.0.0.0/0"} {
+		rig.live[pfx(p)] = true
+	}
+	cfg := SteerConfig{
+		Inject:    inject,
+		Allowlist: []netip.Prefix{pfx("198.51.100.0/24"), pfx("203.0.113.0/24"), pfx("2001:db8::/32")},
+		Max:       max,
+		NextHops:  map[string]netip.Addr{"isp-a": addr("192.0.2.1"), "isp-b": addr("198.51.100.1"), "isp-b6": addr("2001:db8:ffff::1")},
+		Live:      func(p netip.Prefix) bool { return rig.live[p] },
+		Now:       func() time.Time { return time.Date(2026, 11, 9, 12, 0, 0, 0, time.UTC) },
+	}
+	var drv plugin.Steerer = rig.r
+	s, err := NewSteer(cfg, drv, slog.New(slog.NewTextHandler(io.Discard, nil)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	rig.s = s
+	return rig
+}
+
+func imp(p, provider string) policy.Improvement {
+	return policy.Improvement{Prefix: pfx(p), Provider: provider, Native: "isp-a"}
+}
+
+func TestObserveInstallsNothingButSweepsLeftOvers(t *testing.T) {
+	rig := newRig(t, false, 5)
+	// A killed inject run left a route; the restart is in observe.
+	rig.r.set(func() { rig.r.routes[pfx("203.0.113.0/24")] = addr("198.51.100.1") })
+	if err := rig.s.Sync(context.Background(), []policy.Improvement{imp("198.51.100.0/24", "isp-b")}); err != nil {
+		t.Fatal(err)
+	}
+	if rig.r.installs != 0 || len(rig.s.Active()) != 0 {
+		t.Fatalf("observe installed %d routes, tracked %d", rig.r.installs, len(rig.s.Active()))
+	}
+	if _, ok := rig.r.has("203.0.113.0/24"); ok {
+		t.Fatal("observe left the route a killed run installed")
+	}
+	rig.r.set(func() { rig.r.listErr = errors.New("must not be asked") })
+	if err := rig.s.Sync(context.Background(), nil); err != nil {
+		t.Fatalf("observe listed the router again after the sweep: %v", err)
+	}
+	var none *Steer
+	if err := none.Sync(context.Background(), nil); err != nil || none.WithdrawAll(context.Background()) != nil || len(none.Active()) != 0 || none.Active() != nil {
+		t.Fatal("a nil Steer is not inert")
+	}
+}
+
+func TestInstallKeepSwitchAndRemove(t *testing.T) {
+	rig := newRig(t, true, 5)
+	ctx := context.Background()
+	if err := rig.s.Sync(ctx, []policy.Improvement{imp("198.51.100.0/24", "isp-b")}); err != nil {
+		t.Fatal(err)
+	}
+	if nh, ok := rig.r.has("198.51.100.0/24"); !ok || nh != addr("198.51.100.1") {
+		t.Fatalf("route = %s %v, want via the provider's gateway", nh, ok)
+	}
+	act := rig.s.Active()
+	if len(act) != 1 || act[0].Provider != "isp-b" || act[0].NextHop != addr("198.51.100.1") {
+		t.Fatalf("active = %+v", act)
+	}
+	since := act[0].Since
+
+	// The same improvement again does not touch the router.
+	if err := rig.s.Sync(ctx, []policy.Improvement{imp("198.51.100.0/24", "isp-b")}); err != nil || rig.r.installs != 1 {
+		t.Fatalf("keep: err %v installs %d", err, rig.r.installs)
+	}
+	// A switch to another provider replaces the route and keeps its age.
+	if err := rig.s.Sync(ctx, []policy.Improvement{imp("198.51.100.0/24", "isp-a")}); err != nil {
+		t.Fatal(err)
+	}
+	if nh, _ := rig.r.has("198.51.100.0/24"); nh != addr("192.0.2.1") || rig.r.installs != 2 {
+		t.Fatalf("switch: next hop %s installs %d", nh, rig.r.installs)
+	}
+	if got := rig.s.Active()[0]; !got.Since.Equal(since) || got.Provider != "isp-a" {
+		t.Fatalf("switch lost the route's age: %+v", got)
+	}
+	// The improvement ends: the route goes, the default route carries the prefix again.
+	if err := rig.s.Sync(ctx, nil); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := rig.r.has("198.51.100.0/24"); ok || len(rig.s.Active()) != 0 {
+		t.Fatal("the route stayed after its improvement ended")
+	}
+}
+
+func TestInstallRefusals(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		im   policy.Improvement
+		want string
+	}{
+		{"outside the allowlist", imp("192.0.2.0/24", "isp-b"), "outside the allowlist"},
+		{"more specific than the floor", imp("198.51.100.0/25", "isp-b"), "never steered"},
+		{"default route", imp("0.0.0.0/0", "isp-b"), "never steered"},
+		{"unknown provider", imp("198.51.100.0/24", "isp-c"), "no next hop"},
+		{"family mismatch", imp("2001:db8:1::/48", "isp-b"), "no next hop"},
+	} {
+		rig := newRig(t, true, 5)
+		err := rig.s.Sync(context.Background(), []policy.Improvement{tc.im})
+		if err == nil || !strings.Contains(err.Error(), tc.want) {
+			t.Errorf("%s: err %v, want %q", tc.name, err, tc.want)
+		}
+		if rig.r.installs != 0 {
+			t.Errorf("%s: the router was changed", tc.name)
+		}
+	}
+	// An improvement whose prefix left the table is skipped without an
+	// error, every round, until the decision engine retires it.
+	rig := newRig(t, true, 5)
+	rig.live[pfx("203.0.113.0/24")] = false
+	for range 2 {
+		if err := rig.s.Sync(context.Background(), []policy.Improvement{imp("203.0.113.0/24", "isp-b")}); err != nil || rig.r.installs != 0 {
+			t.Fatalf("a prefix that is not live: err %v installs %d", err, rig.r.installs)
+		}
+	}
+}
+
+func TestIPv6RouteUsesIPv6Gateway(t *testing.T) {
+	rig := newRig(t, true, 5)
+	if err := rig.s.Sync(context.Background(), []policy.Improvement{imp("2001:db8:1::/48", "isp-b6")}); err != nil {
+		t.Fatal(err)
+	}
+	if nh, ok := rig.r.has("2001:db8:1::/48"); !ok || nh != addr("2001:db8:ffff::1") {
+		t.Fatalf("v6 route = %s %v", nh, ok)
