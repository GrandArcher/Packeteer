+# Release upgrade lab (#644): one simulated FRR edge and one Packeteer
+# container whose image lab/e2e-upgrade-release.sh swaps between the last
+# published release (pinned by digest) and the build from this tree, on the
+# same packeteer-data volume. Documentation addresses (RFC 5737) and the
+# private ASN 64512 only. Observe mode: the edge must never receive a route.
+name: packeteer-e2e-upgrade-release
+services:
+  edge:
+    image: quay.io/frrouting/frr:10.2.4
+    hostname: edge
+    privileged: true
+    entrypoint: ["/bin/sh", "/etc/frr/start.sh"]
+    volumes:
+      - ./frr:/etc/frr
+    networks:
+      lab:
+        ipv4_address: 192.0.2.254
+  packeteer:
+    image: ${PK_IMAGE:?PK_IMAGE is set by lab/e2e-upgrade-release.sh}
+    depends_on:
+      - edge
+    cap_add:
+      - NET_RAW
+      - NET_ADMIN
+      - NET_BIND_SERVICE
+    environment:
+      PACKETEER_CONFIG: /etc/packeteer/config.yaml
+      PACKETEER_LOG_LEVEL: debug
+      # Lab-only first admin; it is used only while no user has that name.
+      PACKETEER_ADMIN_PASSWORD: lab-only-upgrade-admin
+    volumes:
+      - ${PK_CONFIG:?PK_CONFIG is set by lab/e2e-upgrade-release.sh}:/etc/packeteer/config.yaml:ro
+      - ./probes:/etc/packeteer/probes:ro
+      - packeteer-data:/var/lib/packeteer
+    networks:
+      lab:
+        ipv4_address: 192.0.2.10
+volumes:
+  packeteer-data:
+networks:
+  lab:
+    driver: bridge
+    ipam:
+      config:
+        - subnet: 192.0.2.0/24
+          gateway: 192.0.2.3
diff --git a/lab/e2e-upgrade-release.sh b/lab/e2e-upgrade-release.sh
