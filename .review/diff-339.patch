diff --git a/internal/plugins/ixprouteserver/birdseye/client.go b/internal/plugins/ixprouteserver/birdseye/client.go
new file mode 100644
index 0000000..4eb2fa8
--- /dev/null
+++ b/internal/plugins/ixprouteserver/birdseye/client.go
@@ -0,0 +1,204 @@
+package birdseye
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"sort"
+	"strings"
+)
+
+// reasonCommunity is the middle part of IXP Manager's filter tag
+// rs-asn:1101:x. The route server keeps a tagged route and does not
+// export it.
+const reasonCommunity = 1101
+
+// The only Birdseye paths this plugin requests, all with GET.
+const (
+	pathStatus    = "/api/status"
+	pathProtocols = "/api/protocols/bgp"
+)
+
+func pathCount(protocol string) string {
+	return "/api/routes/count/protocol/" + url.PathEscape(protocol)
+}
+
+func pathFiltered(protocol string, asn uint32) string {
+	return fmt.Sprintf("/api/routes/lc-zwild/protocol/%s/%d/%d", url.PathEscape(protocol), asn, reasonCommunity)
+}
+
+// get fetches base+path with GET and decodes the JSON body into dst. The
+// body is capped at maxBytes; a larger body is an error, not a partial read.
+func (w *Watch) get(ctx context.Context, base, path string, dst any) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, base+path, nil)
+	if err != nil {
+		return errors.New("bad url")
+	}
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("User-Agent", "packeteer")
+	resp, err := w.http.Do(req)
+	if err != nil {
+		if errors.Is(err, errNoRedirect) {
+			return errors.New("redirects are not followed")
+		}
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		return errors.New("request failed")
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, w.maxBytes+1))
+	if err != nil {
+		return errors.New("read failed")
+	}
+	if int64(len(body)) > w.maxBytes {
+		return fmt.Errorf("response larger than %d bytes", w.maxBytes)
+	}
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("HTTP %d", resp.StatusCode)
+	}
+	if err := json.Unmarshal(body, dst); err != nil {
+		return errors.New("response is not the expected JSON")
+	}
+	return nil
+}
+
+type statusDoc struct {
+	API struct {
+		MaxRoutes int `json:"max_routes"`
+	} `json:"api"`
+	Status struct {
+		Version    string `json:"version"`
+		RouterID   string `json:"router_id"`
+		LastReconf string `json:"last_reconfig"`
+		Message    string `json:"message"`
+	} `json:"status"`
+}
+
+// protocol is one BGP protocol from api/protocols/bgp. Birdseye's name key
+// is the BIRD protocol name.
+type protocol struct {
+	Name            string
+	State           string `json:"state"`
+	Connection      string `json:"connection"`
+	BGPState        string `json:"bgp_state"`
+	NeighborAddress string `json:"neighbor_address"`
+	NeighborAS      uint32 `json:"neighbor_as"`
+	Description     string `json:"description"`
+	ImportLimit     int    `json:"import_limit"`
+}
+
+// established is true when BIRD reports the BGP state Established.
+func (p protocol) established() bool {
+	if p.BGPState != "" {
+		return strings.EqualFold(p.BGPState, "Established")
+	}
+	return strings.HasPrefix(strings.ToLower(p.Connection), "established")
+}
+
+// stateText is the BGP state, else BIRD's protocol state.
+func (p protocol) stateText() string {
+	if p.BGPState != "" {
+		return p.BGPState
+	}
+	if f := strings.Fields(p.Connection); len(f) > 0 {
+		return f[0]
+	}
+	return p.State
+}
+
+// decodeProtocols decodes api/protocols/bgp, sorted by name. PHP encodes an
+// empty array as [], which is no protocols.
+func decodeProtocols(raw json.RawMessage) ([]protocol, error) {
+	if len(raw) == 0 || string(raw) == "[]" || string(raw) == "null" {
+		return nil, nil
+	}
+	var m map[string]protocol
+	if err := json.Unmarshal(raw, &m); err != nil {
+		return nil, errors.New("protocols are not the expected JSON")
+	}
+	out := make([]protocol, 0, len(m))
+	for name, p := range m {
+		p.Name = name
+		out = append(out, p)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })
+	return out, nil
+}
+
+func (w *Watch) protocols(ctx context.Context, base string) ([]protocol, error) {
+	var doc struct {
+		Protocols json.RawMessage `json:"protocols"`
+	}
+	if err := w.get(ctx, base, pathProtocols, &doc); err != nil {
+		return nil, err
+	}
+	return decodeProtocols(doc.Protocols)
+}
+
+func (w *Watch) status(ctx context.Context, base string) (statusDoc, error) {
+	var doc statusDoc
+	err := w.get(ctx, base, pathStatus, &doc)
+	return doc, err
+}
+
+// routeCount reads the route count of one protocol.
+func (w *Watch) routeCount(ctx context.Context, base, protocol string) (int, error) {
+	var doc struct {
+		Count struct {
+			Routes *int `json:"routes"`
+		} `json:"count"`
+	}
+	if err := w.get(ctx, base, pathCount(protocol), &doc); err != nil {
+		return 0, err
+	}
+	if doc.Count.Routes == nil || *doc.Count.Routes < 0 {
+		return 0, errors.New("route count is missing")
+	}
+	return *doc.Count.Routes, nil
+}
+
+// filtered reads the routes of one protocol that carry rs-asn:1101:x. It
+// returns the number of routes with at least one such tag and the count of
+// each x. Birdseye caps a route listing at its api.max_routes (maxRoutes,
+// zero when it did not say). A listing that reaches the cap may be cut
+// short, so it is an error rather than an undercount.
+func (w *Watch) filtered(ctx context.Context, base, protocol string, asn uint32, maxRoutes int) (int, map[int]int, error) {
+	var doc struct {
+		Routes []struct {
+			BGP struct {
+				Large [][3]uint64 `json:"large_communities"`
+			} `json:"bgp"`
+		} `json:"routes"`
+	}
+	if err := w.get(ctx, base, pathFiltered(protocol, asn), &doc); err != nil {
+		return 0, nil, err
+	}
+	if maxRoutes > 0 && len(doc.Routes) >= maxRoutes {
+		return 0, nil, fmt.Errorf("route listing reached Birdseye api.max_routes (%d)", maxRoutes)
+	}
+	routes := 0
+	reasons := map[int]int{}
+	for _, r := range doc.Routes {
+		tagged := false
+		seen := map[uint64]bool{}
+		for _, c := range r.BGP.Large {
+			if c[0] != uint64(asn) || c[1] != reasonCommunity || seen[c[2]] {
+				continue
+			}
+			seen[c[2]] = true
+			tagged = true
+			if _, ok := reasons[int(c[2])]; ok || len(reasons) < maxReasons {
+				reasons[int(c[2])]++
+			}
+		}
+		if tagged {
+			routes++
+		}
+	}
+	return routes, reasons, nil
+}
diff --git a/internal/plugins/ixprouteserver/birdseye/plugin.go b/internal/plugins/ixprouteserver/birdseye/plugin.go
new file mode 100644
index 0000000..c4e0ed2
--- /dev/null
+++ b/internal/plugins/ixprouteserver/birdseye/plugin.go
@@ -0,0 +1,295 @@
+// Package birdseye is the ixp.routeservers plugin (#164). It polls
+// Birdseye on each route server with GET only, keeps a short per-session
+// history, and emits events when a route server, a member session, a
+// max_prefix share, or a filtered share changes. It does not announce, it
+// does not write the RIB view, and it is not an input to Decide.
+package birdseye
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"net/http"
+	"net/url"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+// TypeName is the config type.
+const TypeName = "birdseye"
+
+// Defaults and bounds. A zero value in config selects the default.
+const (
+	DefaultInterval         = 5 * time.Minute
+	minInterval             = time.Minute
+	maxInterval             = time.Hour
+	DefaultTimeout          = 15 * time.Second
+	minTimeout              = time.Second
+	maxTimeout              = 2 * time.Minute
+	DefaultWorkers          = 4
+	maxWorkers              = 8
+	DefaultMaxBytes         = 8 << 20
+	minMaxBytes             = 1024
+	maxMaxBytes             = 32 << 20
+	DefaultMaxPrefixWarnPct = 90
+	DefaultFilteredWarnPct  = 50
+
+	// maxServers and maxSessions bound the live sessions. A session keeps
+	// maxSamples samples of 56 bytes plus up to maxReasons reason counts
+	// each, and the history of a session that left stays for the whole
+	// window, so churn can hold more than maxSessions histories per server.
+	maxServers  = 8
+	maxSessions = 2048
+	maxSamples  = 288
+	// maxReasons bounds the distinct rs-asn:1101:x values kept per session.
+	maxReasons = 64
+
+	// staleFactor intervals without a successful poll drop a server's
+	// sessions from the view.
+	staleFactor = 3
+	// failsBeforeAlert consecutive failed polls raise ixp.rs_unreachable.
+	failsBeforeAlert = 2
+)
+
+// errNoRedirect refuses every redirect, so a poll never leaves the
+// configured host.
+var errNoRedirect = errors.New("redirects are not followed")
+
+// ServerConfig is one route server.
+type ServerConfig struct {
+	Name string `yaml:"name"`
+	URL  string `yaml:"url"`
+	ASN  uint32 `yaml:"asn"`
+}
+
+// Config is the birdseye plugin's config block.
+type Config struct {
+	Servers          []ServerConfig `yaml:"servers"`
+	Interval         time.Duration  `yaml:"interval"`
+	Timeout          time.Duration  `yaml:"timeout"`
+	Workers          int            `yaml:"workers"`
+	MaxBytes         int            `yaml:"max_bytes"`
+	MaxPrefixWarnPct int            `yaml:"max_prefix_warn_pct"`
+	FilteredWarnPct  int            `yaml:"filtered_warn_pct"`
+}
+
+func init() { plugin.RouteServerWatches.Register(TypeName, New) }
+
+// The controller stores the watch as a RouteServerWatch.
+var _ plugin.RouteServerWatch = (*Watch)(nil)
+
+// Watch is the birdseye route-server watch.
+type Watch struct {
+	log      *slog.Logger
+	interval time.Duration
+	workers  int
+	maxBytes int64
+	prefPct  int
+	filtPct  int
+	http     *http.Client
+	servers  []*server
+
+	mu      sync.Mutex
+	members func() plugin.MemberView
+	sink    func(plugin.Event)
+	cancel  context.CancelFunc
+	done    chan struct{}
+}
+
+// New validates the config. It does not dial.
+func New(c plugin.Config, env plugin.Env) (plugin.RouteServerWatch, error) {
+	var cfg Config
+	if err := c.Decode(&cfg); err != nil {
+		return nil, err
+	}
+	if err := applyDefaults(&cfg); err != nil {
+		return nil, err
+	}
+	servers, err := buildServers(cfg.Servers)
+	if err != nil {
+		return nil, err
+	}
+	log := env.Logger
+	if log == nil {
+		log = slog.New(slog.DiscardHandler)
+	}
+	return &Watch{
+		log:      log,
+		interval: cfg.Interval,
+		workers:  cfg.Workers,
+		maxBytes: int64(cfg.MaxBytes),
+		prefPct:  cfg.MaxPrefixWarnPct,
+		filtPct:  cfg.FilteredWarnPct,
+		servers:  servers,
+		http: &http.Client{
+			Timeout: cfg.Timeout,
+			CheckRedirect: func(*http.Request, []*http.Request) error {
+				return errNoRedirect
+			},
+		},
+	}, nil
+}
+
+func applyDefaults(cfg *Config) error {
+	if cfg.Interval == 0 {
+		cfg.Interval = DefaultInterval
+	}
+	if cfg.Interval < minInterval || cfg.Interval > maxInterval {
+		return fmt.Errorf("interval %s must be between %s and %s", cfg.Interval, minInterval, maxInterval)
+	}
+	if cfg.Timeout == 0 {
+		cfg.Timeout = DefaultTimeout
+	}
+	if cfg.Timeout < minTimeout || cfg.Timeout > maxTimeout {
+		return fmt.Errorf("timeout %s must be between %s and %s", cfg.Timeout, minTimeout, maxTimeout)
+	}
+	if cfg.Workers == 0 {
+		cfg.Workers = DefaultWorkers
+	}
+	if cfg.Workers < 1 || cfg.Workers > maxWorkers {
+		return fmt.Errorf("workers %d must be between 1 and %d", cfg.Workers, maxWorkers)
+	}
+	if cfg.MaxBytes == 0 {
+		cfg.MaxBytes = DefaultMaxBytes
+	}
+	if cfg.MaxBytes < minMaxBytes || cfg.MaxBytes > maxMaxBytes {
+		return fmt.Errorf("max_bytes %d must be between %d and %d", cfg.MaxBytes, minMaxBytes, maxMaxBytes)
+	}
+	if cfg.MaxPrefixWarnPct == 0 {
+		cfg.MaxPrefixWarnPct = DefaultMaxPrefixWarnPct
+	}
+	if cfg.MaxPrefixWarnPct < 1 || cfg.MaxPrefixWarnPct > 100 {
+		return fmt.Errorf("max_prefix_warn_pct %d must be between 1 and 100", cfg.MaxPrefixWarnPct)
+	}
+	if cfg.FilteredWarnPct == 0 {
+		cfg.FilteredWarnPct = DefaultFilteredWarnPct
+	}
+	if cfg.FilteredWarnPct < 1 || cfg.FilteredWarnPct > 100 {
+		return fmt.Errorf("filtered_warn_pct %d must be between 1 and 100", cfg.FilteredWarnPct)
+	}
+	return nil
+}
+
+func buildServers(in []ServerConfig) ([]*server, error) {
+	if len(in) == 0 {
+		return nil, errors.New("servers is required")
+	}
+	if len(in) > maxServers {
+		return nil, fmt.Errorf("servers: more than %d", maxServers)
+	}
+	seen := map[string]bool{}
+	out := make([]*server, 0, len(in))
+	for i, sc := range in {
+		p := fmt.Sprintf("servers[%d]", i)
+		if !validName(sc.Name) {
+			return nil, fmt.Errorf("%s.name is invalid", p)
+		}
+		if seen[sc.Name] {
+			return nil, fmt.Errorf("%s.name %q is duplicated", p, sc.Name)
+		}
+		seen[sc.Name] = true
+		if sc.ASN == 0 {
+			return nil, fmt.Errorf("%s.asn is required", p)
+		}
+		base, err := baseURL(sc.URL)
+		if err != nil {
+			return nil, fmt.Errorf("%s.url: %w", p, err)
+		}
+		out = append(out, newServer(sc, base))
+	}
+	return out, nil
+}
+
+// baseURL accepts an http or https origin, or a subdirectory install. The
+// query and userinfo are refused: Birdseye is read without a key, and the
+// IXP Manager API key is never sent to it.
+func baseURL(raw string) (string, error) {
+	u, err := url.Parse(strings.TrimSpace(raw))
+	if err != nil || (u.Scheme != "http" && u.Scheme != "https") || u.Host == "" || u.User != nil || u.Fragment != "" || u.RawQuery != "" || u.ForceQuery {
+		return "", errors.New("must be an http or https URL with a host and no userinfo, query, or fragment")
+	}
+	u.Path = strings.TrimRight(u.Path, "/")
+	u.RawPath = ""
+	return u.String(), nil
+}
+
+// validName allows a letter or digit, then letters, digits, '.', '_' or
+// '-', at most 64 characters. A name is a URL-safe label in events.
+func validName(s string) bool {
+	if s == "" || len(s) > 64 {
+		return false
+	}
+	for i, c := range s {
+		switch {
+		case c >= 'a' && c <= 'z', c >= 'A' && c <= 'Z', c >= '0' && c <= '9':
+		case i > 0 && (c == '.' || c == '_' || c == '-'):
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+// SetMembers records the IX-F view. The controller calls it before Start.
+func (w *Watch) SetMembers(fn func() plugin.MemberView) {
+	w.mu.Lock()
+	w.members = fn
+	w.mu.Unlock()
+}
+
+// SetEventSink records where events go. The controller calls it before Start.
+func (w *Watch) SetEventSink(fn func(plugin.Event)) {
+	w.mu.Lock()
+	w.sink = fn
+	w.mu.Unlock()
+}
+
+// Start polls once, then on each interval. It does not block.
+func (w *Watch) Start(ctx context.Context) error {
+	ctx, cancel := context.WithCancel(ctx)
+	done := make(chan struct{})
+	w.mu.Lock()
+	w.cancel = cancel
+	w.done = done
+	w.mu.Unlock()
+	go w.loop(ctx, done)
+	return nil
+}
+
+func (w *Watch) loop(ctx context.Context, done chan struct{}) {
+	defer close(done)
+	w.round(ctx, time.Now())
+	t := time.NewTicker(w.interval)
+	defer t.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case now := <-t.C:
+			w.round(ctx, now)
+		}
+	}
+}
+
+// Stop cancels the loop and waits for it to leave.
+func (w *Watch) Stop(ctx context.Context) error {
+	w.mu.Lock()
+	cancel, done := w.cancel, w.done
+	w.mu.Unlock()
+	if cancel != nil {
+		cancel()
+	}
+	if done == nil {
+		return nil
+	}
+	select {
+	case <-done:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
diff --git a/internal/plugins/ixprouteserver/birdseye/poll.go b/internal/plugins/ixprouteserver/birdseye/poll.go
new file mode 100644
index 0000000..f3e84f0
--- /dev/null
+++ b/internal/plugins/ixprouteserver/birdseye/poll.go
@@ -0,0 +1,499 @@
+package birdseye
+
+import (
+	"context"
+	"fmt"
+	"net/netip"
+	"sort"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+type server struct {
+	cfg  ServerConfig
+	base string
+
+	status      plugin.RouteServerStatus
+	lastOK      time.Time
+	fails       int
+	unreachable bool
+	sessions    map[string]*sess
+	history     map[string][]sample
+}
+
+func newServer(cfg ServerConfig, base string) *server {
+	return &server{
+		cfg:      cfg,
+		base:     base,
+		status:   plugin.RouteServerStatus{Name: cfg.Name, URL: base, ASN: cfg.ASN},
+		sessions: map[string]*sess{},
+		history:  map[string][]sample{},
+	}
+}
+
+// sess is a session's latest row and the alerts open on it.
+type sess struct {
+	view         plugin.RouteServerSession
+	down         bool
+	prefixHigh   bool
+	filteredHigh bool
+}
+
+const (
+	flagEstablished = 1 << iota
+	flagCounted
+)
+
+// sample is a compact history point; a session keeps maxSamples of them.
+type sample struct {
+	at       int64
+	flags    uint8
+	received int32
+	accepted int32
+	filtered int32
+	max      int32
+	reasons  []plugin.RouteServerReason
+}
+
+func (s sample) public() plugin.RouteServerSample {
+	r := s.reasons
+	if r == nil {
+		r = []plugin.RouteServerReason{}
+	}
+	return plugin.RouteServerSample{
+		At:          time.Unix(s.at, 0).UTC(),
+		Established: s.flags&flagEstablished != 0,
+		Counted:     s.flags&flagCounted != 0,
+		Received:    int(s.received),
+		Accepted:    int(s.accepted),
+		Filtered:    int(s.filtered),
+		Reasons:     append([]plugin.RouteServerReason{}, r...),
+		MaxPrefix:   int(s.max),
+	}
+}
+
+// member is what the IX-F list says about one LAN address.
+type member struct {
+	asn       uint32
+	name      string
+	maxPrefix int
+}
+
+func (w *Watch) memberIndex() map[netip.Addr]member {
+	w.mu.Lock()
+	fn := w.members
+	w.mu.Unlock()
+	out := map[netip.Addr]member{}
+	if fn == nil {
+		return out
+	}
+	for _, m := range fn().Members {
+		for _, c := range m.Connections {
+			for _, a := range c.Addresses {
+				if addr, err := netip.ParseAddr(a.Address); err == nil {
+					out[addr.Unmap()] = member{asn: m.ASN, name: m.Name, maxPrefix: a.MaxPrefix}
+				}
+			}
+		}
+	}
+	return out
+}
+
+// round polls every server once. Servers go one after another; the
+// sessions of one server go through a bounded worker pool.
+func (w *Watch) round(ctx context.Context, now time.Time) {
+	members := w.memberIndex()
+	for _, s := range w.servers {
+		if ctx.Err() != nil {
+			return
+		}
+		w.pollServer(ctx, s, members, now)
+	}
+}
+
+func (w *Watch) pollServer(ctx context.Context, s *server, members map[netip.Addr]member, now time.Time) {
+	st, err := w.status(ctx, s.base)
+	var protos []protocol
+	if err == nil {
+		protos, err = w.protocols(ctx, s.base)
+	}
+	if err == nil && len(protos) > maxSessions {
+		err = fmt.Errorf("more than %d sessions", maxSessions)
+	}
+	if ctx.Err() != nil {
+		return
+	}
+	if err != nil {
+		w.fail(s, now, err)
+		return
+	}
+	rows := make([]plugin.RouteServerSession, len(protos))
+	idx := make(chan int)
+	var wg sync.WaitGroup
+	for i := 0; i < w.workers; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := range idx {
+				rows[i] = w.measure(ctx, s, protos[i], members, st.API.MaxRoutes, now)
+			}
+		}()
+	}
+	for i := range protos {
+		idx <- i
+	}
+	close(idx)
+	wg.Wait()
+	if ctx.Err() != nil {
+		return
+	}
+	w.apply(s, st, rows, now)
+}
+
+// validProtocol keeps a name from Birdseye usable as one URL segment.
+func validProtocol(s string) bool {
+	if s == "" || len(s) > 64 {
+		return false
+	}
+	for _, c := range s {
+		switch {
+		case c >= 'a' && c <= 'z', c >= 'A' && c <= 'Z', c >= '0' && c <= '9', c == '_', c == '.', c == '-':
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+// measure builds one session's row. A session that is not Established has
+// no routes, so its counts are zero without asking Birdseye. A failed read
+// leaves Counted false with the counts zero and records the error.
+func (w *Watch) measure(ctx context.Context, s *server, p protocol, members map[netip.Addr]member, maxRoutes int, now time.Time) plugin.RouteServerSession {
+	v := plugin.RouteServerSession{
+		Server:      s.cfg.Name,
+		Session:     p.Name,
+		ASN:         p.NeighborAS,
+		Description: p.Description,
+		State:       p.stateText(),
+		Established: p.established(),
+		Reasons:     []plugin.RouteServerReason{},
+		MaxPrefix:   p.ImportLimit,
+		At:          now,
+	}
+	if addr, err := netip.ParseAddr(p.NeighborAddress); err == nil {
+		addr = addr.Unmap()
+		v.Neighbor = addr.String()
+		if m, ok := members[addr]; ok {
+			v.Name = m.name
+			if v.ASN == 0 {
+				v.ASN = m.asn
+			}
+			if m.maxPrefix > 0 {
+				v.MaxPrefix = m.maxPrefix
+			}
+		}
+	}
+	if !validProtocol(p.Name) {
+		v.Error = "session name is not usable in a URL"
+		return v
+	}
+	if !v.Established {
+		v.Counted = true
+		return v
+	}
+	received, err := w.routeCount(ctx, s.base, p.Name)
+	if err != nil {
+		v.Error = err.Error()
+		return v
+	}
+	var filtered int
+	var reasons map[int]int
+	if received > 0 {
+		filtered, reasons, err = w.filtered(ctx, s.base, p.Name, s.cfg.ASN, maxRoutes)
+		if err != nil {
+			v.Error = err.Error()
+			return v
+		}
+	}
+	v.Counted = true
+	v.Received = received
+	v.Filtered = filtered
+	v.Accepted = max(received-filtered, 0)
+	for r, n := range reasons {
+		v.Reasons = append(v.Reasons, plugin.RouteServerReason{Reason: r, Count: n})
+	}
+	sort.Slice(v.Reasons, func(i, j int) bool { return v.Reasons[i].Reason < v.Reasons[j].Reason })
+	if v.MaxPrefix > 0 {
+		v.UsedPct = float64(v.Accepted) * 100 / float64(v.MaxPrefix)
+	}
+	return v
+}
+
+// fail records a failed poll. The sessions keep their last state.
+func (w *Watch) fail(s *server, now time.Time, err error) {
+	var events []plugin.Event
+	w.mu.Lock()
+	s.status.Up = false
+	s.status.Error = err.Error()
+	s.status.Polled = now
+	s.fails++
+	if s.fails >= failsBeforeAlert && !s.unreachable {
+		s.unreachable = true
+		events = append(events, plugin.NewEvent(plugin.EventRSUnreachable, now,
+			fmt.Sprintf("Birdseye on route server %s is unreachable: %s", s.cfg.Name, err),
+			map[string]string{"server": s.cfg.Name, "error": err.Error()}))
+	}
+	if !s.lastOK.IsZero() && now.Sub(s.lastOK) > staleFactor*w.interval {
+		for _, st := range s.sessions {
+			events = append(events, w.closeAlerts(st, now, "is not visible: route server data is stale", "stale")...)
+		}
+	}
+	w.mu.Unlock()
+	w.log.Warn("route server poll failed", "server", s.cfg.Name, "error", err.Error())
+	w.emit(events)
+}
+
+// apply publishes a successful poll: the rows, the history, and the events
+// for every change since the last one.
+func (w *Watch) apply(s *server, st statusDoc, rows []plugin.RouteServerSession, now time.Time) {
+	var events []plugin.Event
+	w.mu.Lock()
+	s.status = plugin.RouteServerStatus{
+		Name: s.cfg.Name, URL: s.base, ASN: s.cfg.ASN, Up: true, Polled: now,
+		Version: st.Status.Version, RouterID: st.Status.RouterID,
+		LastReconf: st.Status.LastReconf, Message: st.Status.Message,
+		Sessions: len(rows),
+	}
+	s.lastOK = now
+	s.fails = 0
+	if s.unreachable {
+		s.unreachable = false
+		events = append(events, plugin.NewEvent(plugin.EventRSReachable, now,
+			fmt.Sprintf("Birdseye on route server %s answers again", s.cfg.Name),
+			map[string]string{"server": s.cfg.Name}))
+	}
+	seen := make(map[string]bool, len(rows))
+	for _, row := range rows {
+		seen[row.Session] = true
+		st := s.sessions[row.Session]
+		if st == nil {
+			st = &sess{}
+			s.sessions[row.Session] = st
+		}
+		events = append(events, w.evaluate(st, row, now)...)
+		st.view = row
+		s.record(row, now)
+	}
+	for name, st := range s.sessions {
+		if !seen[name] {
+			events = append(events, w.closeAlerts(st, now, "is no longer on the route server", "removed")...)
+			delete(s.sessions, name)
+		}
+	}
+	s.prune(now, w.interval)
+	w.mu.Unlock()
+	w.emit(events)
+}
+
+func (s *server) record(row plugin.RouteServerSession, now time.Time) {
+	smp := sample{
+		at:       now.Unix(),
+		received: int32(row.Received),
+		accepted: int32(row.Accepted),
+		filtered: int32(row.Filtered),
+		max:      int32(row.MaxPrefix),
+	}
+	if row.Established {
+		smp.flags |= flagEstablished
+	}
+	if row.Counted {
+		smp.flags |= flagCounted
+	}
+	if len(row.Reasons) > 0 {
+		smp.reasons = append([]plugin.RouteServerReason(nil), row.Reasons...)
+	}
+	h := append(s.history[row.Session], smp)
+	if len(h) > maxSamples {
+		h = append(h[:0], h[len(h)-maxSamples:]...)
+	}
+	s.history[row.Session] = h
+}
+
+// prune forgets a session that has been gone for the whole history window.
+func (s *server) prune(now time.Time, interval time.Duration) {
+	window := int64(maxSamples * interval / time.Second)
+	for name, h := range s.history {
+		if now.Unix()-h[len(h)-1].at >= window {
+			delete(s.history, name)
+		}
+	}
+}
+
+func fields(row plugin.RouteServerSession, kv ...string) map[string]string {
+	f := map[string]string{
+		"server":  row.Server,
+		"session": row.Session,
+		"asn":     strconv.FormatUint(uint64(row.ASN), 10),
+	}
+	for i := 0; i+1 < len(kv); i += 2 {
+		f[kv[i]] = kv[i+1]
+	}
+	return f
+}
+
+func label(row plugin.RouteServerSession) string {
+	if row.Name != "" {
+		return fmt.Sprintf("%s (AS%d) on %s", row.Name, row.ASN, row.Server)
+	}
+	return fmt.Sprintf("AS%d session %s on %s", row.ASN, row.Session, row.Server)
+}
+
+// evaluate compares a new row with the alerts open on its session. A first
+// sighting raises problems only: a session that is already up, small, and
+// clean says nothing. A row whose counts could not be read, or whose
+// session is down, keeps the prefix and filtered alerts as they are: a
+// dropped session reads zero routes, and BIRD drops a session when its
+// import limit is hit, so a zero is not a recovery.
+func (w *Watch) evaluate(st *sess, row plugin.RouteServerSession, now time.Time) []plugin.Event {
+	var ev []plugin.Event
+	switch {
+	case !row.Established && !st.down:
+		st.down = true
+		ev = append(ev, plugin.NewEvent(plugin.EventRSSessionDown, now,
+			fmt.Sprintf("%s is %s", label(row), row.State), fields(row, "neighbor", row.Neighbor, "state", row.State)))
+	case row.Established && st.down:
+		st.down = false
+		ev = append(ev, plugin.NewEvent(plugin.EventRSSessionUp, now,
+			fmt.Sprintf("%s is Established", label(row)), fields(row, "neighbor", row.Neighbor, "state", row.State)))
+	}
+	if !row.Counted || !row.Established {
+		return ev
+	}
+	high := row.MaxPrefix > 0 && row.Accepted*100 >= w.prefPct*row.MaxPrefix
+	switch {
+	case high && !st.prefixHigh:
+		st.prefixHigh = true
+		ev = append(ev, plugin.NewEvent(plugin.EventRSMaxPrefix, now,
+			fmt.Sprintf("%s: %d accepted of max_prefix %d", label(row), row.Accepted, row.MaxPrefix),
+			fields(row, "accepted", strconv.Itoa(row.Accepted), "max_prefix", strconv.Itoa(row.MaxPrefix))))
+	case !high && st.prefixHigh:
+		st.prefixHigh = false
+		ev = append(ev, plugin.NewEvent(plugin.EventRSMaxPrefixCleared, now,
+			fmt.Sprintf("%s: %d accepted of max_prefix %d", label(row), row.Accepted, row.MaxPrefix),
+			fields(row, "accepted", strconv.Itoa(row.Accepted), "max_prefix", strconv.Itoa(row.MaxPrefix))))
+	}
+	filt := row.Received > 0 && row.Filtered*100 >= w.filtPct*row.Received
+	switch {
+	case filt && !st.filteredHigh:
+		st.filteredHigh = true
+		ev = append(ev, plugin.NewEvent(plugin.EventRSFiltered, now,
+			fmt.Sprintf("%s: %d of %d routes are filtered", label(row), row.Filtered, row.Received),
+			fields(row, "received", strconv.Itoa(row.Received), "filtered", strconv.Itoa(row.Filtered))))
+	case !filt && st.filteredHigh:
+		st.filteredHigh = false
+		ev = append(ev, plugin.NewEvent(plugin.EventRSFilteredCleared, now,
+			fmt.Sprintf("%s: %d of %d routes are filtered", label(row), row.Filtered, row.Received),
+			fields(row, "received", strconv.Itoa(row.Received), "filtered", strconv.Itoa(row.Filtered))))
+	}
+	return ev
+}
+
+// closeAlerts resolves every alert open on a session that is no longer
+// visible, so a pager does not keep an incident for it. why is the
+// reason shown to the operator. The flags are cleared, so a session that
+// comes back is judged afresh.
+func (w *Watch) closeAlerts(st *sess, now time.Time, why, state string) []plugin.Event {
+	row := st.view
+	var ev []plugin.Event
+	if st.down {
+		ev = append(ev, plugin.NewEvent(plugin.EventRSSessionUp, now,
+			label(row)+" "+why, fields(row, "neighbor", row.Neighbor, "state", state)))
+	}
+	if st.prefixHigh {
+		ev = append(ev, plugin.NewEvent(plugin.EventRSMaxPrefixCleared, now,
+			label(row)+" "+why, fields(row, "accepted", "0", "max_prefix", strconv.Itoa(row.MaxPrefix))))
+	}
+	if st.filteredHigh {
+		ev = append(ev, plugin.NewEvent(plugin.EventRSFilteredCleared, now,
+			label(row)+" "+why, fields(row, "received", "0", "filtered", "0")))
+	}
+	st.down, st.prefixHigh, st.filteredHigh = false, false, false
+	return ev
+}
+
+func (w *Watch) emit(events []plugin.Event) {
+	if len(events) == 0 {
+		return
+	}
+	w.mu.Lock()
+	sink := w.sink
+	w.mu.Unlock()
+	if sink == nil {
+		return
+	}
+	for _, e := range events {
+		sink(e)
+	}
+}
+
+// View returns the latest poll. A server with no successful poll for
+// staleFactor intervals is Stale and shows no sessions.
+func (w *Watch) View() plugin.RouteServerView {
+	now := time.Now()
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	v := plugin.RouteServerView{
+		Configured: true,
+		Servers:    make([]plugin.RouteServerStatus, 0, len(w.servers)),
+		Sessions:   []plugin.RouteServerSession{},
+	}
+	for _, s := range w.servers {
+		st := s.status
+		if !s.lastOK.IsZero() && now.Sub(s.lastOK) > staleFactor*w.interval {
+			st.Stale = true
+			st.Up = false
+			st.Sessions = 0
+			if st.Error == "" {
+				st.Error = "route server data is stale"
+			}
+			v.Servers = append(v.Servers, st)
+			continue
+		}
+		v.Servers = append(v.Servers, st)
+		names := make([]string, 0, len(s.sessions))
+		for n := range s.sessions {
+			names = append(names, n)
+		}
+		sort.Strings(names)
+		for _, n := range names {
+			row := s.sessions[n].view
+			row.Reasons = append([]plugin.RouteServerReason{}, row.Reasons...)
+			v.Sessions = append(v.Sessions, row)
+		}
+	}
+	return v
+}
+
+// History returns one session's samples, oldest first.
+func (w *Watch) History(server, session string) ([]plugin.RouteServerSample, bool) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	for _, s := range w.servers {
+		if s.cfg.Name != server {
+			continue
+		}
+		h, ok := s.history[session]
+		if !ok {
+			return nil, false
+		}
+		out := make([]plugin.RouteServerSample, len(h))
+		for i, smp := range h {
+			out[i] = smp.public()
+		}
+		return out, true
+	}
+	return nil, false
+}
