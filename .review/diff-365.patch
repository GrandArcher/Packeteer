+	_ "github.com/GrandArcher/Packeteer/internal/plugins/ixpcorrelate/topology"   // IX fabric incident correlator (observe-only)
 	_ "github.com/GrandArcher/Packeteer/internal/plugins/ixpfabric/icmp"          // IX fabric prober (observe-only)
 	_ "github.com/GrandArcher/Packeteer/internal/plugins/ixpmember/ixf"           // IX-F member import (read-only)
 	_ "github.com/GrandArcher/Packeteer/internal/plugins/ixprouteserver/birdseye" // Birdseye route-server watch (read-only)
diff --git a/internal/plugins/ixpcorrelate/topology/correlate.go b/internal/plugins/ixpcorrelate/topology/correlate.go
new file mode 100644
index 0000000..00501e9
--- /dev/null
+++ b/internal/plugins/ixpcorrelate/topology/correlate.go
@@ -0,0 +1,190 @@
+package topology
+
+import (
+	"sort"
+	"strconv"
+
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+// groupKey identifies one switch, colo, or bundle. Switch ids are per
+// IXP, so the IXP id is part of every key. id is the switch id, the colo
+// name, or the bundle name.
+type groupKey struct {
+	scope string
+	ixp   int
+	id    string
+}
+
+// group is one group in one round.
+type group struct {
+	key      groupKey
+	name     string
+	members  int
+	degraded []uint32
+}
+
+// member is a member that is degraded on every measured address.
+type member struct {
+	asn       uint32
+	name      string
+	addresses int
+}
+
+// observation is one round, before any hysteresis.
+type observation struct {
+	groups []group
+	// firing is the keys of the groups that meet the thresholds.
+	firing map[groupKey]bool
+	// alone is the degraded members that no firing group explains.
+	alone []member
+}
+
+type addrKey struct {
+	ixp, vlan int
+	addr      string
+}
+
+type addrState struct {
+	asn      uint32
+	name     string
+	ixp      int
+	switches []plugin.FabricSwitch
+	bad      bool
+}
+
+// tally counts one member's measured addresses behind one group.
+type tally struct{ total, bad int }
+
+type groupAcc struct {
+	name    string
+	members map[uint32]*tally
+}
+
+// observe groups one fabric round. An address is measured when at least
+// one vantage got a result for it, and degraded when every such vantage
+// saw it past tolerance. A probe error is not a measurement. A member is
+// degraded in a group when every address it has there is degraded. A
+// member behind several switches counts in each of them.
+func observe(samples []plugin.FabricSample, bundles []Bundle, cfg thresholds) observation {
+	addrs := map[addrKey]*addrState{}
+	for _, s := range samples {
+		if s.Error != "" || s.Sent == 0 {
+			continue
+		}
+		k := addrKey{s.IXPID, s.VLANID, s.Address}
+		a := addrs[k]
+		if a == nil {
+			a = &addrState{asn: s.ASN, name: s.Name, ixp: s.IXPID, switches: s.Switches, bad: true}
+			addrs[k] = a
+		}
+		if !s.PastTolerance {
+			a.bad = false
+		}
+	}
+
+	byMember := map[uint32]*tally{}
+	names := map[uint32]string{}
+	acc := map[groupKey]*groupAcc{}
+	for _, a := range addrs {
+		t := byMember[a.asn]
+		if t == nil {
+			t = &tally{}
+			byMember[a.asn] = t
+		}
+		names[a.asn] = a.name
+		t.total++
+		if a.bad {
+			t.bad++
+		}
+		for k, name := range groupsOf(a, bundles) {
+			g := acc[k]
+			if g == nil {
+				g = &groupAcc{name: name, members: map[uint32]*tally{}}
+				acc[k] = g
+			}
+			mt := g.members[a.asn]
+			if mt == nil {
+				mt = &tally{}
+				g.members[a.asn] = mt
+			}
+			mt.total++
+			if a.bad {
+				mt.bad++
+			}
+		}
+	}
+
+	obs := observation{firing: map[groupKey]bool{}}
+	explained := map[uint32]bool{}
+	for k, g := range acc {
+		out := group{key: k, name: g.name, members: len(g.members)}
+		for asn, t := range g.members {
+			if t.bad == t.total {
+				out.degraded = append(out.degraded, asn)
+			}
+		}
+		sort.Slice(out.degraded, func(i, j int) bool { return out.degraded[i] < out.degraded[j] })
+		if cfg.fires(len(out.degraded), out.members) {
+			obs.firing[k] = true
+			for _, asn := range out.degraded {
+				explained[asn] = true
+			}
+		}
+		obs.groups = append(obs.groups, out)
+	}
+	sort.Slice(obs.groups, func(i, j int) bool { return lessKey(obs.groups[i].key, obs.groups[j].key) })
+
+	for asn, t := range byMember {
+		if t.bad == t.total && !explained[asn] {
+			obs.alone = append(obs.alone, member{asn: asn, name: names[asn], addresses: t.total})
+		}
+	}
+	sort.Slice(obs.alone, func(i, j int) bool { return obs.alone[i].asn < obs.alone[j].asn })
+	return obs
+}
+
+func lessKey(a, b groupKey) bool {
+	if a.scope != b.scope {
+		return a.scope < b.scope
+	}
+	if a.ixp != b.ixp {
+		return a.ixp < b.ixp
+	}
+	return a.id < b.id
+}
+
+// groupsOf returns the groups an address belongs to, with display names.
+// Two switches in one colo put the address in that colo once.
+func groupsOf(a *addrState, bundles []Bundle) map[groupKey]string {
+	out := map[groupKey]string{}
+	for _, sw := range a.switches {
+		id := strconv.Itoa(sw.ID)
+		name := sw.Name
+		if name == "" {
+			name = "switch-" + id
+		}
+		out[groupKey{plugin.ScopeSwitch, a.ixp, id}] = name
+		if sw.Colo != "" {
+			out[groupKey{plugin.ScopeColo, a.ixp, sw.Colo}] = sw.Colo
+		}
+		for _, b := range bundles {
+			if b.has(a.ixp, sw.ID) {
+				out[groupKey{plugin.ScopeBundle, a.ixp, b.Name}] = b.Name
+			}
+		}
+	}
+	return out
+}
+
+// thresholds decide when a group is a fabric problem.
+type thresholds struct {
+	minMembers int
+	pct        int
+}
+
+// fires is true when enough members are degraded, and enough of the
+// measured members. Both guard against a two-member switch alarming.
+func (t thresholds) fires(degraded, measured int) bool {
+	return degraded >= t.minMembers && degraded*100 >= t.pct*measured
+}
diff --git a/internal/plugins/ixpcorrelate/topology/plugin.go b/internal/plugins/ixpcorrelate/topology/plugin.go
new file mode 100644
index 0000000..a6c8671
--- /dev/null
+++ b/internal/plugins/ixpcorrelate/topology/plugin.go
@@ -0,0 +1,469 @@
+// Package topology is the ixp.correlate plugin (#163). It reads the fabric
+// probe view, groups member measurements by switch, colo, and core bundle,
+// and raises ixp.fabric_degraded when many members behind one group
+// degrade together and ixp.member_degraded when one member does alone. It
+// does not probe, does not announce, and is not an input to Decide.
+package topology
+
+import (
+	"cmp"
+	"context"
+	"fmt"
+	"slices"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+// TypeName is the config type.
+const TypeName = "topology"
+
+// Defaults and bounds. A zero value in config selects the default.
+const (
+	DefaultMinMembers  = 3
+	minMinMembers      = 2
+	maxMinMembers      = 1000
+	DefaultDegradedPct = 50
+	DefaultRounds      = 2
+	maxRounds          = 10
+	maxBundles         = 64
+	maxBundleSwitches  = 256
+
+	// pollEvery is how often the loop looks for a new fabric round. It is
+	// not a config knob: the prober interval is at least 10 seconds.
+	pollEvery = 5 * time.Second
+	// maxASNsInEvent bounds the asns field of an event.
+	maxASNsInEvent = 10
+)
+
+// Bundle names the switches that share one core link bundle. IX-F carries
+// no core bundle, so the operator lists them. IXPID 0 matches any IXP.
+type Bundle struct {
+	Name     string `yaml:"name"`
+	IXPID    int    `yaml:"ixp_id"`
+	Switches []int  `yaml:"switches"`
+}
+
+func (b Bundle) has(ixp, sw int) bool {
+	if b.IXPID != 0 && b.IXPID != ixp {
+		return false
+	}
+	for _, id := range b.Switches {
+		if id == sw {
+			return true
+		}
+	}
+	return false
+}
+
+// Config is the topology correlator's config block.
+type Config struct {
+	MinMembers  int      `yaml:"min_members"`
+	DegradedPct int      `yaml:"degraded_pct"`
+	Rounds      int      `yaml:"rounds"`
+	Bundles     []Bundle `yaml:"bundles"`
+}
+
+func init() { plugin.FabricCorrelators.Register(TypeName, New) }
+
+// The controller stores the correlator as a FabricCorrelator.
+var _ plugin.FabricCorrelator = (*Correlator)(nil)
+
+// flip is a state with hysteresis: it changes only after rounds
+// consecutive observations that disagree with it.
+type flip struct {
+	active bool
+	n      int
+}
+
+func (f *flip) step(cond bool, rounds int) bool {
+	if cond == f.active {
+		f.n = 0
+		return false
+	}
+	f.n++
+	if f.n < rounds {
+		return false
+	}
+	f.active, f.n = cond, 0
+	return true
+}
+
+func (f *flip) idle() bool { return !f.active && f.n == 0 }
+
+type groupState struct {
+	flip
+	last group
+}
+
+type memberState struct {
+	flip
+	last member
+}
+
+// Correlator is the topology correlator.
+type Correlator struct {
+	th      thresholds
+	rounds  int
+	bundles []Bundle
+	now     func() time.Time
+
+	mu     sync.Mutex
+	fabric func() plugin.FabricView
+	sink   func(plugin.Event)
+	groups map[groupKey]*groupState
+	member map[uint32]*memberState
+	seen   time.Time
+	view   plugin.CorrelationView
+	cancel context.CancelFunc
+	done   chan struct{}
+}
+
+// New validates the config. It does not read the fabric view.
+func New(c plugin.Config, _ plugin.Env) (plugin.FabricCorrelator, error) {
+	var cfg Config
+	if err := c.Decode(&cfg); err != nil {
+		return nil, err
+	}
+	if err := applyDefaults(&cfg); err != nil {
+		return nil, err
+	}
+	return &Correlator{
+		th:      thresholds{minMembers: cfg.MinMembers, pct: cfg.DegradedPct},
+		rounds:  cfg.Rounds,
+		bundles: cfg.Bundles,
+		now:     time.Now,
+		groups:  map[groupKey]*groupState{},
+		member:  map[uint32]*memberState{},
+		view: plugin.CorrelationView{
+			Configured: true,
+			Groups:     []plugin.CorrelationGroup{},
+			Members:    []plugin.CorrelationMember{},
+		},
+	}, nil
+}
+
+func applyDefaults(cfg *Config) error {
+	if cfg.MinMembers == 0 {
+		cfg.MinMembers = DefaultMinMembers
+	}
+	if cfg.MinMembers < minMinMembers || cfg.MinMembers > maxMinMembers {
+		return fmt.Errorf("min_members %d must be between %d and %d", cfg.MinMembers, minMinMembers, maxMinMembers)
+	}
+	if cfg.DegradedPct == 0 {
+		cfg.DegradedPct = DefaultDegradedPct
+	}
+	if cfg.DegradedPct < 1 || cfg.DegradedPct > 100 {
+		return fmt.Errorf("degraded_pct %d must be between 1 and 100", cfg.DegradedPct)
+	}
+	if cfg.Rounds == 0 {
+		cfg.Rounds = DefaultRounds
+	}
+	if cfg.Rounds < 1 || cfg.Rounds > maxRounds {
+		return fmt.Errorf("rounds %d must be between 1 and %d", cfg.Rounds, maxRounds)
+	}
+	return validateBundles(cfg.Bundles)
+}
+
+func validateBundles(bundles []Bundle) error {
+	if len(bundles) > maxBundles {
+		return fmt.Errorf("bundles: more than %d", maxBundles)
+	}
+	names := map[string]bool{}
+	for i, b := range bundles {
+		if !plugin.ValidLabel(b.Name) {
+			return fmt.Errorf("bundles[%d].name is invalid", i)
+		}
+		if names[b.Name] {
+			return fmt.Errorf("bundles[%d].name %q is duplicated", i, b.Name)
+		}
+		names[b.Name] = true
+		if b.IXPID < 0 {
+			return fmt.Errorf("bundles[%d].ixp_id is invalid", i)
+		}
+		if len(b.Switches) == 0 || len(b.Switches) > maxBundleSwitches {
+			return fmt.Errorf("bundles[%d].switches needs 1 to %d switch ids", i, maxBundleSwitches)
+		}
+		for _, id := range b.Switches {
+			if id < 1 {
+				return fmt.Errorf("bundles[%d].switches has an invalid switch id %d", i, id)
+			}
+		}
+	}
+	return nil
+}
+
+// SetFabric records the fabric view to read. The controller calls it
+// before Start.
+func (c *Correlator) SetFabric(fn func() plugin.FabricView) {
+	c.mu.Lock()
+	c.fabric = fn
+	c.mu.Unlock()
+}
+
+// SetEventSink records where events go. The controller calls it before
+// Start.
+func (c *Correlator) SetEventSink(fn func(plugin.Event)) {
+	c.mu.Lock()
+	c.sink = fn
+	c.mu.Unlock()
+}
+
+// View returns the latest evaluated round.
+func (c *Correlator) View() plugin.CorrelationView {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.view
+}
+
+// Start begins the loop. It does not block.
+func (c *Correlator) Start(ctx context.Context) error {
+	ctx, cancel := context.WithCancel(ctx)
+	done := make(chan struct{})
+	c.mu.Lock()
+	c.cancel, c.done = cancel, done
+	c.mu.Unlock()
+	go c.loop(ctx, done)
+	return nil
+}
+
+// Stop cancels the loop and waits for it to leave.
+func (c *Correlator) Stop(ctx context.Context) error {
+	c.mu.Lock()
+	cancel, done := c.cancel, c.done
+	c.mu.Unlock()
+	if cancel != nil {
+		cancel()
+	}
+	if done == nil {
+		return nil
+	}
+	select {
+	case <-done:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func (c *Correlator) loop(ctx context.Context, done chan struct{}) {
+	defer close(done)
+	t := time.NewTicker(pollEvery)
+	defer t.Stop()
+	for {
+		c.poll()
+		select {
+		case <-ctx.Done():
+			return
+		case <-t.C:
+		}
+	}
+}
+
+// poll evaluates the fabric view when it holds a round not seen before.
+func (c *Correlator) poll() {
+	c.mu.Lock()
+	fn := c.fabric
+	c.mu.Unlock()
+	if fn == nil {
+		return
+	}
+	c.evaluate(fn())
+}
+
+// evaluate applies one fabric round. A stale round has no samples, so
+// every open incident counts toward its resolving event.
+func (c *Correlator) evaluate(fv plugin.FabricView) {
+	if fv.Round.IsZero() {
+		return
+	}
+	c.mu.Lock()
+	if fv.Round.Equal(c.seen) {
+		c.mu.Unlock()
+		return
+	}
+	c.seen = fv.Round
+	samples := fv.Samples
+	if fv.Stale {
+		samples = nil
+	}
+	obs := observe(samples, c.bundles, c.th)
+	now := c.now()
+	events := c.stepGroups(obs, now)
+	events = append(events, c.stepMembers(obs, now)...)
+	c.view = c.buildView(fv, obs)
+	sink := c.sink
+	c.mu.Unlock()
+	if sink == nil {
+		return
+	}
+	for _, e := range events {
+		sink(e)
+	}
+}
+
+func (c *Correlator) stepGroups(obs observation, now time.Time) []plugin.Event {
+	var events []plugin.Event
+	seen := map[groupKey]bool{}
+	for _, g := range obs.groups {
+		seen[g.key] = true
+		st := c.groups[g.key]
+		if st == nil {
+			st = &groupState{}
+			c.groups[g.key] = st
+		}
+		st.last = g
+		if st.step(obs.firing[g.key], c.rounds) {
+			events = append(events, groupEvent(st.active, g, now))
+		}
+	}
+	for k, st := range c.groups {
+		if !seen[k] && st.step(false, c.rounds) {
+			events = append(events, groupEvent(false, st.last, now))
+		}
+	}
+	for k, st := range c.groups {
+		if st.idle() {
+			delete(c.groups, k)
+		}
+	}
+	return events
+}
+
+func (c *Correlator) stepMembers(obs observation, now time.Time) []plugin.Event {
+	var events []plugin.Event
+	seen := map[uint32]bool{}
+	for _, m := range obs.alone {
+		seen[m.asn] = true
+		st := c.member[m.asn]
+		if st == nil {
+			st = &memberState{}
+			c.member[m.asn] = st
+		}
+		st.last = m
+		if st.step(true, c.rounds) {
+			events = append(events, memberEvent(true, m, now))
+		}
+	}
+	for asn, st := range c.member {
+		if !seen[asn] && st.step(false, c.rounds) {
+			events = append(events, memberEvent(false, st.last, now))
+		}
+		if st.idle() {
+			delete(c.member, asn)
+		}
+	}
+	return events
+}
+
+// buildView lists the groups and members of this round, plus those whose
+// event is still open but that were not seen this round, so an open
+// event is always visible in the view.
+func (c *Correlator) buildView(fv plugin.FabricView, obs observation) plugin.CorrelationView {
+	groups := slices.Clone(obs.groups)
+	inRound := map[groupKey]bool{}
+	for _, g := range obs.groups {
+		inRound[g.key] = true
+	}
+	for k, st := range c.groups {
+		if st.active && !inRound[k] {
+			groups = append(groups, group{key: k, name: st.last.name})
+		}
+	}
+	slices.SortFunc(groups, func(a, b group) int {
+		switch {
+		case lessKey(a.key, b.key):
+			return -1
+		case lessKey(b.key, a.key):
+			return 1
+		}
+		return 0
+	})
+	members := slices.Clone(obs.alone)
+	alone := map[uint32]bool{}
+	for _, m := range obs.alone {
+		alone[m.asn] = true
+	}
+	for asn, st := range c.member {
+		if st.active && !alone[asn] {
+			members = append(members, member{asn: asn, name: st.last.name})
+		}
+	}
+	slices.SortFunc(members, func(a, b member) int { return cmp.Compare(a.asn, b.asn) })
+
+	v := plugin.CorrelationView{
+		Configured: true,
+		Stale:      fv.Stale,
+		Round:      fv.Round,
+		Groups:     make([]plugin.CorrelationGroup, 0, len(groups)),
+		Members:    make([]plugin.CorrelationMember, 0, len(members)),
+	}
+	for _, g := range groups {
+		asns := g.degraded
+		if asns == nil {
+			asns = []uint32{}
+		}
+		active := false
+		if st := c.groups[g.key]; st != nil {
+			active = st.active
+		}
+		v.Groups = append(v.Groups, plugin.CorrelationGroup{
+			Scope: g.key.scope, IXPID: g.key.ixp, Name: g.name,
+			Members: g.members, Degraded: len(g.degraded),
+			DegradedPct: float64(len(g.degraded)) * 100 / float64(max(g.members, 1)),
+			Active:      active, ASNs: asns,
+		})
+	}
+	for _, m := range members {
+		active := false
+		if st := c.member[m.asn]; st != nil {
+			active = st.active
+		}
+		v.Members = append(v.Members, plugin.CorrelationMember{ASN: m.asn, Name: m.name, Addresses: m.addresses, Active: active})
+	}
+	return v
+}
+
+func groupEvent(degraded bool, g group, now time.Time) plugin.Event {
+	fields := map[string]string{
+		"scope": g.key.scope, "ixp_id": strconv.Itoa(g.key.ixp), "group": g.key.id, "name": g.name,
+	}
+	label := g.key.scope + " " + g.name
+	if !degraded {
+		return plugin.NewEvent(plugin.EventFabricRecovered, now, label+" is no longer degraded", fields)
+	}
+	fields["members"] = strconv.Itoa(g.members)
+	fields["degraded"] = strconv.Itoa(len(g.degraded))
+	fields["asns"] = asnList(g.degraded)
+	return plugin.NewEvent(plugin.EventFabricDegraded, now,
+		fmt.Sprintf("%s: %d of %d members degraded", label, len(g.degraded), g.members), fields)
+}
+
+func memberEvent(degraded bool, m member, now time.Time) plugin.Event {
+	asn := strconv.FormatUint(uint64(m.asn), 10)
+	fields := map[string]string{"asn": asn}
+	if m.name != "" {
+		fields["name"] = m.name
+	}
+	if degraded {
+		fields["addresses"] = strconv.Itoa(m.addresses)
+		return plugin.NewEvent(plugin.EventMemberDegraded, now,
+			fmt.Sprintf("AS%s is degraded on all %d measured addresses and no switch, colo, or bundle behind it is degraded", asn, m.addresses), fields)
+	}
+	return plugin.NewEvent(plugin.EventMemberRecovered, now, "AS"+asn+" is no longer degraded on its own", fields)
+}
+
+func asnList(asns []uint32) string {
+	n := min(len(asns), maxASNsInEvent)
+	parts := make([]string, 0, n+1)
+	for _, a := range asns[:n] {
+		parts = append(parts, strconv.FormatUint(uint64(a), 10))
+	}
+	if len(asns) > n {
+		parts = append(parts, "...")
+	}
+	return strings.Join(parts, ",")
+}
diff --git a/internal/plugins/ixpcorrelate/topology/topology_test.go b/internal/plugins/ixpcorrelate/topology/topology_test.go
new file mode 100644
index 0000000..7eb1428
--- /dev/null
+++ b/internal/plugins/ixpcorrelate/topology/topology_test.go
@@ -0,0 +1,497 @@
+package topology
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	"gopkg.in/yaml.v3"
+
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+var t0 = time.Date(2026, 10, 18, 12, 0, 0, 0, time.UTC)
+
+// sw is a switch in a documentation colo.
+func sw(id int, colo string) plugin.FabricSwitch {
+	return plugin.FabricSwitch{ID: id, Name: fmt.Sprintf("sw%d", id), Colo: colo}
+}
+
+// smp is one probe of one member address from one vantage.
+func smp(vantage string, asn uint32, addr string, bad bool, switches ...plugin.FabricSwitch) plugin.FabricSample {
+	return plugin.FabricSample{
+		Vantage: vantage, ASN: asn, Name: fmt.Sprintf("member-%d", asn), Address: addr,
+		Family: "ipv4", VLANID: 10, IXPID: 1, Switches: switches,
+		Sent: 5, Received: 5, PastTolerance: bad,
+	}
+}
+
+// members returns n members starting at base, one address each behind sw.
+func members(base uint32, n int, bad bool, sws ...plugin.FabricSwitch) []plugin.FabricSample {
+	var out []plugin.FabricSample
+	for i := 0; i < n; i++ {
+		asn := base + uint32(i)
+		out = append(out, smp("v1", asn, fmt.Sprintf("192.0.2.%d", asn-64000), bad, sws...))
+	}
+	return out
+}
+
+func cat(parts ...[]plugin.FabricSample) []plugin.FabricSample {
+	var out []plugin.FabricSample
+	for _, p := range parts {
+		out = append(out, p...)
+	}
+	return out
+}
+
+func newCorrelator(t *testing.T, yamlCfg string) (*Correlator, *[]plugin.Event) {
+	t.Helper()
+	var node yaml.Node
+	if err := yaml.Unmarshal([]byte(yamlCfg), &node); err != nil {
+		t.Fatal(err)
+	}
+	p, err := New(plugin.NewConfig(&node), plugin.Env{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := p.(*Correlator)
+	var got []plugin.Event
+	c.SetEventSink(func(e plugin.Event) { got = append(got, e) })
+	c.now = func() time.Time { return t0 }
+	return c, &got
+}
+
+// round feeds one fabric round. n distinguishes rounds.
+func round(c *Correlator, n int, samples []plugin.FabricSample) {
+	c.evaluate(plugin.FabricView{Configured: true, Round: t0.Add(time.Duration(n) * time.Minute), Samples: samples})
+}
+
+func kinds(evs []plugin.Event) []string {
+	var out []string
+	for _, e := range evs {
+		out = append(out, e.Kind+" "+e.Fields["scope"]+e.Fields["asn"]+" "+e.Fields["group"])
+	}
+	return out
+}
+
+func TestSwitchFaultIsFabricNotMember(t *testing.T) {
+	c, got := newCorrelator(t, "rounds: 1")
+	s1, s2 := sw(1, "colo-a"), sw(2, "colo-b")
+	round(c, 1, cat(members(64500, 5, true, s1), members(64600, 4, false, s2)))
+	want := []string{
+		"ixp.fabric_degraded colo colo-a",
+		"ixp.fabric_degraded switch 1",
+	}
+	if g := kinds(*got); !sameSet(g, want) {
+		t.Fatalf("events %v, want %v", g, want)
+	}
+	for _, e := range *got {
+		if e.Kind == plugin.EventMemberDegraded {
+			t.Fatalf("a member behind a degraded switch must not raise member_degraded: %+v", e)
+		}
+		if e.Fields["members"] != "5" || e.Fields["degraded"] != "5" || e.Fields["ixp_id"] != "1" {
+			t.Fatalf("fields %v", e.Fields)
+		}
+		if e.Fields["asns"] != "64500,64501,64502,64503,64504" {
+			t.Fatalf("asns %q", e.Fields["asns"])
+		}
+	}
+	v := c.View()
+	if len(v.Members) != 0 {
+		t.Fatalf("members %+v", v.Members)
+	}
+	var sw2 *plugin.CorrelationGroup
+	for i := range v.Groups {
+		if v.Groups[i].Name == "sw2" {
+			sw2 = &v.Groups[i]
+		}
+	}
+	if sw2 == nil || sw2.Members != 4 || sw2.Degraded != 0 || sw2.Active {
+		t.Fatalf("sw2 %+v", sw2)
+	}
+}
+
+func sameSet(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	m := map[string]int{}
+	for _, x := range a {
+		m[x]++
+	}
+	for _, x := range b {
+		m[x]--
+	}
+	for _, n := range m {
+		if n != 0 {
+			return false
+		}
+	}
+	return true
+}
