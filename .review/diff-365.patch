+	// problem and the first member is no longer a separate one.
+	*got = nil
+	round(c, 2, members(64500, 6, true, s1))
+	g := kinds(*got)
+	if !sameSet(g, []string{"ixp.fabric_degraded switch 1", "ixp.fabric_degraded colo colo-a", "ixp.member_recovered 64500 "}) {
+		t.Fatalf("events %v", g)
+	}
+}
