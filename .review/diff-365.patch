+func TestMemberThenFabric(t *testing.T) {
+	c, got := newCorrelator(t, "rounds: 1")
+	s1 := sw(1, "colo-a")
+	round(c, 1, cat(members(64500, 1, true, s1), members(64501, 5, false, s1)))
+	if g := kinds(*got); len(g) != 1 || g[0] != "ixp.member_degraded 64500 " {
+		t.Fatalf("events %v", g)
