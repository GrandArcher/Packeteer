+	if got := unset.perHour(120, 60); got != 6000 {
+		t.Fatalf("unset warmup %v, want 6000", got)
+	}
+	if got := (probePace{end: 10}).perHour(0.5, 0); got != 0 {
+		t.Fatalf("short soak %v", got)
+	}
