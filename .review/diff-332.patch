+func TestParseRejects(t *testing.T) {
+	secret := docSecret
+	cases := []struct {
+		body string
+		want string
+		hide string
+	}{
+		{`{"version":"0.7","member_list":[]}`, `version must be "1.0"`, ""},
+		{`{"version":1.0}`, `version must be "1.0"`, ""},
+		{`{"version":`, "invalid JSON", ""},
+		{`{"version":"1.0","member_list":[{"asnum":0,"name":"n"}]}`, "asnum is invalid", ""},
+		{`{"version":"1.0","member_list":[{"asnum":64496,"name":"n","connection_list":[{"vlan_list":[{"ipv4":{"address":"` + secret + `"}}]}]}]}`, "address is not an IP address", secret},
+		{`{"version":"1.0","member_list":[{"asnum":64496,"name":"` + strings.Repeat("LONGTOKEN", 40) + `"}]}`, "longer than", "LONGTOKEN"},
+	}
+	for _, tc := range cases {
+		_, err := parseIXF([]byte(tc.body))
+		if err == nil || !strings.Contains(err.Error(), tc.want) {
+			t.Fatalf("body %s err %v", tc.want, err)
+		}
+		if tc.hide != "" && strings.Contains(err.Error(), tc.hide) {
+			t.Fatalf("error echoes %s: %v", tc.hide, err)
+		}
+	}
+	_, err := parseIXF([]byte(overList("member_list", maxMembers+1, `{"asnum":64496,"name":"n"}`)))
+	if err == nil || !strings.Contains(err.Error(), "member_list: more than") {
+		t.Fatal(err)
+	}
+	_, err = parseIXF([]byte(overList("ixp_list", maxIXPs+1, `{"ixp_id":1}`)))
+	if err == nil || !strings.Contains(err.Error(), "ixp_list: more than") {
+		t.Fatal(err)
+	}
+	sw := `{"id":1,"name":"sw"}`
+	body := `{"version":"1.0","ixp_list":[{"ixp_id":1,"switch":[` + joinN(sw, maxSwitchesIXP+1) + `]}]}`
+	if _, err := parseIXF([]byte(body)); err == nil || !strings.Contains(err.Error(), "switch: more than") {
+		t.Fatal(err)
+	}
+	full := `{"ixp_id":1,"switch":[` + joinN(sw, maxSwitchesIXP) + `]}`
+	full2 := `{"ixp_id":2,"switch":[` + joinN(sw, maxSwitchesIXP) + `]}`
+	if _, err := parseIXF([]byte(`{"version":"1.0","ixp_list":[` + full + `,` + full2 + `]}`)); err != nil {
+		t.Fatal(err)
+	}
+	over := `{"version":"1.0","ixp_list":[` + full + `,` + full2 + `,{"ixp_id":3,"switch":[` + sw + `]}]}`
+	if _, err := parseIXF([]byte(over)); err == nil || !strings.Contains(err.Error(), "more than 4000 switches") {
+		t.Fatal(err)
+	}
+	conn := `{"version":"1.0","member_list":[{"asnum":64496,"connection_list":[` + joinN(`{}`, maxConns+1) + `]}]}`
+	if _, err := parseIXF([]byte(conn)); err == nil || !strings.Contains(err.Error(), "connection_list: more than") {
+		t.Fatal(err)
+	}
+	ifaces := `{"version":"1.0","member_list":[{"asnum":64496,"connection_list":[{"if_list":[` + joinN(`{"switch_id":1,"if_speed":10}`, maxIfaces+1) + `]}]}]}`
+	if _, err := parseIXF([]byte(ifaces)); err == nil || !strings.Contains(err.Error(), "if_list: more than") {
+		t.Fatal(err)
+	}
+	vlans := `{"version":"1.0","member_list":[{"asnum":64496,"connection_list":[{"vlan_list":[` + joinN(`{}`, maxVLANs+1) + `]}]}]}`
+	if _, err := parseIXF([]byte(vlans)); err == nil || !strings.Contains(err.Error(), "vlan_list: more than") {
+		t.Fatal(err)
+	}
+}
+
+func overList(field string, n int, item string) string {
+	return `{"version":"1.0","` + field + `":[` + joinN(item, n) + `]}`
+}
+
+func joinN(item string, n int) string {
+	parts := make([]string, n)
+	for i := range parts {
+		parts[i] = item
+	}
+	return strings.Join(parts, ",")
+}
diff --git a/internal/plugins/ixpmember/ixf/url.go b/internal/plugins/ixpmember/ixf/url.go
new file mode 100644
index 0000000..b179b45
--- /dev/null
+++ b/internal/plugins/ixpmember/ixf/url.go
@@ -0,0 +1,137 @@
+package ixf
+
+import (
+	"errors"
+	"fmt"
+	"net/url"
+	"strings"
+)
+
+// secretQuery is never sent, on the manager URL or on a named document.
+// The error names the query key and not its value.
+var secretQuery = map[string]bool{
+	"apikey": true, "api_key": true, "access_key": true,
+	"key": true, "token": true, "password": true,
+}
+
+// classifyURL decides whether url is the IXP Manager member export or one
+// named IX-F document. The API key is sent only to the manager export.
+// An empty path, or a path that ends with the export path (a subdirectory
+// install), is the manager. Anything else is fetched exactly, with no key.
+// A key on a URL that is not the manager export is an error here.
+func classifyURL(raw, apiKey string) (string, bool, error) {
+	if strings.TrimSpace(raw) == "" {
+		return "", false, errors.New("url is required")
+	}
+	u, err := url.Parse(raw)
+	if err != nil || (u.Scheme != "http" && u.Scheme != "https") || u.Host == "" || u.User != nil || u.Fragment != "" {
+		return "", false, errors.New("url must be an http or https URL with a host and no userinfo or fragment")
+	}
+	// Reject before the URL is copied into fetchURL. Percent-encoding the
+	// first character hides the key from a raw substring check, and
+	// EscapedPath keeps that encoding, so the secret would stay on the
+	// request line and on GET /api/ixp/members.
+	if urlHasKey(raw, u, apiKey) {
+		return "", false, errors.New("url must not contain the API key")
+	}
+	q := u.Query()
+	for k := range q {
+		if secretQuery[strings.ToLower(k)] {
+			return "", false, fmt.Errorf("url query %q is not allowed", k)
+		}
+	}
+	path := strings.TrimRight(u.Path, "/")
+	if managerPath(path) {
+		if err := allowManagerQuery(q); err != nil {
+			return "", false, err
+		}
+		if path == "" {
+			u.Path = exportPath
+		} else {
+			u.Path = path
+		}
+		u.RawQuery = q.Encode()
+		u.Fragment = ""
+		return u.String(), true, nil
+	}
+	if apiKey != "" {
+		return "", false, errors.New("API key is only sent to the IXP Manager member export")
+	}
+	return raw, false, nil
+}
+
+// urlHasKey reports whether the API key or its secret appears in raw or
+// in the decoded URL. url.Parse decodes the path but String keeps the
+// original percent-encoding, so both forms are checked.
+func urlHasKey(raw string, u *url.URL, apiKey string) bool {
+	if apiKey == "" {
+		return false
+	}
+	if keyIn(raw, apiKey) || keyIn(u.Path, apiKey) || keyIn(u.Host, apiKey) || keyIn(u.RawPath, apiKey) || keyIn(u.String(), apiKey) {
+		return true
+	}
+	if dec, err := url.PathUnescape(raw); err == nil && keyIn(dec, apiKey) {
+		return true
+	}
+	if dec, err := url.PathUnescape(u.Host); err == nil && keyIn(dec, apiKey) {
+		return true
+	}
+	for k, vals := range u.Query() {
+		if keyIn(k, apiKey) {
+			return true
+		}
+		for _, v := range vals {
+			if keyIn(v, apiKey) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func keyIn(s, apiKey string) bool {
+	if s == "" || apiKey == "" {
+		return false
+	}
+	if strings.Contains(s, apiKey) {
+		return true
+	}
+	secret := keySecret(apiKey)
+	return secret != "" && strings.Contains(s, secret)
+}
+
+func managerPath(path string) bool {
+	if path == "" {
+		return true
+	}
+	return path == exportPath || strings.HasSuffix(path, exportPath)
+}
+
+func allowManagerQuery(q url.Values) error {
+	for k, vals := range q {
+		if len(vals) != 1 || !managerQueryOK(k, vals[0]) {
+			return fmt.Errorf("url query %q is not allowed", k)
+		}
+	}
+	return nil
+}
+
+func managerQueryOK(k, v string) bool {
+	if k == "ignore_missing_ixfid" && v == "1" {
+		return true
+	}
+	id, ok := strings.CutPrefix(k, "ixfid_")
+	return ok && digits(id) && digits(v)
+}
+
+func digits(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, c := range s {
+		if c < '0' || c > '9' {
+			return false
+		}
+	}
+	return true
+}
