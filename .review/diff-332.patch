+	if s.manager {
+		t.Fatal("named url classified as manager")
+	}
+	s.fetch(context.Background())
+	v := s.View()
+	if v.Error != "" || v.MemberCount != 0 || v.Manager || header != "" || got != "/members.json?vlan=1" {
+		t.Fatalf("view %+v uri %s header %q", v, got, header)
+	}
+}
+
+func TestRedirectDropsKey(t *testing.T) {
+	var second atomic.Int32
+	steal := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		second.Add(1)
+		if r.Header.Get(apiKeyHeader) != "" {
+			t.Error("API key was forwarded")
+		}
+	}))
+	defer steal.Close()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get(apiKeyHeader) != docKey {
+			t.Errorf("first header %q", r.Header.Get(apiKeyHeader))
+		}
+		http.Redirect(w, r, steal.URL+"/steal?k="+docKey, http.StatusFound)
+	}))
+	defer srv.Close()
+	s := build(t, "url: "+srv.URL+"/\nkey_expires: \""+utcDay(20)+"\"\n", docKey, nil)
+	s.fetch(context.Background())
+	v := s.View()
+	if second.Load() != 0 {
+		t.Fatalf("redirect target saw %d requests", second.Load())
+	}
+	if v.Error != "member export: redirects are not followed" || strings.Contains(v.Error, docSecret) || strings.Contains(v.Error, docKey) || v.MemberCount != 0 {
+		t.Fatalf("view %+v", v)
+	}
+}
+
+func TestFailedFetchKeepsMembersUntilStale(t *testing.T) {
+	var big atomic.Bool
+	var status atomic.Int32
+	status.Store(http.StatusOK)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if big.Load() {
+			_, _ = w.Write(bytesRepeat(3000))
+			return
+		}
+		w.WriteHeader(int(status.Load()))
+		if status.Load() == http.StatusOK {
+			_, _ = io.WriteString(w, sampleIXF)
+		}
+	}))
+	defer srv.Close()
+	s := build(t, "url: "+srv.URL+"/members.json\nmax_bytes: 2048\nrefresh: 1m\n", "", nil)
+	if len(sampleIXF) > 2048 {
+		t.Fatalf("fixture is %d bytes", len(sampleIXF))
+	}
+	s.fetch(context.Background())
+	if s.View().MemberCount != 2 || s.View().Error != "" {
+		t.Fatalf("first %+v", s.View())
+	}
+	status.Store(http.StatusInternalServerError)
+	s.fetch(context.Background())
+	v := s.View()
+	if v.MemberCount != 2 || v.Stale || !strings.Contains(v.Error, "HTTP 500") {
+		t.Fatalf("after 500 %+v", v)
+	}
+	big.Store(true)
+	status.Store(http.StatusOK)
+	s.fetch(context.Background())
+	v = s.View()
+	if v.MemberCount != 2 || !strings.Contains(v.Error, "larger than 2048") {
+		t.Fatalf("after size %+v", v)
+	}
+	s.mu.Lock()
+	s.view.Fetched = time.Now().Add(-3*s.refresh - time.Second)
+	s.view.KeyID = docIdent
+	s.mu.Unlock()
+	v = s.View()
+	if !v.Stale || len(v.Members) != 0 || len(v.IXPs) != 0 || v.MemberCount != 0 || v.KeyID != docIdent || v.Error != "member list is stale" || v.URL == "" {
+		t.Fatalf("stale %+v", v)
+	}
+}
+
+func TestStartFetchesOnce(t *testing.T) {
+	var n atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		n.Add(1)
+		_, _ = io.WriteString(w, sampleIXF)
+	}))
+	defer srv.Close()
+	s := build(t, "url: "+srv.URL+"/members.json\nrefresh: 1m\n", "", nil)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	if err := s.Start(ctx); err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) && s.View().MemberCount != 2 {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if s.View().MemberCount != 2 || n.Load() != 1 {
+		t.Fatalf("count %d requests %d err %s", s.View().MemberCount, n.Load(), s.View().Error)
+	}
+	stop, cancelStop := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancelStop()
+	if err := s.Stop(stop); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestFetchCancelled(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		t.Error("fetch ran")
+	}))
+	defer srv.Close()
+	s := build(t, "url: "+srv.URL+"/members.json\n", "", nil)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	s.fetch(ctx)
+	v := s.View()
+	if v.Error != "" || v.MemberCount != 0 || !v.Fetched.IsZero() {
+		t.Fatalf("%+v", v)
+	}
+}
+
+func bytesRepeat(n int) []byte {
+	b := make([]byte, n)
+	for i := range b {
+		b[i] = 'x'
+	}
+	return b
+}
diff --git a/internal/plugins/ixpmember/ixf/key.go b/internal/plugins/ixpmember/ixf/key.go
new file mode 100644
index 0000000..789ab77
--- /dev/null
+++ b/internal/plugins/ixpmember/ixf/key.go
@@ -0,0 +1,105 @@
+package ixf
+
+import (
+	"errors"
+	"hash/crc32"
+	"net/url"
+	"strings"
+)
+
+// APIKeyEnv is the IXP Manager API key. The header is the only place it
+// is sent. The value is never written to the config file or the URL.
+const APIKeyEnv = "PACKETEER_IXP_MANAGER_API_KEY"
+
+// apiKeyHeader is IXP Manager's v7.3 header. The query form (?apikey=)
+// is refused so the key cannot land in an access log.
+const apiKeyHeader = "X-IXP-Manager-API-Key"
+
+const (
+	keyPrefix = "ixpm_"
+	keyLen    = 56
+	identLen  = 12
+	secretLen = 32
+	crcLen    = 6
+)
+
+const base62 = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
+
+// parseAPIKey checks a v7.3 key and returns its identifier.
+// Legacy keys have no identifier; those are rejected so a log line cannot
+// carry a slice of the secret. The error text never includes the key.
+func parseAPIKey(key string) (string, error) {
+	if len(key) != keyLen || !strings.HasPrefix(key, keyPrefix) {
+		return "", errors.New("IXP Manager API key must be a v7.3 key (56 characters, ixpm_ prefix)")
+	}
+	payload := key[:keyLen-crcLen]
+	sum := key[keyLen-crcLen:]
+	got := crc32.ChecksumIEEE([]byte(payload))
+	want, err := base62Decode(sum)
+	if err != nil || got != uint32(want) {
+		return "", errors.New("IXP Manager API key checksum does not match")
+	}
+	parts := strings.Split(payload, "_")
+	if len(parts) != 3 || parts[0] != "ixpm" || len(parts[1]) != identLen || len(parts[2]) != secretLen ||
+		!base62Only(parts[1]) || !base62Only(parts[2]) {
+		return "", errors.New("IXP Manager API key must be a v7.3 key (12-character identifier, 32-character secret)")
+	}
+	return parts[1], nil
+}
+
+func base62Only(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if strings.IndexByte(base62, s[i]) < 0 {
+			return false
+		}
+	}
+	return true
+}
+
+func base62Decode(s string) (uint64, error) {
+	if len(s) != crcLen || !base62Only(s) {
+		return 0, errors.New("bad checksum")
+	}
+	var n uint64
+	for i := 0; i < len(s); i++ {
+		n = n*62 + uint64(strings.IndexByte(base62, s[i]))
+	}
+	if n > 0xffffffff {
+		return 0, errors.New("bad checksum")
+	}
+	return n, nil
+}
+
+// keySecret is the 32-character secret inside a v7.3-sized key.
+// The checksum is not required: a mistyped key can still be the secret
+// pasted into a URL. Empty when key does not have that shape.
+func keySecret(key string) string {
+	if len(key) != keyLen || !strings.HasPrefix(key, keyPrefix) {
+		return ""
+	}
+	return key[len(keyPrefix)+identLen+1 : keyLen-crcLen]
+}
+
+// redact removes the key and its secret from a message. A redirect or a
+// transport error can echo the request, and the secret must not be stored
+// on the view.
+func redact(msg, key string) string {
+	if key == "" || msg == "" {
+		return msg
+	}
+	ident := ""
+	if id, err := parseAPIKey(key); err == nil {
+		ident = id
+	}
+	msg = strings.ReplaceAll(msg, key, ident)
+	if esc := url.QueryEscape(key); esc != key {
+		msg = strings.ReplaceAll(msg, esc, ident)
+	}
+	if secret := keySecret(key); secret != "" {
+		msg = strings.ReplaceAll(msg, secret, ident)
+		if esc := url.QueryEscape(secret); esc != secret {
+			msg = strings.ReplaceAll(msg, esc, ident)
+		}
+	}
+	return msg
+}
diff --git a/internal/plugins/ixpmember/ixf/key_test.go b/internal/plugins/ixpmember/ixf/key_test.go
new file mode 100644
index 0000000..9689b35
--- /dev/null
+++ b/internal/plugins/ixpmember/ixf/key_test.go
@@ -0,0 +1,182 @@
+package ixf
+
+import (
+	"bytes"
+	"log/slog"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+// docKey is a v7.3-shaped vector. The checksum was computed with CRC-32/ISO-HDLC
+// (the same sum IXP Manager uses) of the 50-byte payload, then base62.
+// Identifier DocKeyIdent1, secret DocSecretDocSecretDocSecretDocSe.
+const (
+	docIdent  = "DocKeyIdent1"
+	docSecret = "DocSecretDocSecretDocSecretDocSe"
+	docKey    = "ixpm_DocKeyIdent1_DocSecretDocSecretDocSecretDocSe3DqwgX"
+)
+
+func TestParseAPIKey(t *testing.T) {
+	id, err := parseAPIKey(docKey)
+	if err != nil || id != docIdent {
+		t.Fatalf("id %q err %v", id, err)
+	}
+	if strings.Contains(docKey, docSecret) && len(docKey) != 56 {
+		t.Fatal("vector is not 56 characters")
+	}
+	flipped := docKey[:len(docKey)-1] + "Y"
+	if _, err := parseAPIKey(flipped); err == nil || strings.Contains(err.Error(), docSecret) || strings.Contains(err.Error(), flipped) {
+		t.Fatalf("flipped checksum: %v", err)
+	}
+	legacy := "LegacySecretLegacySecretLegacySecret12"
+	if _, err := parseAPIKey(legacy); err == nil || strings.Contains(err.Error(), legacy) || strings.Contains(err.Error(), "LegacySecret") {
+		t.Fatalf("legacy: %v", err)
+	}
+	short := docKey[:55]
+	if _, err := parseAPIKey(short); err == nil || strings.Contains(err.Error(), docSecret) {
+		t.Fatalf("short: %v", err)
+	}
+}
+
+func TestKeyExpiryEvents(t *testing.T) {
+	now := time.Date(2026, 10, 15, 12, 0, 0, 0, time.UTC)
+	cases := []struct {
+		days int
+		kind string
+		left string
+	}{
+		{15, plugin.EventIXPKeyOK, "15"},
+		{14, plugin.EventIXPKeyExpiring, "14"},
+		{0, plugin.EventIXPKeyExpiring, "0"},
+		{-3, plugin.EventIXPKeyExpiring, "-3"},
+	}
+	for _, tc := range cases {
+		var buf bytes.Buffer
+		log := slog.New(slog.NewTextHandler(&buf, nil))
+		s := build(t, managerYAML(now.AddDate(0, 0, tc.days).Format("2006-01-02")), docKey, log)
+		var got []plugin.Event
+		s.SetEventSink(func(e plugin.Event) { got = append(got, e) })
+		s.noteKey(now)
+		s.noteKey(now)
+		if len(got) != 1 || got[0].Kind != tc.kind {
+			t.Fatalf("days %d events %+v", tc.days, got)
+		}
+		if got[0].Fields["identifier"] != docIdent || got[0].Fields["days_left"] != tc.left {
+			t.Fatalf("days %d fields %v", tc.days, got[0].Fields)
+		}
+		text := buf.String() + got[0].Message
+		if !strings.Contains(text, docIdent) || strings.Contains(text, docSecret) || strings.Contains(text, docKey) {
+			t.Fatalf("days %d log %q", tc.days, text)
+		}
+	}
+}
+
+func TestKeyExpiryTransition(t *testing.T) {
+	now := time.Date(2026, 10, 15, 12, 0, 0, 0, time.UTC)
+	s := build(t, managerYAML(now.AddDate(0, 0, 15).Format("2006-01-02")), docKey, nil)
+	var kinds []string
+	s.SetEventSink(func(e plugin.Event) { kinds = append(kinds, e.Kind) })
+	s.noteKey(now)
+	s.noteKey(now.AddDate(0, 0, 1))
+	if strings.Join(kinds, ",") != plugin.EventIXPKeyOK+","+plugin.EventIXPKeyExpiring {
+		t.Fatalf("kinds %v", kinds)
+	}
+}
+
+func TestKeyConfigRules(t *testing.T) {
+	url := "https://ixp.example.invalid/api/v4/member-export/ixf/1.0"
+	if err := newErr(t, "url: "+url+"\n", docKey); err == nil || !strings.Contains(err.Error(), "key_expires is required") {
+		t.Fatalf("missing expiry: %v", err)
+	}
+	if err := newErr(t, "url: "+url+"\nkey_expires: \""+utcDay(10)+"\"\n", ""); err == nil || !strings.Contains(err.Error(), "key_expires is set") {
+		t.Fatalf("expiry without key: %v", err)
+	}
+	if err := newErr(t, "url: "+url+"\nkey_expires: \""+utcDay(367)+"\"\n", docKey); err == nil || !strings.Contains(err.Error(), "366") {
+		t.Fatalf("too far: %v", err)
+	}
+	for _, day := range []int{366, 0, -1} {
+		if err := newErr(t, "url: "+url+"\nkey_expires: \""+utcDay(day)+"\"\n", docKey); err != nil {
+			t.Fatalf("day %d: %v", day, err)
+		}
+	}
+	if err := newErr(t, "url: "+url+"\nkey_expires: \""+utcDay(10)+"\"\nextra: true\n", docKey); err == nil || !strings.Contains(err.Error(), "field extra not found") {
+		t.Fatalf("unknown field: %v", err)
+	}
+	quoted := build(t, "url: "+url+"\nkey_expires: \""+utcDay(20)+"\"\n", docKey, nil)
+	bare := build(t, "url: "+url+"\nkey_expires: "+utcDay(20)+"\n", docKey, nil)
+	stamp := time.Now().UTC().AddDate(0, 0, 20).Format(time.RFC3339)
+	rfc := build(t, "url: "+url+"\nkey_expires: \""+stamp+"\"\n", docKey, nil)
+	if quoted.expires.IsZero() || !quoted.expires.Equal(bare.expires) || !quoted.expires.Equal(rfc.expires) {
+		t.Fatalf("expires quoted %s bare %s rfc %s", quoted.expires, bare.expires, rfc.expires)
+	}
+	if quoted.keyID != docIdent {
+		t.Fatalf("key id %s", quoted.keyID)
+	}
+}
+
+func TestRefreshBounds(t *testing.T) {
+	base := "url: https://ixp.example.invalid/members.json\n"
+	s := build(t, base, "", nil)
+	if s.refresh != DefaultRefresh || s.http.Timeout != DefaultTimeout || s.maxBytes != DefaultMaxBytes {
+		t.Fatalf("defaults refresh %s timeout %s bytes %d", s.refresh, s.http.Timeout, s.maxBytes)
+	}
+	if err := newErr(t, base+"refresh: 30s\n", ""); err == nil {
+		t.Fatal("short refresh accepted")
+	}
+	if err := newErr(t, base+"refresh: 25h\n", ""); err == nil {
+		t.Fatal("long refresh accepted")
+	}
+	if err := newErr(t, base+"timeout: 500ms\n", ""); err == nil {
+		t.Fatal("short timeout accepted")
+	}
+	if err := newErr(t, base+"max_bytes: 512\n", ""); err == nil {
+		t.Fatal("small max_bytes accepted")
+	}
+	ok := build(t, base+"refresh: 1m\ntimeout: 2m\nmax_bytes: 1024\n", "", nil)
+	if ok.refresh != time.Minute || ok.http.Timeout != 2*time.Minute || ok.maxBytes != 1024 {
+		t.Fatalf("bounds refresh %s timeout %s bytes %d", ok.refresh, ok.http.Timeout, ok.maxBytes)
+	}
+}
+
+func managerYAML(day string) string {
+	return "url: https://ixp.example.invalid/api/v4/member-export/ixf/1.0\nkey_expires: \"" + day + "\"\n"
+}
+
+func utcDay(n int) string {
+	return time.Now().UTC().AddDate(0, 0, n).Format("2006-01-02")
+}
+
+func build(t *testing.T, yml, key string, log *slog.Logger) *Source {
+	t.Helper()
+	p, err := newPlugin(yml, key, log)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+func newErr(t *testing.T, yml, key string) error {
+	t.Helper()
+	_, err := newPlugin(yml, key, nil)
+	return err
+}
+
+func newPlugin(yml, key string, log *slog.Logger) (*Source, error) {
+	cfg, err := plugin.ConfigFromYAML(yml)
+	if err != nil {
+		return nil, err
+	}
+	p, err := New(cfg, plugin.Env{Logger: log, Getenv: func(k string) string {
+		if k == APIKeyEnv {
+			return key
+		}
+		return ""
+	}})
+	if err != nil {
+		return nil, err
+	}
+	return p.(*Source), nil
+}
diff --git a/internal/plugins/ixpmember/ixf/parse.go b/internal/plugins/ixpmember/ixf/parse.go
new file mode 100644
index 0000000..f2925c0
--- /dev/null
+++ b/internal/plugins/ixpmember/ixf/parse.go
@@ -0,0 +1,375 @@
+package ixf
+
+import (
+	"cmp"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/netip"
+	"slices"
+
+	"github.com/GrandArcher/Packeteer/pkg/plugin"
+)
+
+// Bounds on one document. A document past any of them is rejected whole;
+// nothing is truncated into the served list.
+const (
+	maxMembers     = 20000
+	maxIXPs        = 64
+	maxSwitches    = 4000
+	maxSwitchesIXP = 2000
+	maxConns       = 64
+	maxIfaces      = 64
+	maxVLANs       = 32
+	maxIXPVLANs    = 256
+	maxString      = 256
+)
+
+type parsed struct {
+	ixps      []plugin.IXPSite
+	members   []plugin.IXPMember
+	addresses int
+}
+
+type ixfDoc struct {
+	Version json.RawMessage `json:"version"`
+	IXPs    []ixfIXP        `json:"ixp_list"`
+	Members []ixfMember     `json:"member_list"`
+}
+
+type ixfIXP struct {
+	ID        int         `json:"ixp_id"`
+	Shortname string      `json:"shortname"`
+	Name      string      `json:"name"`
+	VLANs     []ixfVLAN   `json:"vlan"`
+	Switches  []ixfSwitch `json:"switch"`
+}
+
+type ixfVLAN struct {
+	ID   int     `json:"id"`
+	Name string  `json:"name"`
+	IPv4 *ixfPfx `json:"ipv4"`
+	IPv6 *ixfPfx `json:"ipv6"`
+}
+
+type ixfPfx struct {
+	Prefix string `json:"prefix"`
+	Mask   int    `json:"mask_length"`
+}
+
+type ixfSwitch struct {
+	ID           int    `json:"id"`
+	Name         string `json:"name"`
+	Colo         string `json:"colo"`
+	City         string `json:"city"`
+	Country      string `json:"country"`
+	Manufacturer string `json:"manufacturer"`
+	Model        string `json:"model"`
+	Software     string `json:"software"`
+}
+
+type ixfMember struct {
+	ASN         int64     `json:"asnum"`
+	Name        string    `json:"name"`
+	Connections []ixfConn `json:"connection_list"`
+}
+
+type ixfConn struct {
+	IXPID int      `json:"ixp_id"`
+	State string   `json:"state"`
+	Ifs   []ixfIf  `json:"if_list"`
+	VLANs []ixfMVL `json:"vlan_list"`
+}
+
+type ixfIf struct {
+	SwitchID int  `json:"switch_id"`
+	Speed    int  `json:"if_speed"`
+	Phys     *int `json:"if_phys_speed"`
+}
+
+type ixfMVL struct {
+	ID   int      `json:"vlan_id"`
+	IPv4 *ixfAddr `json:"ipv4"`
+	IPv6 *ixfAddr `json:"ipv6"`
+}
+
+type ixfAddr struct {
+	Address     string `json:"address"`
+	RouteServer bool   `json:"routeserver"`
+	ASMacro     string `json:"as_macro"`
+	MaxPrefix   int    `json:"max_prefix"`
+}
+
+type swInfo struct {
+	name string
+	colo string
+}
+
+// parseIXF reads an IX-F 1.0 document. Unknown JSON fields are ignored.
+// Contact email, phone, and MAC addresses are not copied. Errors name a
+// JSON path and do not include the field value.
+func parseIXF(body []byte) (parsed, error) {
+	var doc ixfDoc
+	if err := json.Unmarshal(body, &doc); err != nil {
+		return parsed{}, errors.New("member export: invalid JSON")
+	}
+	if string(doc.Version) != `"1.0"` {
+		return parsed{}, errors.New(`member export: version must be "1.0"`)
+	}
+	if len(doc.IXPs) > maxIXPs {
+		return parsed{}, fmt.Errorf("ixp_list: more than %d entries", maxIXPs)
+	}
+	if len(doc.Members) > maxMembers {
+		return parsed{}, fmt.Errorf("member_list: more than %d entries", maxMembers)
+	}
+	switches := map[int]map[int]swInfo{}
+	ixps := make([]plugin.IXPSite, 0, len(doc.IXPs))
+	totalSW := 0
+	for i, ix := range doc.IXPs {
+		p := fmt.Sprintf("ixp_list[%d]", i)
+		site, err := convIXP(p, ix)
+		if err != nil {
+			return parsed{}, err
+		}
+		if len(ix.Switches) > maxSwitchesIXP {
+			return parsed{}, fmt.Errorf("%s.switch: more than %d entries", p, maxSwitchesIXP)
+		}
+		totalSW += len(ix.Switches)
+		if totalSW > maxSwitches {
+			return parsed{}, fmt.Errorf("ixp_list: more than %d switches", maxSwitches)
+		}
+		byID := map[int]swInfo{}
+		for _, sw := range site.Switches {
+			if _, ok := byID[sw.ID]; !ok {
+				byID[sw.ID] = swInfo{name: sw.Name, colo: sw.Colo}
+			}
+		}
+		switches[site.ID] = byID
+		ixps = append(ixps, site)
+	}
+	slices.SortStableFunc(ixps, func(a, b plugin.IXPSite) int { return cmp.Compare(a.ID, b.ID) })
+
+	members := make([]plugin.IXPMember, 0, len(doc.Members))
+	addrs := 0
+	for i, m := range doc.Members {
+		p := fmt.Sprintf("member_list[%d]", i)
+		mem, n, err := convMember(p, m, switches)
+		if err != nil {
+			return parsed{}, err
+		}
+		addrs += n
+		members = append(members, mem)
+	}
+	slices.SortStableFunc(members, func(a, b plugin.IXPMember) int {
+		if a.ASN != b.ASN {
+			return cmp.Compare(a.ASN, b.ASN)
+		}
+		return cmp.Compare(a.Name, b.Name)
+	})
+	return parsed{ixps: ixps, members: members, addresses: addrs}, nil
+}
+
+func convIXP(p string, in ixfIXP) (plugin.IXPSite, error) {
+	if in.ID < 0 {
+		return plugin.IXPSite{}, fmt.Errorf("%s.ixp_id is negative", p)
+	}
+	if err := clip(p+".shortname", in.Shortname); err != nil {
+		return plugin.IXPSite{}, err
+	}
+	if err := clip(p+".name", in.Name); err != nil {
+		return plugin.IXPSite{}, err
+	}
+	if len(in.VLANs) > maxIXPVLANs {
+		return plugin.IXPSite{}, fmt.Errorf("%s.vlan: more than %d entries", p, maxIXPVLANs)
+	}
+	vlans := make([]plugin.IXPVLAN, 0, len(in.VLANs))
+	for i, v := range in.VLANs {
+		vp := fmt.Sprintf("%s.vlan[%d]", p, i)
+		if err := clip(vp+".name", v.Name); err != nil {
+			return plugin.IXPSite{}, err
+		}
+		out := plugin.IXPVLAN{ID: v.ID, Name: v.Name}
+		var err error
+		if out.IPv4, err = convPfx(vp+".ipv4", v.IPv4, 32); err != nil {
+			return plugin.IXPSite{}, err
+		}
+		if out.IPv6, err = convPfx(vp+".ipv6", v.IPv6, 128); err != nil {
+			return plugin.IXPSite{}, err
+		}
+		vlans = append(vlans, out)
+	}
+	slices.SortStableFunc(vlans, func(a, b plugin.IXPVLAN) int { return cmp.Compare(a.ID, b.ID) })
+	sws := make([]plugin.IXPSwitch, 0, len(in.Switches))
+	for i, s := range in.Switches {
+		sp := fmt.Sprintf("%s.switch[%d]", p, i)
+		if s.ID < 0 {
+			return plugin.IXPSite{}, fmt.Errorf("%s.id is negative", sp)
+		}
+		for _, pair := range []struct{ path, val string }{
+			{sp + ".name", s.Name}, {sp + ".colo", s.Colo}, {sp + ".city", s.City},
+			{sp + ".country", s.Country}, {sp + ".manufacturer", s.Manufacturer},
+			{sp + ".model", s.Model}, {sp + ".software", s.Software},
+		} {
+			if err := clip(pair.path, pair.val); err != nil {
+				return plugin.IXPSite{}, err
+			}
+		}
+		sws = append(sws, plugin.IXPSwitch{
+			ID: s.ID, Name: s.Name, Colo: s.Colo, City: s.City, Country: s.Country,
+			Manufacturer: s.Manufacturer, Model: s.Model, Software: s.Software,
+		})
+	}
+	slices.SortStableFunc(sws, func(a, b plugin.IXPSwitch) int { return cmp.Compare(a.ID, b.ID) })
+	return plugin.IXPSite{ID: in.ID, Shortname: in.Shortname, Name: in.Name, VLANs: vlans, Switches: sws}, nil
+}
+
+func convPfx(p string, in *ixfPfx, bits int) (string, error) {
+	if in == nil {
+		return "", nil
+	}
+	if err := clip(p+".prefix", in.Prefix); err != nil {
+		return "", err
+	}
+	a, err := netip.ParseAddr(in.Prefix)
+	if err != nil || a.Zone() != "" || a.BitLen() != bits {
+		return "", fmt.Errorf("%s.prefix is not an IP address", p)
+	}
+	if in.Mask < 0 || in.Mask > bits {
+		return "", fmt.Errorf("%s.mask_length is invalid", p)
+	}
+	// Unmap before PrefixFrom. An IPv4-mapped address in the IPv6 object
+	// becomes IPv4: a mask above 32 is not a valid prefix, and a mask of
+	// 0-32 would be stored as an IPv4 CIDR on the IPv6 field. convAddr
+	// rejects that address.
+	pfx := netip.PrefixFrom(a.Unmap(), in.Mask).Masked()
+	if !pfx.IsValid() || pfx.Addr().BitLen() != bits {
+		return "", fmt.Errorf("%s.prefix is not an IP address", p)
+	}
+	return pfx.String(), nil
+}
+
+func convMember(p string, in ixfMember, switches map[int]map[int]swInfo) (plugin.IXPMember, int, error) {
+	if in.ASN <= 0 || in.ASN > 0xffffffff {
+		return plugin.IXPMember{}, 0, fmt.Errorf("%s.asnum is invalid", p)
+	}
+	if err := clip(p+".name", in.Name); err != nil {
+		return plugin.IXPMember{}, 0, err
+	}
+	if len(in.Connections) > maxConns {
+		return plugin.IXPMember{}, 0, fmt.Errorf("%s.connection_list: more than %d entries", p, maxConns)
+	}
+	conns := make([]plugin.IXPConnection, 0, len(in.Connections))
+	addrs := 0
+	for i, c := range in.Connections {
+		cp := fmt.Sprintf("%s.connection_list[%d]", p, i)
+		conn, n, err := convConn(cp, c, switches)
+		if err != nil {
+			return plugin.IXPMember{}, 0, err
+		}
+		addrs += n
+		conns = append(conns, conn)
+	}
+	slices.SortStableFunc(conns, func(a, b plugin.IXPConnection) int { return cmp.Compare(a.IXPID, b.IXPID) })
+	return plugin.IXPMember{ASN: uint32(in.ASN), Name: in.Name, Connections: conns}, addrs, nil
+}
+
+func convConn(p string, in ixfConn, switches map[int]map[int]swInfo) (plugin.IXPConnection, int, error) {
+	if err := clip(p+".state", in.State); err != nil {
+		return plugin.IXPConnection{}, 0, err
+	}
+	if len(in.Ifs) > maxIfaces {
+		return plugin.IXPConnection{}, 0, fmt.Errorf("%s.if_list: more than %d entries", p, maxIfaces)
+	}
+	if len(in.VLANs) > maxVLANs {
+		return plugin.IXPConnection{}, 0, fmt.Errorf("%s.vlan_list: more than %d entries", p, maxVLANs)
+	}
+	ifaces := make([]plugin.IXPInterface, 0, len(in.Ifs))
+	for i, iface := range in.Ifs {
+		ip := fmt.Sprintf("%s.if_list[%d]", p, i)
+		if iface.SwitchID < 0 {
+			return plugin.IXPConnection{}, 0, fmt.Errorf("%s.switch_id is negative", ip)
+		}
+		if iface.Speed < 0 {
+			return plugin.IXPConnection{}, 0, fmt.Errorf("%s.if_speed is negative", ip)
+		}
+		if iface.Phys != nil && *iface.Phys < 0 {
+			return plugin.IXPConnection{}, 0, fmt.Errorf("%s.if_phys_speed is negative", ip)
+		}
+		out := plugin.IXPInterface{SwitchID: iface.SwitchID, SpeedMbps: iface.Speed, PhysSpeedMbps: iface.Phys}
+		// switch_id is only meaningful on this connection's IXP. The same
+		// id on another IXP is a different switch, and map iteration would
+		// pick one of them at random.
+		if info, ok := switches[in.IXPID][iface.SwitchID]; ok {
+			out.Switch = info.name
+			out.Colo = info.colo
+		}
+		ifaces = append(ifaces, out)
+	}
+	slices.SortStableFunc(ifaces, func(a, b plugin.IXPInterface) int { return cmp.Compare(a.SwitchID, b.SwitchID) })
+	addresses := make([]plugin.IXPAddress, 0)
+	for i, v := range in.VLANs {
+		vp := fmt.Sprintf("%s.vlan_list[%d]", p, i)
+		for _, fam := range []struct {
+			name string
+			addr *ixfAddr
+		}{{"ipv4", v.IPv4}, {"ipv6", v.IPv6}} {
+			if fam.addr == nil {
+				continue
+			}
+			ap := vp + "." + fam.name
+			a, err := convAddr(ap, fam.name, v.ID, fam.addr)
+			if err != nil {
+				return plugin.IXPConnection{}, 0, err
+			}
+			addresses = append(addresses, a)
+		}
+	}
+	slices.SortStableFunc(addresses, func(a, b plugin.IXPAddress) int {
+		if a.VLANID != b.VLANID {
+			return cmp.Compare(a.VLANID, b.VLANID)
+		}
+		if a.Family != b.Family {
+			return cmp.Compare(a.Family, b.Family)
+		}
+		return cmp.Compare(a.Address, b.Address)
+	})
+	return plugin.IXPConnection{IXPID: in.IXPID, State: in.State, Interfaces: ifaces, Addresses: addresses}, len(addresses), nil
+}
+
+func convAddr(p, family string, vlan int, in *ixfAddr) (plugin.IXPAddress, error) {
+	if err := clip(p+".address", in.Address); err != nil {
+		return plugin.IXPAddress{}, err
+	}
+	if err := clip(p+".as_macro", in.ASMacro); err != nil {
+		return plugin.IXPAddress{}, err
+	}
+	if in.MaxPrefix < 0 {
+		return plugin.IXPAddress{}, fmt.Errorf("%s.max_prefix is negative", p)
+	}
+	a, err := netip.ParseAddr(in.Address)
+	if err != nil || a.Zone() != "" {
+		return plugin.IXPAddress{}, fmt.Errorf("%s.address is not an IP address", p)
+	}
+	a = a.Unmap()
+	switch family {
+	case "ipv4":
+		if !a.Is4() {
+			return plugin.IXPAddress{}, fmt.Errorf("%s.address is not an IPv4 address", p)
+		}
+	case "ipv6":
+		if !a.Is6() {
+			return plugin.IXPAddress{}, fmt.Errorf("%s.address is not an IPv6 address", p)
+		}
+	}
+	return plugin.IXPAddress{
+		Family: family, Address: a.String(), VLANID: vlan,
+		RouteServer: in.RouteServer, MaxPrefix: in.MaxPrefix, ASMacro: in.ASMacro,
+	}, nil
+}
+
+func clip(path, s string) error {
+	if len(s) > maxString {
+		return fmt.Errorf("%s is longer than %d bytes", path, maxString)
+	}
+	return nil
+}
