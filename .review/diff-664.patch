+#!/bin/bash
+# Registry hygiene (#289) proved in the lab (#657) against in-lab registry
+# stand-ins only. Documentation prefixes and documentation/private ASNs
+# only. lab/registrystub is the IRR (whois), VRP JSON, PeeringDB, and RIPE
+# REST stand-in; the lab network is internal, so nothing can reach RADB,
+# ARIN, RIPE, PeeringDB, or any other public registry. Packeteer runs in
+# observe mode.
+#
+# transit-a sends the edge 203.0.113.0/24 and 203.0.113.128/25 from AS64501.
+# The stand-in registers only the /24 (and a 192.0.2.0/24 route object that
+# nobody announces), has a ROA for the /24 with maxLength 24, lists one
+# prefix in PeeringDB where two are announced, and lists a 1000 Mbps port
+# where the config says 10000. Checked:
+#  - the network is internal, and the stand-in is the only registry the
+#    scan reads (every stand-in request is whois, PeeringDB, the VRP
+#    document, or the RIPE REST API; none is a write before a push);
+#  - the first scan reports exactly: a missing route object, a stale route
+#    object (shown, not yet offered for delete), a ROA gap (maxLength), a
+#    PeeringDB max-prefix drift, and a PeeringDB port-speed drift;
+#  - a push with a digest other than the shown one is refused and changes
+#    nothing; with the shown digest, the route object and the two PeeringDB
+#    fields change on the stand-in, with the lab credentials from the
+#    environment, and each push is in the audit log without a credential;
+#  - a ROA finding and the not-yet-offered delete cannot be pushed;
+#  - the edge receives no route from Packeteer, the mode stays observe, and
+#    SIGTERM stops it cleanly.
+set -euo pipefail
+
+root=$(cd "$(dirname "$0")/.." && pwd)
+cd "$root"
+compose=(docker compose -f lab/docker-compose-registry.yml)
+
+check_bin=$(mktemp)
+LAB_DIR=$(mktemp -d)
+export LAB_DIR
+trap 'rc=$?; if [ "$rc" -ne 0 ]; then echo "---- lab logs ----"; "${compose[@]}" logs --no-color || true; "${compose[@]}" ps || true; fi; "${compose[@]}" down -v --remove-orphans || true; rm -rf "$check_bin" "$LAB_DIR"; exit "$rc"' EXIT
+
+echo "building the path check, the registry stand-in, and the lab certificate"
+go build -o "$check_bin" ./lab/checkpath
+mkdir -p "$LAB_DIR/stub" "$LAB_DIR/certs"
+CGO_ENABLED=0 GOOS=linux GOARCH="$(go env GOARCH)" go build -o "$LAB_DIR/stub/registrystub" ./lab/registrystub
+certs_bin=$(mktemp)
+go build -o "$certs_bin" ./lab/mkcerts
+"$certs_bin" "$LAB_DIR/certs" registry-stub
+rm -f "$certs_bin"
+# The containers read these as other users; the keys protect nothing.
+chmod 755 "$LAB_DIR" "$LAB_DIR/stub" "$LAB_DIR/certs" "$LAB_DIR/stub/registrystub"
+
+echo "building lab"
+"${compose[@]}" build
+"${compose[@]}" up -d
+
+base=http://192.0.2.10:8080/api
+stub=http://192.0.2.40:8323/_lab/state
+new_net=203.0.113.128/25
+all_net=203.0.113.0/24
+
+# Lab-only basic auth (docker-compose-registry.yml): the admin that may push.
+auth=(-u lab:lab-only)
+api() { curl -sS "${auth[@]}" "$base/$1" 2>/dev/null || true; }
+api_up() { curl -sf -o /dev/null "${auth[@]}" "$base/registry"; }
+post() { curl -sS -w '\n%{http_code}' "${auth[@]}" -H 'Content-Type: application/json' -d "$2" "$base/$1"; }
+state() { curl -sS "$stub" 2>/dev/null || true; }
+
+vty() { "${compose[@]}" exec -T edge vtysh -c "$1" 2>/dev/null || true; }
+edge_path() {
+	vty "show bgp ipv4 unicast $1 json" | "$check_bin" -aspath "$2" -nexthop 192.0.2.21 -lacks 64512:
+}
+session_up() { [[ "$(vty 'show bgp neighbors 192.0.2.10')" == *"BGP state = Established"* ]]; }
+
+received() {
+	local s r
+	s=$(vty 'show bgp ipv4 unicast summary json' | jq -r '(.ipv4Unicast.peers // .peers)["192.0.2.10"].pfxRcd // empty' 2>/dev/null || true)
+	r=$(vty 'show bgp ipv4 unicast neighbors 192.0.2.10 received-routes json' | jq -r '(.receivedRoutes // {}) | length' 2>/dev/null || true)
+	echo "${s:-?}/${r:-?}"
+}
+only_transit() {
+	vty 'show bgp ipv4 unicast json' | jq -e '[.routes[][] | .peerId] | length > 0 and all(. == "192.0.2.21")' >/dev/null 2>&1
+}
+
+dump() {
+	for r in edge transit-a; do
+		echo "---- $r ----" >&2
+		"${compose[@]}" exec -T "$r" vtysh -c 'show bgp summary' -c 'show bgp ipv4 unicast' >&2 || true
+	done
+	echo "---- registry ----" >&2
+	api registry >&2
+	echo "---- stand-in state ----" >&2
+	state >&2
+	"${compose[@]}" logs --no-color packeteer registry-stub >&2 || true
+}
+
+# quiet: observe sends the edge nothing. Checked on every sample once the
+# session is up.
+quiet() {
+	local n
+	n=$(received)
+	if [ "$n" != "0/0" ] || ! only_transit; then
+		echo "the edge received routes from Packeteer (pfxRcd/received-routes $n)" >&2
+		vty 'show bgp ipv4 unicast neighbors 192.0.2.10 received-routes' >&2
+		dump
+		exit 1
+	fi
+}
+
+checked=0
+wait_for() {
+	local secs=$1 what=$2
+	shift 2
+	local end=$((SECONDS + secs))
+	while [ "$SECONDS" -lt "$end" ]; do
+		if [ "$checked" = 1 ]; then quiet; fi
+		if "$@" 2>/dev/null; then
+			return 0
+		fi
+		sleep 2
+	done
+	echo "timed out after ${secs}s waiting for: $what" >&2
+	"$@" || true
+	dump
+	return 1
+}
+
+fail() {
+	echo "$1" >&2
+	dump
+	exit 1
+}
+
+echo "the lab network has no route out"
+net=$("${compose[@]}" ps -q packeteer | xargs docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}')
+[ "$(wc -w <<<"$net")" = 1 ] || fail "packeteer is on more than one network: $net"
+[ "$(docker network inspect -f '{{.Internal}}' "${net// /}")" = true ] || fail "network $net is not internal"
+for svc in packeteer registry-stub edge transit-a; do
+	[ "$("${compose[@]}" ps -q "$svc" | xargs docker inspect -f '{{len .NetworkSettings.Networks}}')" = 1 ] || fail "$svc is on more than one network"
+done
+
+echo "waiting for the edge paths, the Packeteer session, and the stand-in"
+wait_for 120 "edge path for $all_net" edge_path "$all_net" "64496 64501"
+wait_for 60 "edge path for $new_net" edge_path "$new_net" "64496 64501"
+wait_for 120 "packeteer session" session_up
+wait_for 60 "ops API" api_up
+wait_for 60 "registry stand-in" bash -c "curl -sf -o /dev/null $stub"
+checked=1
+quiet
+
+learned() {
+	api "troubleshoot/lookingglass?prefix=$1" | jq -e --arg p "$1" \
+		'.exact.prefix == $p and .exact.as_path[-1] == 64501 and .exact.provider == "transit-a"' >/dev/null
+}
+wait_for 60 "packeteer learned $all_net" learned "$all_net"
+wait_for 60 "packeteer learned $new_net" learned "$new_net"
+
+# The first scan runs a minute after start.
+scanned() { api registry | jq -e '.scanned != null and (.sections | length) > 0' >/dev/null; }
+echo "waiting for the first scan"
+wait_for 240 "the first registry scan" scanned
+# The scan runs a minute after Packeteer starts and the next one an hour
+# later. A slow runner can start it before the learned RIB is ready; the
+# scan then skips the network, and a restart gives a new first scan.
+for _ in 1 2; do
+	api registry | jq -e '[.sections[] | select(.name == "network" and .status == "skipped")] | length == 0' >/dev/null && break
+	echo "the first scan ran before the RIB was ready; restarting packeteer for a new first scan"
+	"${compose[@]}" restart -t 20 packeteer
+	wait_for 120 "packeteer session" session_up
+	wait_for 60 "ops API" api_up
+	wait_for 60 "packeteer learned $all_net" learned "$all_net"
+	wait_for 60 "packeteer learned $new_net" learned "$new_net"
+	wait_for 240 "the new first registry scan" scanned
+done
+
+rep=$(api registry)
+jq -e '.push_enabled == true' <<<"$rep" >/dev/null || fail "push_enabled is not on in the lab config"
+jq -e '[.sections[] | select(.name == "irr" or .name == "rpki" or .name == "peeringdb")] | length == 3 and all(.status == "ok")' <<<"$rep" >/dev/null ||
+	fail "an IRR, RPKI, or PeeringDB section is not ok: $(jq -c .sections <<<"$rep")"
+
+want='["irr_missing | 203.0.113.128/25 AS64501","irr_stale | 192.0.2.0/24 AS64501 TEST","pdb_ix_speed | AS64501 ix-lab 198.51.100.130 speed","pdb_maxprefix | AS64501 info_prefixes4","rpki_maxlength | 203.0.113.128/25 AS64501"]'
+got=$(jq -c '[.findings[] | .kind + " | " + .subject] | sort' <<<"$rep")
+[ "$got" = "$want" ] || fail "findings are $got, want $want"
+f() { jq -c --arg k "$1" '.findings[] | select(.kind == $k)' <<<"$rep"; }
+
+echo "the diffs"
+f irr_missing | jq -e '.severity == "warning" and .pushable == true and (.digest | length > 0) and .change.op == "create_object" and .change.class == "route" and
+	(.diff | contains("+ route:") and contains("203.0.113.128/25") and contains("origin:         AS64501") and contains("mnt-by:         MAINT-LAB") and contains("source:         TEST"))' >/dev/null ||
+	fail "irr_missing: $(f irr_missing)"
+f irr_stale | jq -e '(.diff | contains("- route:          192.0.2.0/24") and contains("AS64501")) and .pushable == false and .change == null and (.note | contains("next scan"))' >/dev/null ||
+	fail "irr_stale: $(f irr_stale)"
+f rpki_maxlength | jq -e '.severity == "error" and .pushable == false and .change == null and (.message | contains("203.0.113.0/24") and contains("/24")) and
+	(.diff | contains("maxLength 24") and contains("maxLength 25"))' >/dev/null || fail "rpki_maxlength: $(f rpki_maxlength)"
+f pdb_maxprefix | jq -e '.pushable == true and .change.op == "update_field" and .change.field == "info_prefixes4" and .change.old == "1" and .change.new == "3" and
+	(.diff | contains("- info_prefixes4: 1") and contains("+ info_prefixes4: 3"))' >/dev/null || fail "pdb_maxprefix: $(f pdb_maxprefix)"
+f pdb_ix_speed | jq -e '.pushable == true and .change.op == "update_field" and .change.class == "netixlan" and .change.field == "speed" and .change.old == "1000" and .change.new == "10000" and
+	(.diff | contains("- speed: 1000") and contains("+ speed: 10000"))' >/dev/null || fail "pdb_ix_speed: $(f pdb_ix_speed)"
+
+echo "the scan only read the stand-in"
+st=$(state)
+jq -e '.requests | length > 0 and all(.service == "whois" or .service == "peeringdb" or .service == "vrp" or .service == "ripe")' <<<"$st" >/dev/null || fail "unexpected stand-in traffic: $st"
+jq -e '[.requests[] | select(.method != "GET" and .method != "QUERY")] | length == 0' <<<"$st" >/dev/null || fail "the scan wrote to the stand-in: $st"
+jq -e '[.requests[].service] | index("whois") != null and index("peeringdb") != null and index("vrp") != null' <<<"$st" >/dev/null || fail "the scan did not read all three stand-ins: $st"
+routes_before=$(jq -c .routes <<<"$st")
+jq -e '.peeringdb["net/1"].info_prefixes4 == 1 and .peeringdb["netixlan/11"].speed == 1000' <<<"$st" >/dev/null || fail "unexpected stand-in data: $st"
+
+push() { post registry/push "{\"id\":\"$1\",\"digest\":\"$2\"}"; }
+code_of() { tail -n1 <<<"$1"; }
+
+echo "a wrong digest, a ROA, and the not-yet-offered delete change nothing"
+id_missing=$(f irr_missing | jq -r .id)
+digest_missing=$(f irr_missing | jq -r .digest)
+resp=$(push "$id_missing" 0000000000000000)
+[ "$(code_of "$resp")" = 409 ] || fail "a wrong digest answered $(code_of "$resp"): $resp"
+resp=$(push "$(f rpki_maxlength | jq -r .id)" "")
+[ "$(code_of "$resp")" = 409 ] || fail "a ROA finding answered $(code_of "$resp"): $resp"
+resp=$(push "$(f irr_stale | jq -r .id)" "")
+[ "$(code_of "$resp")" = 409 ] || fail "the stale delete answered $(code_of "$resp"): $resp"
+st=$(state)
+jq -e '[.requests[] | select(.method != "GET" and .method != "QUERY")] | length == 0' <<<"$st" >/dev/null || fail "a refused push wrote to the stand-in: $st"
+[ "$(jq -c .routes <<<"$st")" = "$routes_before" ] || fail "a refused push changed the route objects"
+
+echo "confirmed pushes reach the stand-in with the lab credentials"
+resp=$(push "$id_missing" "$digest_missing")
+[ "$(code_of "$resp")" = 200 ] || fail "the route object push answered $(code_of "$resp"): $resp"
+for kind in pdb_maxprefix pdb_ix_speed; do
+	resp=$(push "$(f "$kind" | jq -r .id)" "$(f "$kind" | jq -r .digest)")
+	[ "$(code_of "$resp")" = 200 ] || fail "the $kind push answered $(code_of "$resp"): $resp"
+done
+resp=$(push "$id_missing" "$digest_missing")
+[ "$(code_of "$resp")" = 409 ] || fail "the same change pushed twice answered $(code_of "$resp"): $resp"
+
+st=$(state)
+jq -e '.routes | length == 3 and (map(select(contains("route:          203.0.113.128/25") and contains("origin:         AS64501") and contains("source:         TEST"))) | length == 1) and
+	(map(select(contains("192.0.2.0/24"))) | length == 1)' <<<"$st" >/dev/null || fail "route objects after the pushes: $(jq -c .routes <<<"$st")"
+jq -e '.peeringdb["net/1"].info_prefixes4 == 3 and .peeringdb["netixlan/11"].speed == 10000' <<<"$st" >/dev/null || fail "PeeringDB records after the pushes: $(jq -c .peeringdb <<<"$st")"
+jq -e '[.requests[] | select(.method != "GET" and .method != "QUERY")] | length == 3 and all(.authorized == true) and
+	(map(.service) | sort == ["peeringdb", "peeringdb", "ripe"]) and (map(.method) | sort == ["POST", "PUT", "PUT"])' <<<"$st" >/dev/null || fail "stand-in writes: $(jq -c '[.requests[] | select(.method != "GET" and .method != "QUERY")]' <<<"$st")"
+
+echo "audit log: each push, no credential"
+audit=$(api "audit?limit=1000")
+jq -e 'any(.records[]; .action == "POST /api/registry/push" and .result == "ok" and .target == "ripe route 203.0.113.128/25AS64501" and (.detail | contains("registry push create_object") and contains("203.0.113.128/25")))' <<<"$audit" >/dev/null ||
+	fail "no audit record for the route object push: $audit"
+jq -e 'any(.records[]; .action == "POST /api/registry/push" and .result == "ok" and (.detail | contains("registry push update_field info_prefixes4: 1 -> 3")))' <<<"$audit" >/dev/null ||
+	fail "no audit record for the max-prefix push: $audit"
+jq -e 'any(.records[]; .action == "POST /api/registry/push" and .result == "ok" and (.detail | contains("registry push update_field speed: 1000 -> 10000")))' <<<"$audit" >/dev/null ||
+	fail "no audit record for the port-speed push: $audit"
+jq -e 'any(.records[]; .action == "POST /api/registry/push" and .result == "failed" and (.detail | contains("differs from the one shown")))' <<<"$audit" >/dev/null ||
+	fail "no audit record for the refused digest: $audit"
+for secret in lab-ripe-password-not-a-secret lab-peeringdb-key-not-a-secret; do
+	if grep -q "$secret" <<<"$audit$(api registry)"; then fail "the audit log or the API holds a credential"; fi
+	if "${compose[@]}" logs --no-color packeteer | grep -q "$secret"; then fail "the Packeteer log holds a credential"; fi
+done
+
+quiet
+api overview | jq -e '.mode == "observe"' >/dev/null || fail "packeteer is not in observe mode"
+
+echo "SIGTERM: packeteer stops cleanly"
+"${compose[@]}" stop -t 20 packeteer
+code=$(docker inspect -f '{{.State.ExitCode}}' "$("${compose[@]}" ps -aq packeteer)")
+[ "$code" = 0 ] || fail "packeteer exited $code on SIGTERM"
+only_transit || fail "the edge holds a route that did not come from transit-a"
+
+echo "registry hygiene lab passed"
diff --git a/lab/packeteer-registry.yaml b/lab/packeteer-registry.yaml
new file mode 100644
index 00000000..7121d18e
--- /dev/null
+++ b/lab/packeteer-registry.yaml
@@ -0,0 +1,70 @@
+# Lab only (#657). Documentation prefixes and ASNs. Observe: nothing is
+# announced. Registry hygiene reads the learned RIB from the edge and
+# compares it with the in-lab registry stand-in (lab/registrystub): its
+# whois IRR, VRP JSON, PeeringDB, and RIPE REST API. Every registry address
+# below is the stand-in; the lab network has no route out. push_enabled is
+# on for the stand-in only. The lab credentials are in the compose file.
+mode: observe
+asn: 64512
+router_id: 192.0.2.10
+providers:
+  - name: transit-a
+    source_ip: 192.0.2.11
+    next_hop: 192.0.2.21
+exchanges:
+  - name: ix-lab
+    lans: [198.51.100.0/24]
+    local_lan_addrs: [198.51.100.130]
+    port: {capacity_mbps: 10000}
+    peers:
+      - {name: ix-peer-a, asn: 64502, next_hop: 198.51.100.131, source_ip: 192.0.2.32}
+bgp:
+  neighbors:
+    - address: 192.0.2.254
+      description: edge
+      add_path: true
+http:
+  listen: 0.0.0.0:8080
+storage:
+  type: sqlite
+  config:
+    path: /var/lib/packeteer/data/packeteer.db
+irr:
+  enabled: true
+  sources:
+    - type: whois
+      name: lab-irr
+      config:
+        address: "registry-stub:43"
+        dialect: ripe
+        databases: [TEST]
+        rate_per_minute: 600
+rpki:
+  enabled: true
+  sources:
+    - type: json
+      name: lab-vrp
+      config:
+        url: "http://registry-stub:8323/json"
+# Only the exchange id comes from here (registry.md); its base_url is the
+# stand-in as well.
+lookup:
+  type: peeringdb
+  config:
+    base_url: "https://registry-stub:8443/peeringdb"
+    exchanges:
+      - {name: ix-lab, ix_id: 7}
+registry:
+  enabled: true
+  asns: [64501]
+  irr: {source: TEST, mnt_by: MAINT-LAB}
+  push_enabled: true
+  sources:
+    - type: peeringdb
+      config: {base_url: "https://registry-stub:8443/peeringdb"}
+    - type: ripe
+      config: {base_url: "https://registry-stub:8443/ripe", source: TEST}
+# Lab only: no sign-in; the e2e script uses the basic-auth account, which
+# is the admin that may push.
+auth:
+  enabled: false
diff --git a/lab/registrystub/lab_test.go b/lab/registrystub/lab_test.go
new file mode 100644
index 00000000..d965314e
--- /dev/null
+++ b/lab/registrystub/lab_test.go
@@ -0,0 +1,115 @@
+package main
+
+import (
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"gopkg.in/yaml.v3"
+
+	"github.com/GrandArcher/Packeteer/internal/config"
+	"github.com/GrandArcher/Packeteer/internal/pluginhost"
+	_ "github.com/GrandArcher/Packeteer/internal/plugins/all"
+)
+
+const standIn = "registry-stub"
+
+// #657: the lab config builds with the real plugins, stays in observe, and
+// every registry it names is the stand-in, with no credential in the file.
+func TestLabConfigOnlyNamesTheStandIn(t *testing.T) {
+	path := filepath.Join("..", "packeteer-registry.yaml")
+	cfg, err := config.Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Mode != "observe" || !cfg.RegistryOn() || !cfg.Registry.PushEnabled {
+		t.Fatalf("mode %q registry %v push %v", cfg.Mode, cfg.RegistryOn(), cfg.Registry.PushEnabled)
+	}
+	set, err := pluginhost.Build(cfg, pluginhost.Options{Getenv: getenv, CheckOnly: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(set.IRRSources) != 1 || len(set.RegistryCheckers) != 2 {
+		t.Fatalf("irr sources %d, registry sources %d", len(set.IRRSources), len(set.RegistryCheckers))
+	}
+
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var doc map[string]any
+	if err := yaml.Unmarshal(raw, &doc); err != nil {
+		t.Fatal(err)
+	}
+	var hosts []string
+	var walk func(k string, v any)
+	walk = func(k string, v any) {
+		switch v := v.(type) {
+		case map[string]any:
+			for k, x := range v {
+				walk(k, x)
+			}
+		case []any:
+			for _, x := range v {
+				walk(k, x)
+			}
+		case string:
+			// A whois address has a port; a BGP neighbor address does not.
+			if k == "base_url" || k == "url" || k == "address" && strings.Contains(v, ":") {
+				host := v
+				if u, err := url.Parse(v); err == nil && u.Host != "" {
+					host = u.Host
+				}
+				hosts = append(hosts, strings.Split(host, ":")[0])
+			}
+		}
+	}
+	walk("", doc)
+	if len(hosts) != 5 {
+		t.Fatalf("registry addresses in the lab config: %v", hosts)
+	}
+	for _, h := range hosts {
+		if h != standIn {
+			t.Errorf("the lab config names %q, not the stand-in", h)
+		}
+	}
+	for _, secret := range []string{labPass, labKey} {
+		if strings.Contains(string(raw), secret) {
+			t.Errorf("the lab config holds a credential")
+		}
+	}
+}
+
+// The lab network has no route out, no service publishes a port, and every
+// service is on that one network.
+func TestLabComposeIsInternal(t *testing.T) {
+	raw, err := os.ReadFile(filepath.Join("..", "docker-compose-registry.yml"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var doc struct {
+		Services map[string]struct {
+			Ports    []any `yaml:"ports"`
+			Networks map[string]any
+		} `yaml:"services"`
+		Networks map[string]struct {
+			Internal bool `yaml:"internal"`
+		} `yaml:"networks"`
+	}
+	if err := yaml.Unmarshal(raw, &doc); err != nil {
+		t.Fatal(err)
+	}
+	if len(doc.Networks) != 1 || !doc.Networks["lab"].Internal {
+		t.Fatalf("networks %+v", doc.Networks)
+	}
+	if len(doc.Services) != 4 {
+		t.Fatalf("services %d", len(doc.Services))
+	}
+	for name, s := range doc.Services {
+		if len(s.Ports) != 0 || len(s.Networks) != 1 {
+			t.Errorf("%s: ports %v networks %v", name, s.Ports, s.Networks)
+		}
+	}
+}
diff --git a/lab/registrystub/main.go b/lab/registrystub/main.go
new file mode 100644
index 00000000..13c3e7bc
--- /dev/null
+++ b/lab/registrystub/main.go
@@ -0,0 +1,407 @@
+// Command registrystub is the in-lab registry stand-in for lab/e2e-registry.sh
+// (#657): a whois IRR (RIPE dialect), the RIPE database REST API, PeeringDB,
+// and a VRP JSON document, all answering from fixed data about documentation
+// prefixes and documentation ASNs. It dials nothing and holds no real
+// registry data. Writes are accepted only with the lab credentials, which
+// come from the environment, and every request is recorded without its
+// credentials so the script can check what reached the stand-in.
+//
+// It listens on :43 (whois), :8443 (https: RIPE REST under /ripe, PeeringDB
+// under /peeringdb) and :8323 (http: VRP JSON at /json, lab state at
+// /_lab/state).
+//
+// Usage: registrystub -cert FILE -key FILE
+package main
+
+import (
+	"bufio"
+	"crypto/subtle"
+	"crypto/tls"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"os"
+	"slices"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+// Environment variables holding the credentials the stand-in accepts.
+const (
+	ripeUserEnv     = "STUB_RIPE_USER"
+	ripePasswordEnv = "STUB_RIPE_PASSWORD"
+	pdbKeyEnv       = "STUB_PEERINGDB_API_KEY"
+)
+
+// maxBody bounds a request body.
+const maxBody = 1 << 20
+
+type attr struct{ Name, Value string }
+
+// object is one RPSL object, in attribute order.
+type object []attr
+
+func (o object) get(name string) string {
+	for _, a := range o {
+		if a.Name == name {
+			return a.Value
+		}
+	}
+	return ""
+}
+
+// key is the REST key of a route object: the prefix and the origin.
+func (o object) key() string { return o.get(o[0].Name) + o.get("origin") }
+
+func (o object) text() string {
+	var b strings.Builder
+	for _, a := range o {
+		fmt.Fprintf(&b, "%-15s %s\n", a.Name+":", a.Value)
+	}
+	return b.String()
+}
+
+func route(prefix string, origin int, descr string) object {
+	return object{{"route", prefix}, {"descr", descr}, {"origin", "AS" + strconv.Itoa(origin)}, {"mnt-by", "MAINT-LAB"}, {"source", "TEST"}}
+}
+
+// Request is one recorded request. Authorized is true when the request
+// carried the credentials this stand-in accepts.
+type Request struct {
+	Service    string `json:"service"`
+	Method     string `json:"method"`
+	Path       string `json:"path"`
+	Authorized bool   `json:"authorized"`
+	Status     int    `json:"status"`
+}
+
+// State is what GET /_lab/state returns.
+type State struct {
+	Requests []Request                 `json:"requests"`
+	Routes   []string                  `json:"routes"`
+	PDB      map[string]map[string]any `json:"peeringdb"`
+}
+
+type stub struct {
+	ripeUser, ripePass, pdbKey string
+	now                        func() time.Time
+
+	mu     sync.Mutex
+	routes []object
+	// pdb holds the records by "class/id".
+	pdb  map[string]map[string]any
+	reqs []Request
+}
+
+// newStub returns the stand-in with the lab data. The announced prefixes in
+// the lab are 203.0.113.0/24 and 203.0.113.128/25, both from AS64501.
+func newStub(getenv func(string) string, now func() time.Time) *stub {
+	return &stub{
+		ripeUser: getenv(ripeUserEnv), ripePass: getenv(ripePasswordEnv), pdbKey: getenv(pdbKeyEnv), now: now,
+		// 203.0.113.128/25 has no object (missing); 192.0.2.0/24 is no
+		// longer announced (stale).
+		routes: []object{
+			route("203.0.113.0/24", 64501, "lab registered"),
+			route("192.0.2.0/24", 64501, "lab stale"),
+		},
+		pdb: map[string]map[string]any{
+			// Two prefixes are announced and PeeringDB says one.
+			"net/1": {"id": 1, "asn": 64501, "name": "Lab Net", "info_prefixes4": 1, "info_prefixes6": 0},
+			// The lab config says 10000 Mbps on this port.
+			"netixlan/11": {"id": 11, "ix_id": 7, "asn": 64501, "ipaddr4": "198.51.100.130", "ipaddr6": nil, "speed": 1000},
+		},
+	}
+}
+
+func (s *stub) record(service string, r *http.Request, authorized bool, status int) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.reqs = append(s.reqs, Request{Service: service, Method: r.Method, Path: r.URL.Path, Authorized: authorized, Status: status})
+}
+
+// statusWriter keeps the status for the request record.
+type statusWriter struct {
+	http.ResponseWriter
+	status int
+}
+
+func (w *statusWriter) WriteHeader(code int) {
+	w.status = code
+	w.ResponseWriter.WriteHeader(code)
+}
+
+// wrap records the request after the handler ran. The handler returns
+// whether the request carried the lab credentials.
+func (s *stub) wrap(service string, h func(w http.ResponseWriter, r *http.Request) bool) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		sw := &statusWriter{ResponseWriter: w, status: http.StatusOK}
+		authorized := h(sw, r)
+		s.record(service, r, authorized, sw.status)
+	}
+}
+
+func writeJSON(w http.ResponseWriter, code int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(code)
+	_ = json.NewEncoder(w).Encode(v)
+}
+
+func equal(a, b string) bool {
+	return a != "" && subtle.ConstantTimeCompare([]byte(a), []byte(b)) == 1
+}
+
+// httpsHandler serves the RIPE REST API under /ripe and PeeringDB under
+// /peeringdb.
+func (s *stub) httpsHandler() http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("/ripe/test/", s.wrap("ripe", s.ripe))
+	mux.HandleFunc("/peeringdb/api/", s.wrap("peeringdb", s.peeringdb))
+	return mux
+}
+
+// httpHandler serves the VRP JSON and the lab state.
+func (s *stub) httpHandler() http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("/json", s.wrap("vrp", func(w http.ResponseWriter, r *http.Request) bool {
+		// 203.0.113.0/24 allows up to /24, so the announced /25 is invalid.
+		// Nothing covers 192.0.2.0/24.
+		writeJSON(w, http.StatusOK, map[string]any{
+			"metadata": map[string]any{"generated": s.now().Unix()},
+			"roas":     []map[string]any{{"asn": "AS64501", "prefix": "203.0.113.0/24", "maxLength": 24, "ta": "lab"}},
+		})
+		return false
+	}))
+	mux.HandleFunc("/_lab/state", func(w http.ResponseWriter, r *http.Request) {
+		writeJSON(w, http.StatusOK, s.state())
+	})
+	return mux
+}
+
+func (s *stub) state() State {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	st := State{Requests: slices.Clone(s.reqs), Routes: []string{}, PDB: map[string]map[string]any{}}
+	for _, o := range s.routes {
+		st.Routes = append(st.Routes, o.text())
+	}
+	for k, v := range s.pdb {
+		st.PDB[k] = v
+	}
+	return st
+}
+
+// ripe is POST /ripe/test/route (create), GET and DELETE /ripe/test/route/KEY.
+// Writes need the basic-auth lab account.
+func (s *stub) ripe(w http.ResponseWriter, r *http.Request) bool {
+	class, key, _ := strings.Cut(strings.TrimPrefix(r.URL.Path, "/ripe/test/"), "/")
+	if class != "route" {
+		http.NotFound(w, r)
+		return false
+	}
+	user, pass, ok := r.BasicAuth()
+	authorized := ok && equal(s.ripeUser, user) && equal(s.ripePass, pass)
+	if r.Method != http.MethodGet && !authorized {
+		w.WriteHeader(http.StatusUnauthorized)
+		return false
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	switch r.Method {
+	case http.MethodGet:
+		i := s.find(key)
+		if i < 0 {
+			writeJSON(w, http.StatusNotFound, map[string]any{})
+			return authorized
+		}
+		attrs := make([]map[string]string, 0, len(s.routes[i]))
+		for _, a := range s.routes[i] {
+			attrs = append(attrs, map[string]string{"name": a.Name, "value": a.Value})
+		}
+		writeJSON(w, http.StatusOK, map[string]any{"objects": map[string]any{"object": []any{map[string]any{
+			"source": map[string]string{"id": "TEST"}, "attributes": map[string]any{"attribute": attrs}}}}})
+	case http.MethodDelete:
+		i := s.find(key)
+		if i < 0 {
+			writeJSON(w, http.StatusNotFound, map[string]any{})
+			return authorized
+		}
+		s.routes = slices.Delete(s.routes, i, i+1)
+		writeJSON(w, http.StatusOK, map[string]any{})
+	case http.MethodPost:
+		var doc struct {
+			Objects struct {
+				Object []struct {
+					Attributes struct {
+						Attribute []struct{ Name, Value string } `json:"attribute"`
+					} `json:"attributes"`
+				} `json:"object"`
+			} `json:"objects"`
+		}
+		if err := json.NewDecoder(io.LimitReader(r.Body, maxBody)).Decode(&doc); err != nil || len(doc.Objects.Object) != 1 {
+			w.WriteHeader(http.StatusBadRequest)
+			return authorized
+		}
+		var o object
+		for _, a := range doc.Objects.Object[0].Attributes.Attribute {
+			o = append(o, attr(a))
+		}
+		if len(o) == 0 || o[0].Name != "route" || o.get("source") != "TEST" || s.find(o.key()) >= 0 {
+			w.WriteHeader(http.StatusBadRequest)
+			return authorized
+		}
+		s.routes = append(s.routes, o)
+		writeJSON(w, http.StatusCreated, map[string]any{})
+	default:
+		w.WriteHeader(http.StatusMethodNotAllowed)
+	}
+	return authorized
+}
+
+// find is the index of the route object with key, or -1. The caller holds mu.
+func (s *stub) find(key string) int {
+	return slices.IndexFunc(s.routes, func(o object) bool { return o.key() == key })
+}
+
+// peeringdb answers the reads the registry source makes and accepts a PUT
+// of a net or netixlan record with the lab API key. Every other list is
+// empty: the lookup block, which the lab needs only for the exchange id,
+// reads ix, org and other networks from here too, never from the internet.
+func (s *stub) peeringdb(w http.ResponseWriter, r *http.Request) bool {
+	authorized := equal(s.pdbKey, strings.TrimPrefix(r.Header.Get("Authorization"), "Api-Key "))
+	rest := strings.TrimPrefix(r.URL.Path, "/peeringdb/api/")
+	class, id, detail := strings.Cut(rest, "/")
+	data := func(v ...any) bool {
+		writeJSON(w, http.StatusOK, map[string]any{"data": append([]any{}, v...)})
+		return authorized
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if detail {
+		rec, ok := s.pdb[class+"/"+id]
+		switch {
+		case !ok:
+			writeJSON(w, http.StatusNotFound, map[string]any{})
+		case r.Method == http.MethodPut:
+			if !authorized {
+				w.WriteHeader(http.StatusUnauthorized)
+				return false
+			}
+			var body map[string]any
+			if err := json.NewDecoder(io.LimitReader(r.Body, maxBody)).Decode(&body); err != nil {
+				w.WriteHeader(http.StatusBadRequest)
+				return authorized
+			}
+			for k, v := range body {
+				rec[k] = v
+			}
+			return data(rec)
+		case r.Method == http.MethodGet:
+			return data(rec)
+		default:
+			w.WriteHeader(http.StatusMethodNotAllowed)
+		}
+		return authorized
+	}
+	q := r.URL.Query()
+	switch {
+	case class == "net" && q.Get("asn") == "64501":
+		return data(s.pdb["net/1"])
+	case class == "netixlan" && q.Get("asn") == "64501":
+		return data(s.pdb["netixlan/11"])
+	case class == "netfac" && q.Get("local_asn") == "64501":
+		return data(map[string]any{"id": 21, "local_asn": 64501, "fac_id": 3})
+	case class == "poc" && q.Get("net_id") == "1":
+		return data(map[string]any{"id": 31, "role": "NOC", "updated": s.now().UTC().Format(time.RFC3339)})
+	case slices.Contains([]string{"ix", "net", "netixlan", "netfac", "org", "poc"}, class):
+		return data()
+	}
+	http.NotFound(w, r)
+	return authorized
+}
+
+// serveWhois answers RIPE-dialect queries, one per connection, and closes.
+func (s *stub) serveWhois(ln net.Listener) {
+	for {
+		c, err := ln.Accept()
+		if err != nil {
+			return
+		}
+		go func() {
+			defer c.Close()
+			_ = c.SetDeadline(time.Now().Add(10 * time.Second))
+			line, err := bufio.NewReader(io.LimitReader(c, 4096)).ReadString('\n')
+			if err != nil {
+				return
+			}
+			_, _ = io.WriteString(c, s.whois(strings.TrimSpace(line)))
+		}()
+	}
+}
+
+// whois answers "-r -s TEST [-B] [-x] [-i origin] -T route,route6 KEY": an
+// inverse origin query lists every object of that origin, any other KEY is a
+// prefix matched exactly.
+func (s *stub) whois(query string) string {
+	f := strings.Fields(query)
+	var key string
+	origin := false
+	for i := 0; i < len(f); i++ {
+		switch f[i] {
+		case "-s", "-T":
+			i++
+		case "-i":
+			origin = true
+			i++
+		case "-r", "-B", "-x":
+		default:
+			key = f[i]
+		}
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.reqs = append(s.reqs, Request{Service: "whois", Method: "QUERY", Path: query, Status: 200})
+	var b strings.Builder
+	b.WriteString("% Lab IRR stand-in. Documentation data only.\n\n")
+	n := 0
+	for _, o := range s.routes {
+		if (origin && o.get("origin") == key) || (!origin && o.get("route") == key) {
+			b.WriteString(o.text() + "\n")
+			n++
+		}
+	}
+	if n == 0 {
+		return "%ERROR:101: no entries found\n"
+	}
+	return b.String()
+}
+
+func main() {
+	cert := flag.String("cert", "", "TLS certificate for the https listener")
+	keyFile := flag.String("key", "", "TLS key for the https listener")
+	flag.Parse()
+	if *cert == "" || *keyFile == "" {
+		log.Fatal("registrystub: -cert and -key are required")
+	}
+	pair, err := tls.LoadX509KeyPair(*cert, *keyFile)
+	if err != nil {
+		log.Fatal(err)
+	}
+	s := newStub(os.Getenv, time.Now)
+	ln, err := net.Listen("tcp", ":43")
+	if err != nil {
+		log.Fatal(err)
+	}
+	go s.serveWhois(ln)
+	go func() {
+		srv := &http.Server{Addr: ":8443", Handler: s.httpsHandler(), TLSConfig: &tls.Config{Certificates: []tls.Certificate{pair}}, ReadHeaderTimeout: 10 * time.Second}
+		log.Fatal(srv.ListenAndServeTLS("", ""))
+	}()
+	srv := &http.Server{Addr: ":8323", Handler: s.httpHandler(), ReadHeaderTimeout: 10 * time.Second}
+	log.Fatal(srv.ListenAndServe())
+}
