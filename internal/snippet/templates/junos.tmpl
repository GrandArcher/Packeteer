/* Packeteer on Junos. Generated for review: nothing is applied. Load it with
   "load merge terminal", then run "commit check" and "commit confirmed".
   This router: AS {{.ASN}}, {{.Router}}. Packeteer: {{.Packeteer}}. */
policy-options {
    community packeteer members {{if .Large}}large:{{end}}{{.Community}};
    /* From Packeteer: only routes that carry the Packeteer community. */
    policy-statement packeteer-in {
        term tagged {
            from community packeteer;
            then accept;
        }
        term rest {
            then reject;
        }
    }
    /* Toward every eBGP neighbor, customers and peers included: never a
       route with the Packeteer community. Put it first in each eBGP export,
       for example: export [ no-packeteer-out your-export-policy ]. A route
       it does not match falls through to the next policy. */
    policy-statement no-packeteer-out {
        term no-packeteer {
            from community packeteer;
            then reject;
        }
    }
}
protocols {
    bgp {
        group packeteer {
            type internal;
            local-address {{.Router}};
            /* Hold time 30s: a crashed Packeteer's routes go within 30s. */
            hold-time 30;
            import packeteer-in;
            /* Packeteer never offers graceful restart; keep it off here too. */
            graceful-restart {
                disable;
            }
{{- if or .AddPath .IPv6}}
            family inet {
                unicast{{if .AddPath}} {
                    add-path {
                        send {
                            path-count 6;
                        }
                    }
                }{{else}};{{end}}
            }
{{- end}}
{{- if .IPv6}}
            family inet6 {
                unicast{{if .AddPath}} {
                    add-path {
                        send {
                            path-count 6;
                        }
                    }
                }{{else}};{{end}}
            }
{{- end}}
            neighbor {{.Packeteer}} {
                description packeteer;
                peer-as {{.ASN}};
            }
        }
    }
}
routing-options {
    autonomous-system {{.ASN}};
}
