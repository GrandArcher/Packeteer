# Packeteer on BIRD 2 and 3. Generated for review: nothing is applied.
# Merge it into your bird.conf, then run: birdc configure check
# This router: AS {{.ASN}}, {{.Router}}. Packeteer: {{.Packeteer}}.

# From Packeteer: only routes that carry the Packeteer community.
filter packeteer_in {
	if {{.BirdMatch}} then accept;
	reject;
}

# Toward every eBGP neighbor, customers and peers included: never a route
# with the Packeteer community. Use this as the export filter of each eBGP
# protocol, or copy its first line to the top of the filter you use; your
# existing terms replace the final accept.
filter ebgp_out {
	if {{.BirdMatch}} then reject;
	accept;
}

protocol bgp packeteer {
	description "packeteer";
	local {{.Router}} as {{.ASN}};
	neighbor {{.Packeteer}} as {{.ASN}};
	# Resolves next hops on the connected LAN without an IGP table. Remove
	# it when an IGP carries them.
	direct;
	# Keepalive 10s, hold time 30s: a crashed Packeteer's routes go within 30s.
	hold time 30;
	keepalive time 10;
	# Packeteer never offers graceful restart; keep it off here too.
	graceful restart off;
	long lived graceful restart off;
	ipv4 {
		import filter packeteer_in;
		export where source = RTS_BGP;
{{- if .AddPath}}
		add paths tx;
{{- end}}
	};
{{- if .IPv6}}
	ipv6 {
		import filter packeteer_in;
		export where source = RTS_BGP;
{{- if .AddPath}}
		add paths tx;
{{- end}}
	};
{{- end}}
}
